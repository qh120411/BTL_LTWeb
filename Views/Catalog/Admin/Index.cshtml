@model BTL_LTWEB.Areas.Admin.ViewModels.CatalogIndexViewModel
@{
    ViewData["Title"] = "Quản lý học liệu";
    ViewBag.ActiveMenu = "Catalog";
    var keyword = Model.SearchKeyword ?? "";
    var category = Model.SelectedCategory ?? "all";
    var major = Model.SelectedMajor ?? "all";
    var language = Model.SelectedLanguage ?? "all";
    var availability = Model.SelectedStatus ?? "all";

    bool hasActiveFilter = !string.IsNullOrEmpty(keyword) 
                           || category != "all" 
                           || major != "all" 
                           || language != "all" 
                           || availability != "all";
}

@section Styles {
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
}

<div class="admin-breadcrumb">THƯ VIỆN UTC / QUẢN TRỊ</div>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="admin-page-title mb-1">Quản lý học liệu &amp; Danh mục sách (@Model.TongDauSach đầu sách)</h1>
    </div>
    <button class="btn btn-utc-primary shadow-sm d-inline-flex align-items-center gap-2" type="button" data-bs-toggle="modal" data-bs-target="#createBookModal">
        <i class="bi bi-plus-circle-fill"></i>
        <span>+ Thêm học liệu mới</span>
    </button>
</div>

@{
    int totalCopies = Model.TongBanSao > 0 ? Model.TongBanSao : 1;
    string strPctSanCo = ((double)Model.TongSanCo / totalCopies * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    string strPctDangMuon = ((double)Model.TongDangMuon / totalCopies * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    double pctSanCoDisplay = Math.Round((double)Model.TongSanCo / totalCopies * 100, 1);
    double pctDangMuonDisplay = Math.Round((double)Model.TongDangMuon / totalCopies * 100, 1);
    double avgCopies = Model.TongDauSach > 0 ? Math.Round((double)Model.TongBanSao / Model.TongDauSach, 1) : 0;
}

<!-- KHỐI THỐNG KÊ KHO HỌC LIỆU TRỰC QUAN (PHÂN CẤP QUY MÔ & TỶ LỆ LƯU THÔNG) -->
<div class="row g-3 mb-4">
    <!-- Cụm 1: Quy mô danh mục & Bản sao (2 thẻ card) -->
    <div class="col-xl-5 col-lg-5">
        <div class="row g-3">
            <div class="col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 p-3" style="background: #ffffff; border-left: 4px solid var(--utc-primary, #004b87) !important;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-uppercase fw-semibold text-muted" style="font-size: 11.5px; letter-spacing: 0.5px;">Tổng đầu sách</span>
                        <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 34px; height: 34px; background: rgba(0, 75, 135, 0.1); color: var(--utc-primary, #004b87);">
                            <i class="bi bi-journal-bookmark-fill fs-6"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="fw-bold" style="font-size: 28px; color: var(--utc-primary, #004b87); line-height: 1;">@Model.TongDauSach</span>
                        <span class="badge bg-light text-primary border" style="font-size: 11px;">~@avgCopies bản/sách</span>
                    </div>
                    <div class="small text-muted mt-2" style="font-size: 12px;">Đầu mục giáo trình, tài liệu</div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 p-3" style="background: #ffffff; border-left: 4px solid #0284c7 !important;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-uppercase fw-semibold text-muted" style="font-size: 11.5px; letter-spacing: 0.5px;">Tổng bản sao vật lý</span>
                        <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 34px; height: 34px; background: rgba(2, 132, 199, 0.1); color: #0284c7;">
                            <i class="bi bi-upc-scan fs-6"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="fw-bold text-dark" style="font-size: 28px; line-height: 1;">@Model.TongBanSao</span>
                        <span class="badge bg-light text-secondary border" style="font-size: 11px;">100% kho</span>
                    </div>
                    <div class="small text-muted mt-2" style="font-size: 12px;">Bản in gắn mã vạch lưu thông</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cụm 2: Thước đo trạng thái & tỷ lệ lưu thông kho (Card trực quan dạng Stacked Bar) -->
    <div class="col-xl-7 col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3" style="background: #ffffff;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pie-chart-fill text-primary"></i>
                    <span class="fw-bold text-dark" style="font-size: 14px;">Trạng thái &amp; Tỷ lệ lưu thông kho</span>
                </div>
                <span class="badge" style="background: rgba(0, 51, 102, 0.08); color: #003366; border: 1px solid rgba(0, 51, 102, 0.15); font-size: 12px; font-weight: 600;">
                    <i class="bi bi-arrow-repeat me-1"></i>Đang lưu hành: @pctDangMuonDisplay%
                </span>
            </div>

            <!-- Thanh tiến độ kép (Stacked Progress Bar) thể hiện tỷ trọng trực quan (Navy Blue & Trắng đục) -->
            <div class="progress my-2 rounded-pill shadow-inner" style="height: 15px; background-color: #cbd5e1; border: 1px solid #cbd5e1; overflow: hidden;">
                <div class="progress-bar progress-bar-striped" role="progressbar" 
                     style="width: @(strPctSanCo)%; background-color: #003366 !important;" 
                     title="Sẵn có trong kho: @Model.TongSanCo bản (@pctSanCoDisplay%)">
                </div>
                <div class="progress-bar progress-bar-striped" role="progressbar" 
                     style="width: @(strPctDangMuon)%; background-color: #e5e9f0 !important;" 
                     title="Đang mượn ngoài kho: @Model.TongDangMuon bản (@pctDangMuonDisplay%)">
                </div>
            </div>

            <!-- Chi tiết 2 nhóm dữ liệu -->
            <div class="d-flex justify-content-between align-items-center pt-2 mt-auto" style="border-top: 1px dashed #e2e8f0;">
                <!-- Nhóm 1: Sẵn có (Navy Blue) -->
                <div class="d-flex align-items-center gap-2">
                    <span class="rounded-circle shadow-sm" style="width: 11px; height: 11px; background-color: #003366; display: inline-block;"></span>
                    <div>
                        <div class="small text-muted" style="font-size: 11.5px;">Bản sẵn có trên kệ</div>
                        <div class="fw-bold" style="font-size: 16px; color: #003366;">
                            @Model.TongSanCo <span class="fw-normal text-muted" style="font-size: 12px;">(@pctSanCoDisplay%)</span>
                        </div>
                    </div>
                </div>

                <!-- Đường phân cách dọc -->
                <div style="width: 1px; height: 32px; background-color: #e2e8f0;"></div>

                <!-- Nhóm 2: Đang mượn (Trắng đục) -->
                <div class="d-flex align-items-center gap-2 text-end">
                    <div>
                        <div class="small text-muted" style="font-size: 11.5px;">Đang mượn ngoài kho</div>
                        <div class="fw-bold" style="color: #475569; font-size: 16px;">
                            @Model.TongDangMuon <span class="fw-normal text-muted" style="font-size: 12px;">(@pctDangMuonDisplay%)</span>
                        </div>
                    </div>
                    <span class="rounded-circle shadow-sm" style="width: 11px; height: 11px; background-color: #e5e9f0; border: 1.5px solid #94a3b8; display: inline-block;"></span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bố cục 2 cột giống Tra cứu OPAC bên Reader: Sidebar Bộ lọc + Lưới Card Sách -->
<div class="utc-catalog-layout">
    <!-- Cột trái: Bộ lọc Sidebar y hệt Reader OPAC -->
    <aside class="utc-filter-sidebar" style="position: sticky; top: 85px;">
        <div class="utc-filter-header">
            <h3 class="utc-filter-title">
                <i class="bi bi-funnel-fill text-primary"></i> Lọc kết quả
            </h3>
            @if (hasActiveFilter)
            {
                <a href="/Admin/Catalog" class="btn-utc-ghost text-danger p-0" style="font-size: 13px;">
                    <i class="bi bi-arrow-counterclockwise"></i> Đặt lại
                </a>
            }
        </div>

        <form action="/Admin/Catalog" method="get" id="filterForm">
            <input type="hidden" name="search" value="@keyword" />

            <!-- Filter 1: Loại tài liệu -->
            <div class="utc-filter-group mb-3">
                <label class="utc-field-label">Loại tài liệu</label>
                <select name="category" class="utc-filter-select" onchange="document.getElementById('filterForm').submit()">
                    <option value="all" selected="@(category == "all" ? "selected" : null)">Tất cả học liệu</option>
                    <option value="books" selected="@(category == "books" ? "selected" : null)">Sách &amp; giáo trình</option>
                    <option value="thesis" selected="@(category == "thesis" ? "selected" : null)">Luận văn, luận án</option>
                    <option value="journal" selected="@(category == "journal" ? "selected" : null)">Báo &amp; tạp chí</option>
                </select>
            </div>

            <!-- Filter 2: Chuyên ngành đào tạo -->
            <div class="utc-filter-group mb-3">
                <label class="utc-field-label">Chuyên ngành đào tạo</label>
                <select name="major" class="utc-filter-select" onchange="document.getElementById('filterForm').submit()">
                    <option value="all" selected="@(major == "all" ? "selected" : null)">Tất cả chuyên ngành</option>
                    <option value="cntt" selected="@(major == "cntt" ? "selected" : null)">Công nghệ thông tin</option>
                    <option value="toanly" selected="@(major == "toanly" ? "selected" : null)">Khoa học cơ bản &amp; Toán lý</option>
                    <option value="xaydung" selected="@(major == "xaydung" ? "selected" : null)">Kỹ thuật công trình &amp; Giao thông</option>
                    <option value="kinhte" selected="@(major == "kinhte" ? "selected" : null)">Kinh tế vận tải &amp; Logistics</option>
                    <option value="chinhtri" selected="@(major == "chinhtri" ? "selected" : null)">Lý luận chính trị &amp; Pháp luật</option>
                </select>
            </div>

            <!-- Filter 3: Ngôn ngữ xuất bản -->
            <div class="utc-filter-group mb-3">
                <label class="utc-field-label">Ngôn ngữ xuất bản</label>
                <select name="language" class="utc-filter-select" onchange="document.getElementById('filterForm').submit()">
                    <option value="all" selected="@(language == "all" ? "selected" : null)">Tất cả ngôn ngữ</option>
                    <option value="vie" selected="@(language == "vie" ? "selected" : null)">Tiếng Việt</option>
                    <option value="eng" selected="@(language == "eng" ? "selected" : null)">Tiếng Anh</option>
                </select>
            </div>

            <!-- Filter 4: Tình trạng lưu thông -->
            <div class="utc-filter-group mb-3">
                <label class="utc-field-label">Tình trạng lưu thông</label>
                <select name="status" class="utc-filter-select" onchange="document.getElementById('filterForm').submit()">
                    <option value="all" selected="@(availability == "all" ? "selected" : null)">Tất cả tình trạng</option>
                    <option value="available" selected="@(availability == "available" ? "selected" : null)">Có bản sẵn tại thư viện</option>
                </select>
            </div>

            <button type="submit" class="btn-utc-primary w-100 mb-2">
                <i class="bi bi-funnel me-1"></i> Áp dụng bộ lọc
            </button>

            @if (hasActiveFilter)
            {
                <a href="/Admin/Catalog" class="btn-utc-outline w-100 text-center text-decoration-none">
                    <i class="bi bi-x-circle me-1"></i> Xóa tất cả bộ lọc
                </a>
            }
        </form>
    </aside>

    <!-- Cột phải: Thanh tìm kiếm + Lưới sách Cards hiển thị như OPAC -->
    <div class="utc-catalog-results">
        <!-- Thanh tìm kiếm từ khóa học liệu -->
        <form action="/Admin/Catalog" method="get" class="utc-search-box-large mb-3">
            <input type="hidden" name="category" value="@category" />
            <input type="hidden" name="major" value="@major" />
            <input type="hidden" name="language" value="@language" />
            <input type="hidden" name="status" value="@availability" />

            <div class="utc-search-box-field">
                <label class="utc-field-label">Từ khóa tìm kiếm (nhan đề, tác giả, chuyên ngành, mã ISBN)</label>
                <input type="text" 
                       name="search" 
                       class="utc-field-input" 
                       value="@keyword" 
                       placeholder="Nhập tên sách, tác giả, nhà xuất bản, ISBN..." />
            </div>
            <button type="submit" class="btn-utc-primary">
                <i class="bi bi-search me-1"></i> Tìm kiếm
            </button>
            @if (!string.IsNullOrEmpty(keyword))
            {
                <a href="/Admin/Catalog?category=@category&major=@major&language=@language&status=@availability" 
                   class="btn-utc-secondary">
                    <i class="bi bi-x-lg me-1"></i> Xóa từ khóa
                </a>
            }
        </form>

        <div class="utc-catalog-results-header">
            <div class="utc-results-count">
                Tìm thấy <span>@Model.Books.Count</span> học liệu phù hợp
            </div>
            <span class="badge bg-light text-muted border px-2 py-1">Quản lý danh mục &amp; kho lưu thông</span>
        </div>

        @if (Model.Books.Count == 0)
        {
            <div class="utc-empty-state">
                <div class="utc-empty-state-icon">
                    <i class="bi bi-search"></i>
                </div>
                <h4 class="utc-empty-state-title">Không tìm thấy học liệu phù hợp</h4>
                <p class="utc-empty-state-desc">
                    Không có kết quả nào khớp với các tiêu chí tìm kiếm hoặc bộ lọc hiện tại của bạn. Vui lòng thử từ khóa khác hoặc xóa bộ lọc.
                </p>
                <div>
                    <a href="/Admin/Catalog" class="btn-utc-primary text-decoration-none">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại tất cả bộ lọc
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="utc-catalog-cards-grid">
                @foreach (var book in Model.Books)
                {
                    var bookCover = string.IsNullOrWhiteSpace(book.CoverImage)
                        ? "/images/covers/sach_01.jpg"
                        : (book.CoverImage.StartsWith("/") ? book.CoverImage : "/" + book.CoverImage.TrimStart('~').TrimStart('/'));

                    <div class="utc-catalog-book-card position-relative">
                        <!-- Ảnh bìa sách chuẩn OPAC -->
                        <div class="utc-book-cover-wrap">
                            <img src="@bookCover" alt="@book.TenHocLieu" class="utc-book-cover-img" onerror="this.src='/images/covers/sach_01.jpg'" />
                        </div>

                        <!-- Chuyên ngành & Tên sách -->
                        <span class="utc-book-category">@book.TheLoai.ToUpper()</span>
                        <div class="utc-book-card-name" title="@book.TenHocLieu">@book.TenHocLieu</div>

                        <!-- Tác giả & Kệ sách -->
                        <div class="text-muted small text-truncate">
                            <i class="bi bi-person me-1"></i>@book.TacGia
                        </div>
                        <div class="text-muted small text-truncate" style="font-size: 11.5px;">
                            <i class="bi bi-geo-alt text-danger me-1"></i>Kệ: <strong>@book.ViTriKe</strong> &middot; ISBN: @book.ISBN
                        </div>

                        <!-- Badge số lượng bản sẵn có & định dạng -->
                        <div class="d-flex align-items-center justify-content-between pt-1">
                            <span class="utc-book-meta-badge @(book.SanCo > 0 ? "is-available" : "is-online")" style="font-size: 11.5px;">
                                <i class="bi @(book.SanCo > 0 ? "bi-check2-circle" : "bi-exclamation-circle") me-1"></i>
                                @(book.SanCo > 0 ? $"{book.SanCo} bản sẵn có" : "Đang mượn hết")
                                &middot; @book.DinhDang
                            </span>
                        </div>

                        <!-- Thanh công cụ Thao tác Admin trên từng Card -->
                        <div class="d-flex justify-content-end align-items-center gap-1 mt-2 pt-2 border-top">
                            <!-- Xem bản sao vật lý -->
                            <button type="button" class="btn btn-sm btn-outline-primary px-2 py-1 btn-view-copies" 
                                    data-id="@book.Id" style="font-size: 12px; font-weight: 500;">
                                Bản sao
                            </button>
                            <!-- Sửa học liệu -->
                            <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-1 btn-edit-book"
                                    data-id="@book.Id" style="font-size: 12px; font-weight: 500;">
                                Sửa
                            </button>
                            <!-- Xóa học liệu -->
                            <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1 btn-delete-book"
                                    data-id="@book.Id" data-title="@book.TenHocLieu" data-copies="@book.SanCo" data-total="@book.TongBan"
                                    style="font-size: 12px; font-weight: 500;">
                                Xóa
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 1: THÊM HỌC LIỆU MỚI VÀO CSDL THƯ VIỆN UTC -->
<!-- ======================================================== -->
<div class="modal fade" id="createBookModal" tabindex="-1" aria-labelledby="createBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-white text-dark py-3 px-4 border-bottom" style="background: #ffffff !important; border-bottom: 1px solid #e2eaf2 !important;">
                <h5 class="modal-title fw-bold mb-0 text-dark" id="createBookModalLabel" style="color: #163b5c !important;">
                    <i class="bi bi-journal-plus text-primary me-2"></i>Thêm học liệu mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label-utc fw-bold">Tên học liệu / Giáo trình <span class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control form-control-utc" placeholder="VD: Giáo trình Kỹ thuật Vi điều khiển và IoT..." required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Tác giả / Chủ biên <span class="text-danger">*</span></label>
                            <input type="text" name="authors" class="form-control form-control-utc" placeholder="VD: PGS. TS. Nguyễn Văn A, ThS. Trần B..." required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Nhà xuất bản</label>
                            <input type="text" name="publisher" class="form-control form-control-utc" placeholder="VD: NXB Giao thông Vận tải / NXB Bách Khoa..." />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label-utc fw-bold">Chuyên ngành đào tạo <span class="text-danger">*</span></label>
                            <select name="major" class="form-select form-control-utc" required>
                                <option value="cntt">Công nghệ thông tin</option>
                                <option value="xaydung">Kỹ thuật xây dựng &amp; Giao thông</option>
                                <option value="kinhte">Kinh tế &amp; Quản trị</option>
                                <option value="toanly">Khoa học cơ bản</option>
                                <option value="chinhtri">Lý luận chính trị &amp; Pháp luật</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label-utc fw-bold">Mã số chuẩn ISBN</label>
                            <input type="text" name="isbn" class="form-control form-control-utc" placeholder="VD: 978-604-0-32451-2" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label-utc fw-bold">Năm XB</label>
                            <input type="number" name="year" class="form-control form-control-utc" value="@DateTime.Today.Year" min="1990" max="2030" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label-utc fw-bold">Số trang</label>
                            <input type="number" name="pages" class="form-control form-control-utc" value="300" min="10" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Vị trí xếp kệ (Kho Nhà A8)</label>
                            <input type="text" name="shelf" class="form-control form-control-utc" value="Kệ IT-01 - Tầng 2 Nhà A8" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Số lượng bản sao nhập kho</label>
                            <input type="number" name="copiesCount" class="form-control form-control-utc" value="4" min="1" max="20" />
                            <div class="form-text small text-muted">Hệ thống sẽ tự động tạo tương ứng mã vạch <code>UTC-XX-01...</code></div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label-utc fw-bold">Đường dẫn ảnh bìa (Cover Image URL)</label>
                            <input type="text" name="coverImage" class="form-control form-control-utc" value="/images/covers/sach_01.jpg" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label-utc fw-bold">Mô tả tóm tắt nội dung học liệu</label>
                            <textarea name="description" class="form-control form-control-utc" rows="3" placeholder="Tóm tắt nội dung giáo trình, đối tượng phục vụ, kiến thức trọng tâm..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-utc-primary px-4 fw-bold">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Lưu vào CSDL Thư viện
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 2: CHỈNH SỬA THÔNG TIN HỌC LIỆU TRONG CSDL -->
<!-- ======================================================== -->
<div class="modal fade" id="editBookModal" tabindex="-1" aria-labelledby="editBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-white text-dark py-3 px-4 border-bottom" style="background: #ffffff !important; border-bottom: 1px solid #e2eaf2 !important;">
                <h5 class="modal-title fw-bold mb-0 text-dark" id="editBookModalLabel" style="color: #163b5c !important;">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh sửa thông tin học liệu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Update" method="post" id="formEditBook">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editBookId" value="" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label-utc fw-bold">Tên học liệu / Giáo trình <span class="text-danger">*</span></label>
                            <input type="text" name="title" id="editBookTitle" class="form-control form-control-utc" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Tác giả / Chủ biên <span class="text-danger">*</span></label>
                            <input type="text" name="authors" id="editBookAuthors" class="form-control form-control-utc" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Nhà xuất bản</label>
                            <input type="text" name="publisher" id="editBookPublisher" class="form-control form-control-utc" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label-utc fw-bold">Chuyên ngành đào tạo</label>
                            <select name="major" id="editBookMajor" class="form-select form-control-utc">
                                <option value="cntt">Công nghệ thông tin</option>
                                <option value="xaydung">Kỹ thuật xây dựng &amp; Giao thông</option>
                                <option value="kinhte">Kinh tế &amp; Quản trị</option>
                                <option value="toanly">Khoa học cơ bản</option>
                                <option value="chinhtri">Lý luận chính trị &amp; Pháp luật</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label-utc fw-bold">ISBN</label>
                            <input type="text" name="isbn" id="editBookIsbn" class="form-control form-control-utc" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label-utc fw-bold">Năm XB</label>
                            <input type="number" name="year" id="editBookYear" class="form-control form-control-utc" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label-utc fw-bold">Số trang</label>
                            <input type="number" name="pages" id="editBookPages" class="form-control form-control-utc" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Vị trí xếp kệ (Kho Nhà A8)</label>
                            <input type="text" name="shelf" id="editBookShelf" class="form-control form-control-utc" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Ảnh bìa (URL)</label>
                            <input type="text" name="coverImage" id="editBookCover" class="form-control form-control-utc" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label-utc fw-bold">Mô tả tóm tắt</label>
                            <textarea name="description" id="editBookDesc" class="form-control form-control-utc" rows="3"></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        <i class="bi bi-save me-1"></i> Lưu thay đổi CSDL
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 3: XEM CHI TIẾT BẢN SAO VẬT LÝ & MÃ VẠCH (BARCODE) -->
<!-- ======================================================== -->
<div class="modal fade" id="bookCopiesModal" tabindex="-1" aria-labelledby="bookCopiesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-white text-dark py-3 px-4 border-bottom" style="background: #ffffff !important; border-bottom: 1px solid #e2eaf2 !important;">
                <div>
                    <h5 class="modal-title fw-bold mb-0 text-dark" id="bookCopiesModalLabel" style="color: #163b5c !important;">
                        <i class="bi bi-upc-scan text-primary me-2"></i>Danh sách bản sao vật lý &amp; Mã vạch lưu thông
                    </h5>
                    <div class="small text-muted mt-1" id="copiesModalBookTitle"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="text-muted small">
                        Vị trí kệ: <strong id="copiesModalShelf" class="text-navy"></strong>
                    </div>
                    <div>
                        <span id="copiesModalStatsBadge" class="badge bg-success px-3 py-1 fs-6 font-monospace">4/4 bản sẵn có</span>
                    </div>
                </div>

                <div class="table-responsive border rounded-2">
                    <table class="table table-hover table-striped mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 15%;">Mã bản sao</th>
                                <th style="width: 25%;">Mã vạch (Barcode)</th>
                                <th style="width: 25%;">Vị trí kệ</th>
                                <th style="width: 15%;">Tình trạng</th>
                                <th style="width: 20%; text-align: center;">Trạng thái kho</th>
                            </tr>
                        </thead>
                        <tbody id="copiesTableBody">
                            <!-- Được nạp tự động qua AJAX -->
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer bg-light px-4 py-3">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 4: XÁC NHẬN XÓA HỌC LIỆU KHỎI CSDL -->
<!-- ======================================================== -->
<div class="modal fade" id="deleteBookModal" tabindex="-1" aria-labelledby="deleteBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-danger text-white py-3 px-4">
                <h5 class="modal-title fw-bold mb-0" id="deleteBookModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa học liệu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteBookId" value="" />

                <div class="modal-body p-4">
                    <div class="alert alert-warning py-2 px-3 small mb-3">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Thao tác này sẽ xóa đầu sách và toàn bộ mã vạch bản sao vật lý liên quan khỏi CSDL Thư viện UTC.
                    </div>
                    <div class="text-dark">
                        Bạn có chắc chắn muốn xóa học liệu:
                        <div class="fw-bold text-danger mt-1 fs-6" id="deleteBookTitle"></div>
                    </div>
                    <div class="mt-2 text-muted small" id="deleteBookWarning"></div>
                </div>

                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger px-4 fw-bold">
                        <i class="bi bi-trash-fill me-1"></i> Xác nhận xóa khỏi CSDL
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Xử lý mở Modal xem Bản sao vật lý
        var copiesModalEl = document.getElementById("bookCopiesModal");
        var copiesModal = new bootstrap.Modal(copiesModalEl);
        var copiesModalBookTitle = document.getElementById("copiesModalBookTitle");
        var copiesModalShelf = document.getElementById("copiesModalShelf");
        var copiesModalStatsBadge = document.getElementById("copiesModalStatsBadge");
        var copiesTableBody = document.getElementById("copiesTableBody");

        document.querySelectorAll(".btn-view-copies").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var bookId = this.getAttribute("data-id");

                copiesTableBody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">Đang tải danh sách bản sao từ CSDL...</td></tr>';
                copiesModal.show();

                fetch('/Admin/Catalog/GetCopies?id=' + encodeURIComponent(bookId))
                    .then(function (res) {
                        if (!res.ok) {
                            throw new Error('HTTP ' + res.status);
                        }
                        return res.json();
                    })
                    .then(function (data) {
                        if (copiesModalBookTitle) copiesModalBookTitle.textContent = data.title || "";
                        if (copiesModalShelf) copiesModalShelf.textContent = data.shelf || "Chưa cập nhật";
                        if (copiesModalStatsBadge) {
                            copiesModalStatsBadge.textContent = (data.availableCopies || 0) + "/" + (data.totalCopies || 0) + " bản sẵn có";
                            if (data.availableCopies > 0) {
                                copiesModalStatsBadge.className = "badge bg-success px-3 py-1 fs-6 font-monospace";
                            } else {
                                copiesModalStatsBadge.className = "badge bg-danger px-3 py-1 fs-6 font-monospace";
                            }
                        }

                        if (!data.copies || data.copies.length === 0) {
                            copiesTableBody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">Chưa có bản sao vật lý nào trong kho.</td></tr>';
                            return;
                        }

                        var rows = "";
                        data.copies.forEach(function (c) {
                            var statusBadge = c.status === "Có sẵn"
                                ? '<span class="badge bg-success text-white px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i> Có sẵn trong kho</span>'
                                : '<span class="badge bg-primary text-white px-2 py-1"><i class="bi bi-arrow-left-right me-1"></i> Đang mượn</span>';

                            rows += '<tr>' +
                                '<td><strong class="font-monospace text-navy">BS-' + c.id + '</strong></td>' +
                                '<td><span class="badge bg-light text-dark border font-monospace px-2 py-1"><i class="bi bi-upc me-1"></i>' + c.barcode + '</span></td>' +
                                '<td><span class="small text-muted">' + c.shelf + '</span></td>' +
                                '<td><span class="badge bg-secondary-subtle text-secondary border">' + c.condition + '</span></td>' +
                                '<td style="text-align: center;">' + statusBadge + '</td>' +
                                '</tr>';
                        });
                        copiesTableBody.innerHTML = rows;
                    })
                    .catch(function (err) {
                        console.error("Lỗi khi tải bản sao:", err);
                        copiesTableBody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-danger">Lỗi kết nối khi tải bản sao: ' + (err.message || err) + '</td></tr>';
                    });
            });
        });

        // 2. Xử lý mở Modal Chỉnh sửa học liệu
        var editModalEl = document.getElementById("editBookModal");
        var editModal = new bootstrap.Modal(editModalEl);

        document.querySelectorAll(".btn-edit-book").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var bookId = this.getAttribute("data-id");

                fetch('/Admin/Catalog/GetBook?id=' + encodeURIComponent(bookId))
                    .then(function (res) {
                        if (!res.ok) {
                            throw new Error('HTTP ' + res.status);
                        }
                        return res.json();
                    })
                    .then(function (data) {
                        document.getElementById("editBookId").value = data.id;
                        document.getElementById("editBookTitle").value = data.title;
                        document.getElementById("editBookAuthors").value = data.authors;
                        document.getElementById("editBookPublisher").value = data.publisher || "";
                        document.getElementById("editBookMajor").value = data.major;
                        document.getElementById("editBookIsbn").value = data.isbn || "";
                        document.getElementById("editBookYear").value = data.year;
                        document.getElementById("editBookPages").value = data.pages;
                        document.getElementById("editBookShelf").value = data.shelf || "";
                        document.getElementById("editBookCover").value = data.coverImage || "";
                        document.getElementById("editBookDesc").value = data.description || "";

                        editModal.show();
                    });
            });
        });

        // 3. Xử lý mở Modal Xóa học liệu
        var deleteModalEl = document.getElementById("deleteBookModal");
        var deleteModal = new bootstrap.Modal(deleteModalEl);

        document.querySelectorAll(".btn-delete-book").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var bookId = this.getAttribute("data-id");
                var title = this.getAttribute("data-title");
                var available = parseInt(this.getAttribute("data-copies") || "0");
                var total = parseInt(this.getAttribute("data-total") || "0");

                document.getElementById("deleteBookId").value = bookId;
                document.getElementById("deleteBookTitle").textContent = title;

                var warningEl = document.getElementById("deleteBookWarning");
                if (available < total) {
                    warningEl.innerHTML = '<span class="text-danger fw-bold"><i class="bi bi-shield-exclamation me-1"></i> Cảnh báo: Hiện có ' + (total - available) + ' bản sao đang được sinh viên mượn. Hệ thống sẽ từ chối xóa để bảo vệ toàn vẹn CSDL.</span>';
                } else {
                    warningEl.textContent = 'Tất cả ' + total + ' bản sao hiện đang có sẵn trong kho, đủ điều kiện để xóa.';
                }

                deleteModal.show();
            });
        });
    });
</script>
}
