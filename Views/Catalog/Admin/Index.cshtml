@model BTL_LTWEB.Areas.Admin.ViewModels.CatalogIndexViewModel
@{
    ViewData["Title"] = "Quản lý học liệu";
    ViewBag.ActiveMenu = "Catalog";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-catalog.css" asp-append-version="true" />
}
<partial name="~/Views/Shared/Admin/_CatalogBrowser.cshtml" model="Model" />

<!-- ======================================================== -->
<!-- MODAL 1: THÊM HỌC LIỆU MỚI VÀO CSDL THƯ VIỆN UTC -->
<!-- ======================================================== -->
<div class="modal fade" id="createBookModal" tabindex="-1" aria-labelledby="createBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-white text-dark py-3 px-4 border-bottom" style="background: #ffffff !important; border-bottom: 1px solid #e2eaf2 !important;">
                <h5 class="modal-title fw-bold mb-0 text-dark" id="createBookModalLabel" style="color: #163b5c !important;">
                    Thêm học liệu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label-utc fw-bold">Tên học liệu <span class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control form-control-utc" placeholder="Tên sách hoặc giáo trình" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Tác giả <span class="text-danger">*</span></label>
                            <input type="text" name="authors" class="form-control form-control-utc" placeholder="Tên tác giả" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Nhà xuất bản</label>
                            <input type="text" name="publisher" class="form-control form-control-utc" placeholder="Tên nhà xuất bản" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label-utc fw-bold">Chuyên ngành <span class="text-danger">*</span></label>
                            <select name="major" class="form-select form-control-utc" required>
                                <option value="cntt">Công nghệ thông tin</option>
                                <option value="xaydung">Kỹ thuật xây dựng &amp; Giao thông</option>
                                <option value="kinhte">Kinh tế &amp; Quản trị</option>
                                <option value="toanly">Khoa học cơ bản</option>
                                <option value="chinhtri">Lý luận chính trị &amp; Pháp luật</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label-utc fw-bold">ISBN</label>
                            <input type="text" name="isbn" class="form-control form-control-utc" placeholder="VD: 978-604-0-32451-2" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label-utc fw-bold">Năm XB</label>
                            <input type="number" name="year" class="form-control form-control-utc" value="@DateTime.Today.Year" min="1990" max="2030" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label-utc fw-bold">Số trang</label>
                            <input type="number" name="pages" class="form-control form-control-utc" value="300" min="10" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Vị trí kệ</label>
                            <input type="text" name="shelf" class="form-control form-control-utc" value="Kệ IT-01 - Tầng 2 Nhà A8" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Số bản sao</label>
                            <input type="number" name="copiesCount" class="form-control form-control-utc" value="4" min="1" max="20" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label-utc fw-bold">Đường dẫn ảnh bìa</label>
                            <input type="text" name="coverImage" class="form-control form-control-utc" value="/images/covers/sach_01.jpg" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label-utc fw-bold">Mô tả</label>
                            <textarea name="description" class="form-control form-control-utc" rows="3" placeholder="Tóm tắt nội dung"></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-utc-primary px-4 fw-bold">
                        Thêm học liệu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 2: CHỈNH SỬA THÔNG TIN HỌC LIỆU TRONG CSDL -->
<!-- ======================================================== -->
<div class="modal fade" id="editBookModal" tabindex="-1" aria-labelledby="editBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-white text-dark py-3 px-4 border-bottom" style="background: #ffffff !important; border-bottom: 1px solid #e2eaf2 !important;">
                <h5 class="modal-title fw-bold mb-0 text-dark" id="editBookModalLabel" style="color: #163b5c !important;">
                    Sửa học liệu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Update" method="post" id="formEditBook">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editBookId" value="" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label-utc fw-bold">Tên học liệu <span class="text-danger">*</span></label>
                            <input type="text" name="title" id="editBookTitle" class="form-control form-control-utc" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Tác giả <span class="text-danger">*</span></label>
                            <input type="text" name="authors" id="editBookAuthors" class="form-control form-control-utc" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Nhà xuất bản</label>
                            <input type="text" name="publisher" id="editBookPublisher" class="form-control form-control-utc" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label-utc fw-bold">Chuyên ngành</label>
                            <select name="major" id="editBookMajor" class="form-select form-control-utc">
                                <option value="cntt">Công nghệ thông tin</option>
                                <option value="xaydung">Kỹ thuật xây dựng &amp; Giao thông</option>
                                <option value="kinhte">Kinh tế &amp; Quản trị</option>
                                <option value="toanly">Khoa học cơ bản</option>
                                <option value="chinhtri">Lý luận chính trị &amp; Pháp luật</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label-utc fw-bold">ISBN</label>
                            <input type="text" name="isbn" id="editBookIsbn" class="form-control form-control-utc" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label-utc fw-bold">Năm XB</label>
                            <input type="number" name="year" id="editBookYear" class="form-control form-control-utc" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label-utc fw-bold">Số trang</label>
                            <input type="number" name="pages" id="editBookPages" class="form-control form-control-utc" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Vị trí kệ</label>
                            <input type="text" name="shelf" id="editBookShelf" class="form-control form-control-utc" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-utc fw-bold">Ảnh bìa (URL)</label>
                            <input type="text" name="coverImage" id="editBookCover" class="form-control form-control-utc" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label-utc fw-bold">Mô tả tóm tắt</label>
                            <textarea name="description" id="editBookDesc" class="form-control form-control-utc" rows="3"></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 3: XEM CHI TIẾT BẢN SAO VẬT LÝ & MÃ VẠCH (BARCODE) -->
<!-- ======================================================== -->
<div class="modal fade" id="bookCopiesModal" tabindex="-1" aria-labelledby="bookCopiesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-white text-dark py-3 px-4 border-bottom" style="background: #ffffff !important; border-bottom: 1px solid #e2eaf2 !important;">
                <h5 class="modal-title fw-bold mb-0 text-dark" id="bookCopiesModalLabel" style="color: #163b5c !important;">
                    Bản sao học liệu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
                    <div class="text-muted small">
                        Vị trí kệ: <strong id="copiesModalShelf" class="text-navy"></strong>
                    </div>
                    <div>
                        <span id="copiesModalStatsBadge" class="badge bg-success px-3 py-1 fs-6 font-monospace">4/4 bản sẵn có</span>
                    </div>
                </div>

                <div class="table-responsive border rounded-2">
                    <table class="table table-hover table-striped mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 15%;">Mã bản sao</th>
                                <th style="width: 25%;">Mã vạch</th>
                                <th style="width: 25%;">Vị trí kệ</th>
                                <th style="width: 15%;">Tình trạng</th>
                                <th style="width: 20%; text-align: center;">Trạng thái kho</th>
                            </tr>
                        </thead>
                        <tbody id="copiesTableBody">
                            <!-- Được nạp tự động qua AJAX -->
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer bg-light px-4 py-3">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 4: XÁC NHẬN XÓA HỌC LIỆU KHỎI CSDL -->
<!-- ======================================================== -->
<div class="modal fade" id="deleteBookModal" tabindex="-1" aria-labelledby="deleteBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-danger text-white py-3 px-4">
                <h5 class="modal-title fw-bold mb-0" id="deleteBookModalLabel">
                    Xác nhận xóa học liệu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteBookId" value="" />

                <div class="modal-body p-4">
                    <div class="alert alert-warning py-2 px-3 small mb-3">
                        Xóa học liệu và toàn bộ bản sao liên quan.
                    </div>
                    <div class="text-dark">
                        Xóa học liệu này?
                        <div class="fw-bold text-danger mt-1 fs-6" id="deleteBookTitle"></div>
                    </div>
                    <div class="mt-2 text-muted small" id="deleteBookWarning"></div>
                </div>

                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger px-4 fw-bold">
                        Xóa học liệu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Xử lý mở Modal xem Bản sao vật lý
        var copiesModalEl = document.getElementById("bookCopiesModal");
        var copiesModal = new bootstrap.Modal(copiesModalEl);
        var copiesModalBookTitle = document.getElementById("copiesModalBookTitle");
        var copiesModalShelf = document.getElementById("copiesModalShelf");
        var copiesModalStatsBadge = document.getElementById("copiesModalStatsBadge");
        var copiesTableBody = document.getElementById("copiesTableBody");

        document.querySelectorAll(".btn-view-copies").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var bookId = this.getAttribute("data-id");

                copiesTableBody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">Đang tải bản sao...</td></tr>';
                copiesModal.show();

                fetch('/Admin/Catalog/GetCopies/' + bookId)
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        copiesModalBookTitle.textContent = data.title;
                        copiesModalShelf.textContent = data.shelf;
                        copiesModalStatsBadge.textContent = data.availableCopies + "/" + data.totalCopies + " bản sẵn có";

                        if (data.availableCopies > 0) {
                            copiesModalStatsBadge.className = "badge bg-success px-3 py-1 fs-6 font-monospace";
                        } else {
                            copiesModalStatsBadge.className = "badge bg-danger px-3 py-1 fs-6 font-monospace";
                        }

                        if (!data.copies || data.copies.length === 0) {
                            copiesTableBody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">Chưa có bản sao vật lý nào trong kho.</td></tr>';
                            return;
                        }

                        var rows = "";
                        data.copies.forEach(function (c) {
                            var statusBadge = c.status === "Có sẵn"
                                ? '<span class="badge bg-success text-white px-2 py-1"> Có sẵn trong kho</span>'
                                : '<span class="badge bg-primary text-white px-2 py-1"> Đang mượn</span>';

                            rows += '<tr>' +
                                '<td><strong class="font-monospace text-navy">BS-' + c.id + '</strong></td>' +
                                '<td><span class="badge bg-light text-dark border font-monospace px-2 py-1">' + c.barcode + '</span></td>' +
                                '<td><span class="small text-muted">' + c.shelf + '</span></td>' +
                                '<td><span class="badge bg-secondary-subtle text-secondary border">' + c.condition + '</span></td>' +
                                '<td style="text-align: center;">' + statusBadge + '</td>' +
                                '</tr>';
                        });
                        copiesTableBody.innerHTML = rows;
                    })
                    .catch(function () {
                        copiesTableBody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-danger">Lỗi kết nối khi tải bản sao!</td></tr>';
                    });
            });
        });

        // 2. Xử lý mở Modal Chỉnh sửa học liệu
        var editModalEl = document.getElementById("editBookModal");
        var editModal = new bootstrap.Modal(editModalEl);

        document.querySelectorAll(".btn-edit-book").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var bookId = this.getAttribute("data-id");

                fetch('/Admin/Catalog/GetBook/' + bookId)
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        document.getElementById("editBookId").value = data.id;
                        document.getElementById("editBookTitle").value = data.title;
                        document.getElementById("editBookAuthors").value = data.authors;
                        document.getElementById("editBookPublisher").value = data.publisher || "";
                        document.getElementById("editBookMajor").value = data.major;
                        document.getElementById("editBookIsbn").value = data.isbn || "";
                        document.getElementById("editBookYear").value = data.year;
                        document.getElementById("editBookPages").value = data.pages;
                        document.getElementById("editBookShelf").value = data.shelf || "";
                        document.getElementById("editBookCover").value = data.coverImage || "";
                        document.getElementById("editBookDesc").value = data.description || "";

                        editModal.show();
                    });
            });
        });

        // 3. Xử lý mở Modal Xóa học liệu
        var deleteModalEl = document.getElementById("deleteBookModal");
        var deleteModal = new bootstrap.Modal(deleteModalEl);

        document.querySelectorAll(".btn-delete-book").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var bookId = this.getAttribute("data-id");
                var title = this.getAttribute("data-title");
                var available = parseInt(this.getAttribute("data-copies") || "0");
                var total = parseInt(this.getAttribute("data-total") || "0");

                document.getElementById("deleteBookId").value = bookId;
                document.getElementById("deleteBookTitle").textContent = title;

                var warningEl = document.getElementById("deleteBookWarning");
                if (available < total) {
                    warningEl.innerHTML = '<span class="text-danger fw-bold"> Có ' + (total - available) + ' bản đang mượn. Không thể xóa.</span>';
                } else {
                    warningEl.textContent = 'Tất cả ' + total + ' bản sao hiện đang có sẵn trong kho, đủ điều kiện để xóa.';
                }

                deleteModal.show();
            });
        });
    });
</script>
}
