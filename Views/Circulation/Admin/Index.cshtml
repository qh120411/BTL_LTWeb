@model BTL_LTWEB.Areas.Admin.ViewModels.CirculationIndexViewModel
@{
    ViewData["Title"] = "Quản lý mượn trả & Lưu thông";
    ViewBag.ActiveMenu = "Circulation";
    string todayStr = DateTime.Today.ToString("dd/MM/yyyy");
    bool canBorrow = BTL_LTWEB.Common.LoanTermPolicy.TryGetDueDate(DateOnly.FromDateTime(DateTime.Today), out var dueDate);
    string dueDateStr = canBorrow ? dueDate.ToString("dd/MM/yyyy") : "Ngoài học kỳ";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="admin-page-title mb-1">Mượn trả</h1>
    </div>
    <button type="button" class="btn btn-utc-primary" data-bs-toggle="modal" data-bs-target="#createBorrowModal" disabled="@(!canBorrow)" aria-describedby="@(!canBorrow ? "borrowTermNotice" : null)">
        Cho mượn sách
    </button>

</div>



@if (!canBorrow)
{
    <p id="borrowTermNotice" class="text-danger mb-4">@BTL_LTWEB.Common.LoanTermPolicy.BorrowingWindowMessage</p>
}

<!-- Bộ lọc tìm kiếm & trạng thái -->
<form method="get" asp-action="Index" class="mb-4">
    <div class="row g-3">
        <div class="col-md-7">
            <label class="form-label-utc">Tra cứu giao dịch</label>
            <div class="input-group">

                <input type="text" name="search" class="form-control form-control-utc"
                       placeholder="Mã giao dịch, mã sinh viên, họ tên, tên sách..." value="@Model.SearchKeyword" />
                <button type="submit" class="btn btn-utc-primary">Tìm</button>
            </div>
        </div>
        <div class="col-md-5">
            <label class="form-label-utc">Trạng thái giao dịch</label>
            <select name="status" class="form-select form-control-utc" onchange="this.form.submit()">
                <option value="Tất cả trạng thái" selected="@(Model.SelectedStatus == "Tất cả trạng thái")">Tất cả trạng thái</option>
                <option value="Đang mượn" selected="@(Model.SelectedStatus == "Đang mượn")">Còn hạn</option>
                <option value="Quá hạn" selected="@(Model.SelectedStatus == "Quá hạn")">Đang quá hạn</option>
            </select>
        </div>
    </div>
</form>

<!-- Bảng danh sách giao dịch mượn trả -->
<div class="admin-table-card admin-paged-list" id="circulationList">
    <div class="table-responsive">
        <table class="table-utc">
            <thead>
                <tr>
                    <th style="width: 13%;">Mã giao dịch</th>
                    <th style="width: 20%;">Bạn đọc</th>
                    <th style="width: 32%;">Sách</th>
                    <th style="width: 12%;">Hạn trả</th>
                    <th style="width: 11%;">Trạng thái</th>
                    <th style="width: 12%; text-align: center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Transactions.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">

                            Không có giao dịch phù hợp.
                        </td>
                    </tr>
                }
                @foreach (var item in Model.TransactionsOnPage)
                {
                    <tr>
                        <td>
                            <strong class="text-primary font-monospace">@item.MaGD</strong>
                            <div class="text-muted" style="font-size: 14px;">Mượn: @item.NgayMuon</div>
                        </td>
                        <td>
                            <a href="/Admin/Reader/Details/@item.MaBD" class="fw-bold text-navy text-decoration-none">
                                @item.HoTen
                            </a>
                            <div class="text-muted small">Mã: <code>@item.MaBD</code></div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 280px;" title="@item.TenSach">
                                        @item.TenSach
                                    </div>
                                    <div class="text-muted small">
                                        Mã bản sao: <span class="badge bg-light text-dark border">@item.MaBanSao</span>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="@(item.IsQuaHan ? "text-danger fw-bold" : "text-dark")">@item.HanTra</span>
                            @if (item.IsQuaHan)
                            {
                                <div class="text-danger small fw-semibold" style="font-size: 14px;">
                                    Phạt 100.000 đ
                                </div>
                            }
                        </td>
                        <td>
                            @if (item.IsQuaHan)
                            {
                                <span class="badge bg-danger text-white px-2 py-1" style="font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 4px;">
                                     @item.TrangThai
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success text-white px-2 py-1" style="font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 4px;">
                                     Còn hạn
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 admin-row-actions">
                                <!-- Nút trả sách -->
                                <button type="button" class="btn btn-sm btn-outline-success px-2 py-1 btn-return-trigger"
                                        data-magd="@item.MaGD"
                                        data-mabd="@item.MaBD"
                                        data-hoten="@item.HoTen"
                                        data-tensach="@item.TenSach"
                                        data-quahan="@(item.IsQuaHan ? "true" : "false")"
                                        data-returnurl="@(Context.Request.Path + Context.Request.QueryString)"
                                        title="Tiếp nhận trả sách tại quầy">
                                     Trả sách
                                </button>
                                <!-- Xem hồ sơ bạn đọc -->
                                <a href="/Admin/Reader/Details/@item.MaBD" class="btn btn-sm btn-outline-secondary px-2 py-1" title="Xem hồ sơ bạn đọc">Hồ sơ</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="~/Views/Shared/Admin/_AdminListPagination.cshtml" model="Model.Pagination" />
</div>

<!-- ========================================== -->
<!-- MODAL 1: TẠO GIAO DỊCH MƯỢN MỚI TẠI QUẦY -->
<!-- ========================================== -->
<div class="modal fade" id="createBorrowModal" tabindex="-1" aria-labelledby="createBorrowModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-white text-dark py-3 px-4 border-bottom" style="background: #ffffff !important; border-bottom: 1px solid #e2eaf2 !important;">
                <h5 class="modal-title fw-bold mb-0 text-dark" id="createBorrowModalLabel" style="color: #163b5c !important;">
                    Cho mượn sách
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-area="Admin" asp-controller="Circulation" asp-action="CreateBorrow" method="post" id="formCreateBorrow" class="d-flex flex-column overflow-hidden"
                  data-reader-search-url="@Url.Action("SearchReaders", "Circulation", new { area = "Admin" })"
                  data-can-borrow="@(canBorrow ? "true" : "false")">
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <!-- Bước 1: Chọn bạn đọc -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-navy mb-1" for="readerSearch">
                            Bạn đọc <span class="text-danger">*</span>
                        </label>
                        <div id="readerSearchContainer" class="reader-search">
                            <input type="text" id="readerSearch" class="form-control form-control-utc"
                                   placeholder="Nhập tên hoặc mã bạn đọc" maxlength="100" autocomplete="off" spellcheck="false" required
                                   role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="readerSearchResults"
                                   aria-describedby="readerSearchStatus" />
                            <input type="hidden" id="selectedReaderId" name="maBD" />
                            <div id="readerSearchResults" class="reader-search-results" role="listbox" aria-label="Bạn đọc phù hợp" hidden></div>
                            <div id="readerSearchStatus" class="form-text" role="status" aria-live="polite"></div>
                        </div>

                        <!-- Card tóm tắt tình trạng bạn đọc -->
                        <div id="readerInfoCard" class="card mt-2 border bg-light d-none" style="border-radius: 8px;">
                            <div class="card-body p-3">
                                <div class="row align-items-center">
                                    <div class="col-md-7">
                                        <div class="fw-bold text-navy" id="infoReaderName">—</div>
                                        <div class="text-muted small">
                                            Mã bạn đọc: <strong id="infoReaderId" class="text-dark">—</strong> &middot;
                                            Lớp: <span id="infoReaderClass">—</span>
                                        </div>
                                    </div>
                                    <div class="col-md-5 text-md-end mt-2 mt-md-0">
                                        <span id="infoReaderBadge" class="badge bg-primary px-2 py-1">—</span>
                                    </div>
                                </div>
                                <!-- Cảnh báo nếu bạn đọc đã mượn 5 cuốn -->
                                <div id="readerLimitAlert" class="alert alert-danger py-2 px-3 mt-2 mb-0 small d-none" role="alert">
                                    Đã đủ hạn mức <strong>5/5 cuốn</strong>. Vui lòng trả bớt sách.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bước 2: Chọn sách cần mượn -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-navy mb-1" for="selectBook">
                            Sách cần mượn <span class="text-danger">*</span>
                        </label>
                        <select id="selectBook" name="bookId" class="form-select form-control-utc" required disabled>
                            <option value="">-- Chọn bạn đọc trước --</option>
                            @foreach (var book in Model.AvailableBooks)
                            {
                                <option value="@book.Id"
                                        data-title="@book.Title"
                                        data-author="@book.Authors"
                                        data-cover="@book.CoverImage"
                                        data-major="@book.MajorName"
                                        data-copies="@book.AvailableCopies">
                                    @book.Title
                                </option>
                            }
                        </select>
                        <div class="form-text small text-muted">Mỗi đầu sách mượn 1 bản.</div>

                        <!-- Card xem trước sách được chọn -->
                        <div id="bookPreviewCard" class="card mt-2 border d-none" style="border-radius: 8px; background-color: #f8fafc;">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-start gap-3">
                                    <img id="previewBookCover" src="/images/covers/cover-placeholder.svg" alt="Bìa sách"
                                         class="rounded border shadow-sm flex-shrink-0"
                                         style="width: 52px; height: 72px; object-fit: cover;" />
                                    <div class="flex-grow-1">
                                        <h6 id="previewBookTitle" class="fw-bold text-navy mb-1" style="font-size: 14.5px;">Tên sách</h6>
                                        <div class="text-muted small mb-1">Tác giả: <span id="previewBookAuthor" class="text-dark">Tác giả</span></div>
                                        <div class="small">
                                            Còn: <span id="previewBookStock" class="badge bg-success">—</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <dl class="borrow-dates mb-2">
                        <div><dt>Ngày mượn</dt><dd>@todayStr</dd></div>
                        <div><dt>Hạn trả</dt><dd>@dueDateStr</dd></div>
                    </dl>
                    <p class="form-text mb-0">Phạt quá hạn: 100.000 đ/cuốn.</p>
                </div>

                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnConfirmBorrow" class="btn btn-utc-primary px-4 fw-bold" disabled>
                        Cho mượn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 2: XÁC NHẬN TRẢ SÁCH & BỒI THƯỜNG DÙNG CHUNG -->
<!-- ========================================== -->
<!-- Modal dùng chung đã được nhúng tại _AdminLayout -->

@section Scripts {
    <script src="~/js/circulation-borrow.js" asp-append-version="true"></script>
}
