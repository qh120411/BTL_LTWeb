@model BTL_LTWEB.Areas.Admin.ViewModels.CirculationIndexViewModel
@{
    ViewData["Title"] = "Quản lý mượn trả & Lưu thông";
    ViewBag.ActiveMenu = "Circulation";
    string todayStr = DateTime.Today.ToString("dd/MM/yyyy");
    string dueDateStr = DateTime.Today.AddYears(1).ToString("dd/MM/yyyy");
}

<div class="admin-breadcrumb">THƯ VIỆN UTC / QUẢN TRỊ</div>

<!-- Thông báo thao tác thành công / thất bại -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="background-color: #dcfce7; color: #166534; border-left: 4px solid #22c55e !important;">
        <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
            <div>
                <strong>Thao tác thành công:</strong> @TempData["SuccessMessage"]
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="background-color: #fee2e2; color: #991b1b; border-left: 4px solid #ef4444 !important;">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
            <div>
                <strong>Thông báo lỗi:</strong> @TempData["ErrorMessage"]
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="admin-page-title mb-1">Quản lý lưu thông &amp; Mượn trả (@Model.Transactions.Count giao dịch)</h1>
        <div class="text-muted small">
            <i class="bi bi-clock-history me-1 text-primary"></i>
            Thời hạn mượn quy định: <strong>1 năm</strong> &middot; Giới hạn: <strong>Tối đa 5 cuốn / sinh viên</strong> &middot; Cập nhật CSDL Thư viện UTC
        </div>
    </div>
    
</div>



<!-- Bộ lọc tìm kiếm & trạng thái -->
<form method="get" asp-action="Index" class="mb-4">
    <div class="row g-3">
        <div class="col-md-7">
            <label class="form-label-utc">Tra cứu giao dịch</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control form-control-utc border-start-0" 
                       placeholder="Mã giao dịch, mã sinh viên, họ tên, tên sách..." value="@Model.SearchKeyword" />
            </div>
        </div>
        <div class="col-md-5">
            <label class="form-label-utc">Trạng thái giao dịch</label>
            <select name="status" class="form-select form-control-utc" onchange="this.form.submit()">
                <option value="Tất cả trạng thái" selected="@(Model.SelectedStatus == "Tất cả trạng thái")">Tất cả trạng thái</option>
                <option value="Đang mượn" selected="@(Model.SelectedStatus == "Đang mượn")">Đang mượn (Còn hạn)</option>
                <option value="Quá hạn" selected="@(Model.SelectedStatus == "Quá hạn")">Đang quá hạn</option>
            </select>
        </div>
    </div>
</form>

<!-- Bảng danh sách giao dịch mượn trả -->
<div class="admin-table-card">
    <div class="table-responsive">
        <table class="table-utc">
            <thead>
                <tr>
                    <th style="width: 13%;">Mã giao dịch</th>
                    <th style="width: 20%;">Bạn đọc</th>
                    <th style="width: 32%;">Tài liệu / Sách học liệu</th>
                    <th style="width: 12%;">Hạn trả (1 năm)</th>
                    <th style="width: 11%;">Trạng thái</th>
                    <th style="width: 12%; text-align: center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Transactions.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không tìm thấy giao dịch mượn trả nào phù hợp với bộ lọc hiện tại.
                        </td>
                    </tr>
                }
                @foreach (var item in Model.Transactions)
                {
                    <tr>
                        <td>
                            <strong class="text-primary font-monospace">@item.MaGD</strong>
                            <div class="text-muted" style="font-size: 11px;">Mượn: @item.NgayMuon</div>
                        </td>
                        <td>
                            <a href="/Admin/Reader/Details/@item.MaBD" class="fw-bold text-navy text-decoration-none">
                                @item.HoTen
                            </a>
                            <div class="text-muted small">MSV: <code>@item.MaBD</code></div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@(string.IsNullOrEmpty(item.CoverImage) ? "/images/covers/sach_01.jpg" : item.CoverImage)" 
                                     alt="@item.TenSach" 
                                     class="rounded border shadow-sm flex-shrink-0" 
                                     style="width: 38px; height: 50px; object-fit: cover;"
                                     onerror="this.src='/images/covers/sach_01.jpg'" />
                                <div>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 280px;" title="@item.TenSach">
                                        @item.TenSach
                                    </div>
                                    <div class="text-muted small">
                                        Mã bản sao: <span class="badge bg-light text-dark border">@item.MaBanSao</span>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="@(item.IsQuaHan ? "text-danger fw-bold" : "text-dark")">@item.HanTra</span>
                            @if (item.IsQuaHan)
                            {
                                <div class="text-danger small fw-semibold" style="font-size: 11px;">
                                    Phạt 100.000 đ
                                </div>
                            }
                        </td>
                        <td>
                            @if (item.IsQuaHan)
                            {
                                <span class="badge bg-danger text-white px-2 py-1" style="font-weight: 600; font-size: 11.5px; display: inline-flex; align-items: center; gap: 4px;">
                                    <i class="bi bi-exclamation-triangle-fill"></i> @item.TrangThai
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success text-white px-2 py-1" style="font-weight: 600; font-size: 11.5px; display: inline-flex; align-items: center; gap: 4px;">
                                    <i class="bi bi-check-circle-fill"></i> Còn hạn
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center align-items-center gap-1">
                                <!-- Nút trả sách -->
                                <button type="button" class="btn btn-sm btn-outline-success px-2 py-1 btn-return-trigger"
                                        data-magd="@item.MaGD"
                                        data-mabd="@item.MaBD"
                                        data-hoten="@item.HoTen"
                                        data-tensach="@item.TenSach"
                                        data-quahan="@(item.IsQuaHan ? "true" : "false")"
                                        title="Tiếp nhận trả sách tại quầy">
                                    <i class="bi bi-arrow-return-left"></i> Trả sách
                                </button>
                                <!-- Xem hồ sơ bạn đọc -->
                                <a href="/Admin/Reader/Details/@item.MaBD" class="btn btn-sm btn-outline-secondary px-2 py-1" title="Xem hồ sơ bạn đọc">
                                    <i class="bi bi-person-lines-fill"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



<!-- ========================================== -->
<!-- MODAL 2: XÁC NHẬN TRẢ SÁCH & BỒI THƯỜNG DÙNG CHUNG -->
<!-- ========================================== -->
<partial name="_ReturnAndCompensationModal" />

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Bản đồ danh sách sách đã mượn của từng bạn đọc từ CSDL
        var readerBorrowedMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReaderBorrowedTitlesMap));

        var selectReader = document.getElementById("selectReader");
        var selectBook = document.getElementById("selectBook");
        var readerInfoCard = document.getElementById("readerInfoCard");
        var infoReaderName = document.getElementById("infoReaderName");
        var infoReaderId = document.getElementById("infoReaderId");
        var infoReaderClass = document.getElementById("infoReaderClass");
        var infoReaderBadge = document.getElementById("infoReaderBadge");
        var readerLimitAlert = document.getElementById("readerLimitAlert");

        var bookPreviewCard = document.getElementById("bookPreviewCard");
        var previewBookCover = document.getElementById("previewBookCover");
        var previewBookMajor = document.getElementById("previewBookMajor");
        var previewBookTitle = document.getElementById("previewBookTitle");
        var previewBookAuthor = document.getElementById("previewBookAuthor");
        var previewBookStock = document.getElementById("previewBookStock");

        var btnConfirmBorrow = document.getElementById("btnConfirmBorrow");

        // 1. Khi chọn Bạn đọc
        selectReader.addEventListener("change", function () {
            var selectedOpt = selectReader.options[selectReader.selectedIndex];
            var mabd = selectReader.value;

            if (!mabd) {
                readerInfoCard.classList.add("d-none");
                selectBook.disabled = true;
                selectBook.value = "";
                bookPreviewCard.classList.add("d-none");
                btnConfirmBorrow.disabled = true;
                return;
            }

            var name = selectedOpt.getAttribute("data-name");
            var lop = selectedOpt.getAttribute("data-class");
            var count = parseInt(selectedOpt.getAttribute("data-count") || "0");
            var quahan = parseInt(selectedOpt.getAttribute("data-quahan") || "0");

            infoReaderName.textContent = name;
            infoReaderId.textContent = mabd;
            infoReaderClass.textContent = lop;
            var maxLimit = (mabd.toUpperCase().startsWith("GV") || mabd.toUpperCase().startsWith("CB")) ? 10 : 5;
            infoReaderBadge.textContent = "Đang mượn " + count + "/" + maxLimit + " cuốn";

            if (count >= maxLimit) {
                infoReaderBadge.className = "badge bg-danger px-2 py-1";
                var limitSpan = readerLimitAlert.querySelector("strong:nth-of-type(2)");
                if (limitSpan) limitSpan.textContent = maxLimit + "/" + maxLimit + " cuốn sách";
                readerLimitAlert.classList.remove("d-none");
                selectBook.disabled = true;
                selectBook.value = "";
                bookPreviewCard.classList.add("d-none");
                btnConfirmBorrow.disabled = true;
                readerInfoCard.classList.remove("d-none");
                return;
            } else {
                infoReaderBadge.className = "badge bg-primary px-2 py-1";
                readerLimitAlert.classList.add("d-none");
                selectBook.disabled = false;
                readerInfoCard.classList.remove("d-none");
            }

            // Lọc danh mục sách theo quy tắc: 1 bạn đọc chỉ được mượn 1 cuốn / 1 đầu sách
            var borrowedTitles = readerBorrowedMap[mabd] || [];
            var bookOptions = selectBook.options;

            for (var i = 1; i < bookOptions.length; i++) {
                var opt = bookOptions[i];
                var title = opt.getAttribute("data-title") || "";
                var copies = parseInt(opt.getAttribute("data-copies") || "0");

                var isBorrowed = borrowedTitles.some(function(t) {
                    return t.toLowerCase().trim() === title.toLowerCase().trim();
                });

                var baseText = opt.textContent.replace(/ \[(ĐÃ MƯỢN|HẾT SÁCH TRONG KHO)\].*$/, "");

                if (isBorrowed) {
                    opt.disabled = true;
                    opt.textContent = baseText + " [ĐÃ MƯỢN ĐẦU SÁCH NÀY]";
                } else if (copies <= 0) {
                    opt.disabled = true;
                    opt.textContent = baseText + " [HẾT SÁCH TRONG KHO]";
                } else {
                    opt.disabled = false;
                    opt.textContent = baseText;
                }
            }

            // Reset lựa chọn sách
            selectBook.value = "";
            bookPreviewCard.classList.add("d-none");
            btnConfirmBorrow.disabled = true;
        });

        // 2. Khi chọn Sách
        selectBook.addEventListener("change", function () {
            var selectedOpt = selectBook.options[selectBook.selectedIndex];
            var bookId = selectBook.value;

            if (!bookId) {
                bookPreviewCard.classList.add("d-none");
                btnConfirmBorrow.disabled = true;
                return;
            }

            var title = selectedOpt.getAttribute("data-title");
            var author = selectedOpt.getAttribute("data-author");
            var cover = selectedOpt.getAttribute("data-cover");
            var major = selectedOpt.getAttribute("data-major");
            var copies = selectedOpt.getAttribute("data-copies");

            previewBookTitle.textContent = title;
            previewBookAuthor.textContent = author;
            previewBookCover.src = cover || "/images/covers/sach_01.jpg";
            previewBookMajor.textContent = major;
            previewBookStock.textContent = copies + " bản sẵn có";

            bookPreviewCard.classList.remove("d-none");

            // Kiểm tra nút xác nhận
            var selectedReaderOpt = selectReader.options[selectReader.selectedIndex];
            var count = parseInt(selectedReaderOpt.getAttribute("data-count") || "0");
            btnConfirmBorrow.disabled = (count >= 5);
        });
    });
</script>
}