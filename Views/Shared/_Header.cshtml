<header class="site-header">

  <!-- Top utility bar -->
  <div class="topbar">
    <div class="container topbar-inner">
      <span class="topbar-left">TRƯỜNG ĐẠI HỌC GIAO THÔNG VẬN TẢI</span>
      <span class="topbar-right">
        H&#7895; tr&#7907; b&#7841;n &#273;&#7885;c &nbsp;&middot;&nbsp; <a href="#">VI</a> / <a href="#">EN</a>
      </span>
    </div>
  </div>

  <!-- Brand bar -->
  <div class="brandbar">
    <div class="container brandbar-inner">
      <a href="/Reader" class="brand">
        <img src="~/logo/utc.png" asp-append-version="true" alt="Logo UTC" class="brand-logo" />
        <div class="brand-text">
          <span class="brand-title">THƯ VIỆN GIAO THÔNG VẬN TẢI</span>
          <span class="brand-sub">UNIVERSITY OF TRANSPORT AND COMMUNICATIONS LIBRARY</span>
        </div>
      </a>
      <div class="header-actions">
        <a href="/Account/Login" class="btn-figma-secondary btn-header-login">Đăng nhập</a>
      </div>
    </div>
  </div>

  <!-- Main navigation -->
  @{
    var currentPath = Context.Request.Path.Value ?? "";
    var isHome = currentPath.Equals("/Reader", StringComparison.OrdinalIgnoreCase) || currentPath.Equals("/Reader/Home", StringComparison.OrdinalIgnoreCase) || currentPath == "/" || currentPath.Equals("/Reader/Home/Index", StringComparison.OrdinalIgnoreCase);
    var isSearch = currentPath.StartsWith("/Reader/Search", StringComparison.OrdinalIgnoreCase);
    var isGuide = currentPath.StartsWith("/Reader/Guide", StringComparison.OrdinalIgnoreCase);
    var isNews = currentPath.StartsWith("/Reader/News", StringComparison.OrdinalIgnoreCase);
  }
  <nav class="navbar">
    <div class="container nav-inner">
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-list" aria-label="Mở menu">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-list" id="nav-list">
        <li><a href="/Reader" class="@(isHome ? "active" : "")">Trang chủ</a></li>
        <li><a href="/Reader/Search" class="@(isSearch ? "active" : "")">Tra cứu học liệu</a></li>
        <li><a href="/Reader/Guide" class="@(isGuide ? "active" : "")">Dịch vụ</a></li>
        <li><a href="/Reader/News" class="@(isNews ? "active" : "")">Tin tức &amp; thông báo</a></li>
        <li><a href="/Reader/Guide#about">Giới thiệu</a></li>
      </ul>
    </div>
  </nav>

  <!-- UTC brand stripes: navy / gold / sky -->
  <div class="utc-brand-stripes">
    <span class="stripe-navy"></span>
    <span class="stripe-gold"></span>
    <span class="stripe-sky"></span>
  </div>

</header>