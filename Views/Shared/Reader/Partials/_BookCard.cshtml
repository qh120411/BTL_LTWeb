@model BTL_LTWEB.Areas.Reader.Models.BookItem
<a href="/Reader/Document/Details/@Model.Id" class="utc-catalog-book-card">
    <div class="utc-book-cover-wrap">
        <img src="@(string.IsNullOrWhiteSpace(Model.CoverImage) ? "/images/covers/cover-placeholder.svg" : Model.CoverImage)"
             alt="@Model.Title" class="utc-book-cover-img" loading="lazy"
             onerror="this.onerror=null;this.src='/images/covers/cover-placeholder.svg'" />
    </div>
    <span class="utc-book-category">@Model.MajorName</span>
    <div class="utc-book-card-name">@Model.Title</div>
    <span class="utc-book-meta-badge">@Model.StockBadgeText</span>
</a>
