@{
    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "Home";
    bool isStaff = User.IsInRole("Admin") || User.IsInRole("ADMIN") || User.IsInRole("Thuthu")
        || User.IsInRole("QUANLY_BANDOC") || User.IsInRole("QUANLY_TAILIEU");
}
<header class="utc-site-header">
    <div class="utc-institutional-topbar">
        <div class="container utc-topbar-inner">
            <span class="utc-topbar-school">TRƯỜNG ĐẠI HỌC GIAO THÔNG VẬN TẢI</span>
            <div class="utc-topbar-right"><a href="/Reader/Guide" class="utc-topbar-link">Hỗ trợ bạn đọc</a><span>·</span><span>VI / EN</span></div>
        </div>
    </div>
    <div class="utc-brand-header">
        <div class="container utc-brand-inner">
            <a href="/Reader/Home" class="utc-brand-lockup">
                <img src="~/images/figma/brand/utc-logo.png" alt="Đại học Giao thông vận tải" class="utc-logo-img" width="64" height="64" />
                <div class="utc-brand-titles">
                    <span class="utc-brand-name">THƯ VIỆN ĐẠI HỌC GIAO THÔNG VẬN TẢI</span>
                    <span class="utc-brand-sub">UNIVERSITY OF TRANSPORT AND COMMUNICATIONS LIBRARY</span>
                </div>
            </a>
            <div class="utc-header-account-actions">
                @if (isStaff)
                {
                    <a href="/Admin/Dashboard" class="utc-header-btn-admin">Trang quản trị →</a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/Reader/Profile" class="utc-header-btn-user"><span class="utc-user-name">@User.Identity.Name</span></a>
                    <a href="/Account/Logout" class="utc-header-btn-logout">Đăng xuất</a>
                }
                else
                {
                    <a href="/Account/Login" class="utc-header-btn-login">Đăng nhập</a>
                }
            </div>
        </div>
    </div>
    <nav class="utc-main-navbar" aria-label="Điều hướng chính">
        <div class="container utc-navbar-inner">
            <button class="utc-navbar-toggler d-lg-none" type="button" data-utc-nav-toggle aria-controls="utcReaderNav" aria-expanded="false" aria-label="Mở menu"><i class="bi bi-list" aria-hidden="true"></i> Menu</button>
            <ul class="utc-navbar-menu" id="utcReaderNav">
                <li><a href="/Reader/Home" class="utc-navbar-link @(currentController == "Home" ? "active" : "")">Trang chủ</a></li>
                <li><a href="/Reader/Search" class="utc-navbar-link @(currentController == "Search" || currentController == "Document" ? "active" : "")">Tra cứu học liệu</a></li>
                <li><a href="/Reader/Guide" class="utc-navbar-link @(currentController == "Guide" ? "active" : "")">Dịch vụ</a></li>
                <li><a href="/Reader/News" class="utc-navbar-link @(currentController == "News" ? "active" : "")">Tin tức &amp; thông báo</a></li>
                @if (!isStaff && User.Identity?.IsAuthenticated == true)
                {
                    <li><a href="/Reader/Profile" class="utc-navbar-link @(currentController == "Profile" ? "active" : "")">Hồ sơ bạn đọc</a></li>
                }
            </ul>
        </div>
    </nav>
    <partial name="~/Views/Shared/_UtcBrandStripes.cshtml" />
</header>
