    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BTL_LTWEB.styles.css" asp-append-version="true" />
</head>

<body>
    <!-- Partial Header riêng biệt -->
    <partial name="_Header" />

    <!-- Nội dung chính của từng trang -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Partial Footer riêng biệt -->
    <partial name="_Footer" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Toggle mobile navigation
        document.addEventListener("DOMContentLoaded", function () {
            var toggle = document.querySelector(".utc-mobile-nav-toggle");
            var nav = document.getElementById("utcNavList");
            if (toggle && nav) {
                toggle.addEventListener("click", function () {
                    nav.classList.toggle("show");
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
