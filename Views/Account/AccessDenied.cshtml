@{
    ViewData["Title"] = "Không có quyền truy cập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Truy cập bị từ chối - Thư viện UTC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #0f274a 0%, #06152b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            margin: 0;
            padding: 20px;
        }
        .utc-denied-card {
            background-color: #ffffff;
            color: #1e293b;
            border-radius: 20px;
            padding: 48px;
            max-width: 560px;
            width: 100%;
            text-align: center;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
        }
        .utc-icon-wrap {
            width: 80px;
            height: 80px;
            background-color: #fee2e2;
            color: #dc2626;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 38px;
            margin: 0 auto 24px;
        }
        .btn-return {
            background-color: #0b4ea2;
            color: #ffffff;
            font-weight: 600;
            padding: 12px 28px;
            border-radius: 8px;
            text-decoration: none;
            display: inline-block;
            transition: all 0.2s ease;
        }
        .btn-return:hover {
            background-color: #083c7d;
            color: #ffffff;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>
    <div class="utc-denied-card">
        <div class="utc-icon-wrap">
            <i class="bi bi-shield-slash-fill"></i>
        </div>
        <h2 class="fw-bold fs-3 text-danger mb-2">Truy cập bị từ chối (403)</h2>
        <div class="badge bg-secondary-subtle text-secondary mb-3 py-2 px-3 fs-6">
            Tài khoản: @(User.Identity?.Name ?? "Bạn đọc") &middot; Vai trò: <strong>Bạn đọc (Sinh viên)</strong>
        </div>
        <p class="text-muted mb-4" style="line-height: 1.6;">
            Bạn đang đăng nhập với vai trò <strong>Bạn đọc (Sinh viên)</strong>. Khu vực này chỉ dành riêng cho cán bộ Ban Quản trị và Thủ thư Thư viện Đại học GTVT. Bạn không có quyền truy cập vào phân hệ Quản trị.
        </p>
        <div class="d-flex flex-column gap-2">
            <a href="/Reader/Home" class="btn-return">
                <i class="bi bi-house-door-fill me-1"></i> Trở về Cổng Bạn đọc UTC
            </a>
            <a href="/Account/Logout" class="text-muted small mt-2 text-decoration-none">
                Đăng xuất để đăng nhập với tài khoản Quản trị viên
            </a>
        </div>
    </div>
</body>
</html>
