@{
    ViewData["Title"] = "Cổng thông tin Thư viện & Học liệu số - UTC";
    Layout = null;
    string returnUrl = ViewBag.ReturnUrl ?? "";
    string errorMsg = ViewBag.Error ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Cổng thông tin Thư viện UTC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --utc-blue-dark: #072b61;
            --utc-blue-mid: #0b4ea2;
            --utc-blue-light: #1565c0;
            --utc-accent: #f59e0b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background: linear-gradient(180deg, rgba(7, 43, 97, 0.42) 0%, rgba(2, 132, 199, 0.18) 45%, rgba(3, 24, 56, 0.58) 100%), 
                        url('/images/utc-campus-login-bg.jpg') center center / cover no-repeat fixed;
            min-height: 100vh;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow-x: hidden;
        }

        /* Subtle background effects */
        .utc-bg-glow { display: none; }

        /* Light sparkles and bottom arc */
        .utc-bg-ribbon { display: none; }

        .utc-main-container {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 1240px;
            margin: 0 auto;
            padding: 24px 20px 20px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Header Bar */
        .utc-top-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .utc-header-brand {
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
        }

        .utc-header-logo {
            width: 54px;
            height: 54px;
            object-fit: contain;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));
        }

        .utc-header-school-name {
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: #ffcc00;
            text-transform: uppercase;
            line-height: 1.2;
        }

        .utc-header-school-sub {
            font-size: 11px;
            color: rgba(255, 255, 255, 0.8);
            font-weight: 500;
        }

        .utc-header-portal-title {
            text-align: center;
            flex: 1;
        }

        .utc-portal-h1 {
            font-size: 24px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-bottom: 4px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
        }

        .utc-portal-sub {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.85);
            font-weight: 400;
        }

        /* Main Login Layout - Căn giữa cả chiều dọc lẫn chiều ngang màn hình */
        .utc-portal-grid {
            display: flex;
            justify-content: center;
            align-items: center;
            flex: 1;
            width: 100%;
            padding: 40px 0 60px;
        }

        /* Right Card - Login Form Căn giữa */
        .utc-login-card {
            width: 100%;
            max-width: 460px;
            padding: 44px 34px 34px;
            position: relative;
            box-shadow: 0 24px 60px -10px rgba(0, 0, 0, 0.35), inset 0 1px 2px rgba(255, 255, 255, 0.9);
        }

        /* White Rounded Cards */
        .utc-white-card {
            background: rgba(255, 255, 255, 0.45);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1.5px solid rgba(255, 255, 255, 0.75);
            border-radius: 24px;
            padding: 36px 32px;
            box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.25), inset 0 1px 2px rgba(255, 255, 255, 0.85);
            color: #0f172a;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .utc-white-card:hover {
            background: rgba(255, 255, 255, 0.52);
            box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.32), inset 0 1px 2px rgba(255, 255, 255, 0.95);
        }

        .utc-white-card:hover {
            box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.42), 0 0 0 1px rgba(255, 255, 255, 0.6);
        }

        /* Left Card - Welcome & Features */
        .utc-welcome-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }

        .utc-welcome-icon-circle {
            width: 42px;
            height: 42px;
            background-color: #1565c0;
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
            box-shadow: 0 4px 10px rgba(21, 101, 192, 0.3);
        }

        .utc-welcome-title {
            font-size: 19px;
            font-weight: 800;
            color: #072b61;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            text-shadow: 0 1px 2px rgba(255, 255, 255, 0.8);
        }

        .utc-welcome-desc-main {
            font-size: 13.5px;
            line-height: 1.55;
            color: #1e293b;
            font-weight: 500;
            margin-bottom: 8px;
            text-shadow: 0 1px 1px rgba(255, 255, 255, 0.6);
        }

        .utc-welcome-desc-sub {
            font-size: 13px;
            line-height: 1.5;
            color: #334155;
            font-weight: 500;
            margin-bottom: 24px;
            text-shadow: 0 1px 1px rgba(255, 255, 255, 0.5);
        }

        /* 4 Library Function Boxes (2x2) */
        .utc-lib-features-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        @@media (max-width: 575px) {
            .utc-lib-features-grid {
                grid-template-columns: 1fr;
            }
        }

        .utc-feature-box {
            background: rgba(255, 255, 255, 0.48);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.85);
            border-radius: 16px;
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 15px rgba(2, 132, 199, 0.08), inset 0 1px 1px rgba(255, 255, 255, 0.9);
            text-decoration: none;
            color: inherit;
        }

        .utc-feature-box:hover {
            background: rgba(255, 255, 255, 0.72);
            border-color: #38bdf8;
            box-shadow: 0 10px 24px rgba(2, 132, 199, 0.22);
            transform: translateY(-3px);
            color: inherit;
        }

        .utc-feature-box:hover {
            border-color: #1565c0;
            box-shadow: 0 8px 18px rgba(21, 101, 192, 0.12);
            transform: translateY(-2px);
            color: inherit;
        }

        .utc-feature-icon-square {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            color: #ffffff;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
        }

        .utc-feature-info {
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .utc-feature-title {
            font-size: 14px;
            font-weight: 700;
            color: #072b61;
            margin-bottom: 2px;
        }

        .utc-feature-sub {
            font-size: 12px;
            color: #334155;
            font-weight: 500;
            line-height: 1.35;
        }

        /* Right Card - Login Form */
        .utc-login-card {
            padding: 40px 32px 32px;
            position: relative;
        }

        /* Floating Lock Badge */
        .utc-floating-lock-badge {
            position: absolute;
            top: -24px;
            left: 50%;
            transform: translateX(-50%);
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #1976d2 0%, #0d47a1 100%);
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            box-shadow: 0 6px 16px rgba(13, 71, 161, 0.4);
            border: 4px solid #ffffff;
        }

        .utc-login-title {
            text-align: center;
            font-size: 22px;
            font-weight: 800;
            color: #072b61;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-top: 6px;
            margin-bottom: 22px;
            text-shadow: 0 1px 2px rgba(255, 255, 255, 0.8);
        }

        /* Form Inputs */
        .utc-input-group {
            position: relative;
            margin-bottom: 16px;
        }

        .utc-input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 17px;
            pointer-events: none;
        }

        .utc-form-input {
            width: 100%;
            padding: 12px 16px 12px 42px;
            border: 1.5px solid rgba(255, 255, 255, 0.85);
            border-radius: 12px;
            font-size: 14px;
            color: #0f172a;
            font-weight: 600;
            outline: none;
            transition: all 0.2s ease;
            background-color: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05), inset 0 1px 2px rgba(255, 255, 255, 0.8);
        }

        .utc-form-input:focus {
            background-color: rgba(255, 255, 255, 0.9);
            border-color: #0284c7;
            box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.28);
        }

        .utc-toggle-password {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #94a3b8;
            font-size: 17px;
            cursor: pointer;
            padding: 4px;
        }

        .utc-toggle-password:hover {
            color: #1e293b;
        }

        .utc-login-help-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .utc-login-help-row a {
            color: #0284c7;
            text-decoration: none;
            font-weight: 700;
            text-shadow: 0 1px 1px rgba(255, 255, 255, 0.8);
        }

        .utc-login-help-row a:hover {
            text-decoration: underline;
        }

        /* Primary Login Button */
        .utc-btn-submit {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 15px rgba(2, 132, 199, 0.4);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .utc-btn-submit:hover {
            background: linear-gradient(180deg, #1a5bb8 0%, #0f4088 100%);
            box-shadow: 0 6px 16px rgba(12, 54, 116, 0.45);
            transform: translateY(-1px);
        }

        .utc-btn-submit:disabled {
            opacity: 0.85;
            cursor: not-allowed;
            transform: none !important;
        }

        /* Spinner Loading */
        .utc-spinner {
            width: 18px;
            height: 18px;
            border: 2.5px solid rgba(255, 255, 255, 0.35);
            border-top-color: #ffffff;
            border-radius: 50%;
            animation: utcSpin 0.75s linear infinite;
            display: inline-block;
        }

        @@keyframes utcSpin {
            to { transform: rotate(360deg); }
        }

        /* Fullscreen Glassmorphism Loading Overlay */
        .utc-login-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(7, 43, 97, 0.45);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 99999;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        .utc-login-overlay.show {
            display: flex;
            opacity: 1;
        }

        .utc-overlay-card {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 32px 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
            animation: utcScaleIn 0.25s ease-out;
            max-width: 340px;
            text-align: center;
        }

        @@keyframes utcScaleIn {
            from { transform: scale(0.92); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .utc-pulse-loader {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: 3.5px solid #e0f2fe;
            border-top-color: #0284c7;
            animation: utcSpin 0.8s linear infinite;
            margin-bottom: 16px;
        }

        .utc-overlay-title {
            color: #072b61;
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .utc-overlay-subtitle {
            color: #64748b;
            font-size: 12.5px;
            font-weight: 500;
        }

        /* Divider */
        .utc-divider-wrap {
            display: flex;
            align-items: center;
            margin: 18px 0;
            color: #334155;
            font-size: 12.5px;
            font-weight: 600;
        }

        .utc-divider-wrap::before,
        .utc-divider-wrap::after {
            content: '';
            flex: 1;
            height: 1px;
            background-color: rgba(255, 255, 255, 0.7);
        }

        .utc-divider-wrap span {
            padding: 0 12px;
        }

        /* Microsoft Login Button */
        .utc-btn-microsoft {
            width: 100%;
            padding: 11px;
            background-color: rgba(255, 255, 255, 0.55);
            backdrop-filter: blur(10px);
            border: 1.5px solid rgba(255, 255, 255, 0.85);
            border-radius: 12px;
            color: #1e293b;
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .utc-btn-microsoft:hover {
            background-color: rgba(255, 255, 255, 0.85);
            border-color: #38bdf8;
            color: #0284c7;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
        }

        .utc-btn-microsoft:hover {
            background-color: #f8fafc;
            border-color: #94a3b8;
            color: #0f172a;
        }

        /* Microsoft 4-square icon */
        .ms-grid-icon {
            display: grid;
            grid-template-columns: 8px 8px;
            grid-gap: 2px;
        }

        .ms-sq { width: 8px; height: 8px; border-radius: 1px; }
        .ms-sq-red { background-color: #f25022; }
        .ms-sq-green { background-color: #7fba00; }
        .ms-sq-blue { background-color: #00a4ef; }
        .ms-sq-yellow { background-color: #ffb900; }

        /* Quick Account Chips for Demo */
        .utc-demo-chips {
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px dashed #e2e8f0;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .utc-demo-title {
            font-size: 11.5px;
            color: #64748b;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .utc-chips-row {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .utc-chip {
            background-color: rgba(255, 255, 255, 0.55);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.85);
            padding: 5px 12px;
            border-radius: 8px;
            font-size: 12px;
            color: #0369a1;
            cursor: pointer;
            font-weight: 700;
            transition: all 0.15s ease;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        }

        .utc-chip:hover {
            background-color: rgba(255, 255, 255, 0.9);
            border-color: #0284c7;
            color: #0284c7;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.2);
            transform: translateY(-1px);
        }

        .utc-chip:hover {
            background-color: #e0f2fe;
            border-color: #38bdf8;
        }

        /* 4 Bottom Feature Badges */
        .utc-bottom-features-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        @@media (max-width: 850px) {
            .utc-bottom-features-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 480px) {
            .utc-bottom-features-row {
                grid-template-columns: 1fr;
            }
        }

        .utc-badge-card {
            background: rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.35);
            border-radius: 16px;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
            transition: all 0.25s ease;
        }

        .utc-badge-card:hover {
            background: rgba(255, 255, 255, 0.28);
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
        }

        .utc-badge-icon {
            font-size: 24px;
            color: #38bdf8;
            flex-shrink: 0;
        }

        .utc-badge-text-title {
            font-size: 13.5px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 1px;
        }

        .utc-badge-text-sub {
            font-size: 11px;
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.3;
        }

        /* Continuous Running Marquee at the very bottom */
        .utc-marquee-banner {
            width: 100%;
            background: transparent;
            border-top: none;
            border-bottom: none;
            padding: 12px 0 16px;
            overflow: hidden;
            white-space: nowrap;
            position: relative;
            z-index: 10;
        }

        .utc-marquee-track {
            display: inline-block;
            white-space: nowrap;
            animation: utcMarquee 26s linear infinite;
        }

        .utc-marquee-item {
            display: inline-block;
            color: #ffffff;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.4px;
            padding-right: 60px;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85), 0 0 4px rgba(0, 0, 0, 0.9);
        }

        .utc-marquee-item strong {
            color: #ffcc00;
            font-weight: 700;
        }

        @@keyframes utcMarquee {
            0% {
                transform: translateX(0);
            }
            100% {
                transform: translateX(-50%);
            }
        }
    </style>
</head>
<body>
    <div class="utc-bg-glow"></div>
    <div class="utc-bg-ribbon"></div>

    <div class="utc-main-container">
        <!-- Top Header: Logo + Title -->
        <header class="utc-top-header">
            <div class="utc-header-brand">
                <img src="~/logo/utc.png" alt="UTC Logo" class="utc-header-logo" onerror="this.src='/images/logo.png'" />
                <div>
                    <div class="utc-header-school-name">TRƯỜNG ĐẠI HỌC GIAO THÔNG VẬN TẢI</div>
                    <div class="utc-header-school-sub">UNIVERSITY OF TRANSPORT AND COMMUNICATIONS</div>
                </div>
            </div>

            <div class="utc-header-portal-title">
                <h1 class="utc-portal-h1">CỔNG THÔNG TIN THƯ VIỆN &amp; HỌC LIỆU SỐ</h1>
                <p class="utc-portal-sub">Tra cứu mục lục OPAC, mượn trả tài liệu và quản lý thẻ thư viện trực tuyến dễ dàng, nhanh chóng</p>
            </div>
        </header>

        <!-- Main Login Layout: Căn giữa màn hình -->
        <main class="utc-portal-grid">
            <!-- Card: Login Form -->
            <section class="utc-white-card utc-login-card">
                <!-- Floating Lock Circle Badge -->
                <div class="utc-floating-lock-badge">
                    <i class="bi bi-lock-fill"></i>
                </div>

                <h2 class="utc-login-title">ĐĂNG NHẬP</h2>

                @if (!string.IsNullOrEmpty(errorMsg))
                {
                    <div class="alert alert-danger py-2 px-3 small mb-3 border-0 rounded-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorMsg
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post" id="loginForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <!-- Ô tài khoản / mã sinh viên -->
                    <div class="utc-input-group">
                        <i class="bi bi-person utc-input-icon"></i>
                        <input type="text" 
                               name="username" 
                               id="loginUsername" 
                               class="utc-form-input" 
                               placeholder="Mã sinh viên (VD: 242630923) hoặc tài khoản admin" 
                               required 
                               autocomplete="username" />
                    </div>

                    <!-- Ô mật khẩu -->
                    <div class="utc-input-group">
                        <i class="bi bi-lock utc-input-icon"></i>
                        <input type="password" 
                               name="password" 
                               id="loginPassword" 
                               class="utc-form-input" 
                               placeholder="Mật khẩu (VD: Dat242630923 hoặc Admin@123)" 
                               required 
                               autocomplete="current-password" />
                        <button type="button" class="utc-toggle-password" id="togglePasswordBtn" title="Hiện/Ẩn mật khẩu">
                            <i class="bi bi-eye" id="toggleEyeIcon"></i>
                        </button>
                    </div>

                    <div class="utc-login-help-row">
                        <a href="javascript:void(0)" onclick="toggleDemoChips()" id="forgotPasswordLink">
                            Quên mật khẩu?
                        </a>
                        <a href="javascript:void(0)" onclick="alert('QUY TẮC ĐĂNG NHẬP THƯ VIỆN UTC:\n\n1. Sinh viên (Bạn đọc):\n- Tài khoản: Mã sinh viên (VD: 242630923)\n- Mật khẩu: Tên + Mã sinh viên (VD: Đỗ Văn Đạt -> Dat242630923, Nguyễn Văn An -> An242630899)\n\n2. Quản trị viên (Admin):\n- Tài khoản: admin\n- Mật khẩu: Admin@123')">
                            <i class="bi bi-question-circle me-1"></i> Trợ giúp!
                        </a>
                    </div>

                    <!-- Nút Đăng nhập chính -->
                    <button type="submit" class="utc-btn-submit" id="loginSubmitBtn">
                        <span id="btnSubmitText">ĐĂNG NHẬP</span>
                    </button>
                </form>

                <!-- Quick Fill Chips for Demo (Mặc định ẩn, ấn Quên mật khẩu mới hiện ra) -->
                <div class="utc-demo-chips" id="demoChipsWrapper" style="display: none;">
                    <span class="utc-demo-title"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Đăng nhập nhanh (Demo):</span>
                    <div class="utc-chips-row">
                        <button type="button" class="utc-chip" onclick="fillAccount('242630923', 'Dat242630923')">
                            🎓 SV Đỗ Văn Đạt (Dat242630923)
                        </button>
                        <button type="button" class="utc-chip" onclick="fillAccount('GV01', 'TuanGV01')">
                            👨‍🏫 GV TS. Nguyễn Văn Tuấn (TuanGV01)
                        </button>
                        <button type="button" class="utc-chip" onclick="fillAccount('GV02', 'MaiGV02')">
                            👩‍🏫 GV PGS.TS. Trần Thị Mai (MaiGV02)
                        </button>
                        <button type="button" class="utc-chip" onclick="fillAccount('admin', 'Admin@123')">
                            🛡️ Quản trị: admin (Admin@123)
                        </button>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- Loading Overlay khi nhấn Đăng nhập -->
    <div class="utc-login-overlay" id="loginLoadingOverlay">
        <div class="utc-overlay-card">
            <div class="utc-pulse-loader"></div>
            <div class="utc-overlay-title">Đang xác thực tài khoản...</div>
            <div class="utc-overlay-subtitle">Vui lòng chờ trong giây lát</div>
        </div>
    </div>



    <script>
        // Toggle ẩn/hiện mật khẩu
        const toggleBtn = document.getElementById('togglePasswordBtn');
        const passwordInput = document.getElementById('loginPassword');
        const eyeIcon = document.getElementById('toggleEyeIcon');

        toggleBtn.addEventListener('click', function () {
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.classList.remove('bi-eye');
                eyeIcon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                eyeIcon.classList.remove('bi-eye-slash');
                eyeIcon.classList.add('bi-eye');
            }
        });

        // Điền nhanh tài khoản demo
        function fillAccount(username, password) {
            document.getElementById('loginUsername').value = username;
            document.getElementById('loginPassword').value = password;
        }

        // Bật/tắt hiện danh sách tài khoản demo khi ấn Quên mật khẩu
        function toggleDemoChips() {
            const chips = document.getElementById('demoChipsWrapper');
            if (chips) {
                chips.style.display = (chips.style.display === 'none' || chips.style.display === '') ? 'flex' : 'none';
            }
        }

        // Hiệu ứng Loading khi gửi form Đăng nhập
        const loginForm = document.getElementById('loginForm');
        const loginSubmitBtn = document.getElementById('loginSubmitBtn');
        const btnSubmitText = document.getElementById('btnSubmitText');
        const loginLoadingOverlay = document.getElementById('loginLoadingOverlay');

        loginForm.addEventListener('submit', function (e) {
            const usernameVal = document.getElementById('loginUsername').value.trim();
            const passwordVal = document.getElementById('loginPassword').value.trim();

            if (usernameVal && passwordVal) {
                // Đổi nút thành trạng thái xoay spinner
                loginSubmitBtn.disabled = true;
                loginSubmitBtn.innerHTML = '<span class="utc-spinner"></span> Đang đăng nhập...';

                // Bật full-screen glassmorphism overlay loading
                if (loginLoadingOverlay) {
                    loginLoadingOverlay.classList.add('show');
                }
            }
        });
    </script>
</body>
</html>
