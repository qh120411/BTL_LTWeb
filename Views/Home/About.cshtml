@{
    ViewData["Title"] = "Giới thiệu";
}

<section class="py-5" style="background-color: var(--utc-paper);">
    <div class="container">
        <div class="utc-breadcrumb">TRANG CHỦ / GIỚI THIỆU</div>
        <h1 class="utc-page-title-main">Trung tâm Thông tin – Thư viện UTC</h1>
        <p class="utc-page-subtitle-main">
            Trường Đại học Giao thông vận tải (University of Transport and Communications)
        </p>

        <div class="row g-4 mt-2">
            <div class="col-lg-8">
                <div class="p-4 p-md-5 rounded-utc border-utc bg-white shadow-sm mb-4">
                    <h3 class="text-navy fw-bold fs-4 mb-3">Lịch sử phát triển &amp; Sứ mệnh</h3>
                    <p class="text-muted leading-relaxed">
                        Trung tâm Thông tin – Thư viện Trường Đại học Giao thông vận tải là đơn vị phục vụ học tập, giảng dạy và nghiên cứu khoa học của toàn thể cán bộ, giảng viên, học viên và sinh viên trường.
                    </p>
                    <p class="text-muted leading-relaxed">
                        Thư viện hiện sở hữu hàng trăm ngàn bản sách in, giáo trình chuyên ngành Giao thông vận tải, Xây dựng, Cơ khí, Điện tử, Công nghệ thông tin, Kinh tế vận tải, cùng nguồn học liệu điện tử, cơ sở dữ liệu số phong phú.
                    </p>
                    <div class="row g-3 mt-4 pt-3 border-top">
                        <div class="col-sm-4 text-center">
                            <div class="fs-2 fw-bold text-brand">50.000+</div>
                            <div class="text-muted small">Đầu sách &amp; Tài liệu</div>
                        </div>
                        <div class="col-sm-4 text-center">
                            <div class="fs-2 fw-bold text-brand">15.000+</div>
                            <div class="text-muted small">Bạn đọc thường xuyên</div>
                        </div>
                        <div class="col-sm-4 text-center">
                            <div class="fs-2 fw-bold text-brand">3 Tầng</div>
                            <div class="text-muted small">Không gian Nhà A8</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="p-4 rounded-utc border-utc bg-soft shadow-sm">
                    <h4 class="text-navy fw-bold fs-5 mb-3">Thông tin liên hệ</h4>
                    <ul class="utc-footer-list text-muted small" style="color: var(--utc-ink) !important;">
                        <li class="mb-2"><i class="bi bi-geo-alt-fill text-brand me-2"></i> Tầng 5, 6, 7 · Nhà A8 · Trường ĐH GTVT, Số 3 Cầu Giấy, Hà Nội</li>
                        <li class="mb-2"><i class="bi bi-telephone-fill text-brand me-2"></i> 024.37669860</li>
                        <li class="mb-2"><i class="bi bi-envelope-fill text-brand me-2"></i> thuvien@utc.edu.vn</li>
                        <li><i class="bi bi-clock-fill text-brand me-2"></i> 07:30 – 17:00 (Thứ 2 – Thứ 6)</li>
                    </ul>
                    <a href="/Home/Services" class="btn-utc-primary w-100 text-center mt-4">
                        Xem nội quy &amp; hướng dẫn &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
