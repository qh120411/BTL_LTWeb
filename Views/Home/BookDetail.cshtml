@{
    ViewData["Title"] = "Chi tiết học liệu - Lập trình Python cơ bản";
}

@section Styles {
    <link rel="stylesheet" href="~/css/book-detail.css" asp-append-version="true" />
}

<section class="utc-detail-section">
    <div class="container">
        <!-- Breadcrumb & Tiêu đề -->
        <div class="utc-detail-header-row">
            <div class="utc-breadcrumb">TRANG CHỦ / TRA CỨU / CHI TIẾT</div>
            <h1 class="utc-page-title-main">Lập trình Python cơ bản</h1>
        </div>

        <!-- Layout 2 cột: Bìa sách + Thông tin chi tiết -->
        <div class="utc-detail-main-layout">
            <!-- Cột trái: Bìa sách Typographic chuẩn UTC -->
            <div class="utc-detail-cover-card">
                <span class="utc-detail-cover-tag">UTC / HỌC LIỆU</span>
                <div class="utc-detail-cover-title">
                    Lập trình<br />Python
                </div>
                <div class="utc-detail-cover-footer">
                    <span>Giáo trình đại học chính quy</span>
                </div>
            </div>

            <!-- Cột phải: Thông tin thư mục & Trạng thái lưu thông -->
            <div class="utc-detail-content">
                <div class="utc-detail-status-banner">
                    <i class="bi bi-check-circle-fill"></i> 11 bản sẵn có tại thư viện
                </div>

                <p class="utc-detail-desc">
                    Giáo trình nhập môn toàn diện về cú pháp ngôn ngữ Python, các kiểu dữ liệu và cấu trúc dữ liệu nền tảng, kỹ thuật xây dựng hàm, lập trình hướng đối tượng cơ bản và các bài tập thực hành áp dụng trong xử lý dữ liệu kỹ thuật.
                </p>

                <!-- Lưới thông tin thư mục -->
                <div class="utc-metadata-grid">
                    <div class="utc-meta-item">
                        <span class="utc-meta-label">Mã đầu sách</span>
                        <div class="utc-meta-value">DS001</div>
                    </div>
                    <div class="utc-meta-item">
                        <span class="utc-meta-label">Loại tài liệu</span>
                        <div class="utc-meta-value">Sách / Giáo trình</div>
                    </div>
                    <div class="utc-meta-item">
                        <span class="utc-meta-label">Ngôn ngữ</span>
                        <div class="utc-meta-value">Tiếng Việt</div>
                    </div>
                    <div class="utc-meta-item">
                        <span class="utc-meta-label">Chuyên ngành</span>
                        <div class="utc-meta-value">Công nghệ thông tin</div>
                    </div>
                </div>

                <!-- Tóm tắt số lượng kho -->
                <div class="utc-stock-summary">
                    <i class="bi bi-pie-chart-fill me-1 text-brand"></i> 
                    Tổng số: <strong>20 bản</strong> &middot; Sẵn có: <strong class="text-success">11</strong> &middot; Đang mượn: <strong class="text-primary">8</strong> &middot; Báo mất/hỏng: <strong class="text-danger">1</strong>
                </div>

                <!-- Các nút thao tác -->
                <div class="utc-detail-actions">
                    <a href="/Home/Services" class="btn-utc-primary">
                        <i class="bi bi-journal-arrow-down me-1"></i> Hướng dẫn mượn tại quầy
                    </a>
                    <a href="/Home/Login" class="btn-utc-secondary">
                        <i class="bi bi-person-badge me-1"></i> Đăng nhập mượn trực tuyến
                    </a>
                    <a href="/Home/Search" class="btn-utc-secondary">
                        &larr; Quay lại danh sách
                    </a>
                </div>

                <!-- Banner hướng dẫn bạn đọc -->
                <div class="utc-borrow-guide-box">
                    <span class="utc-borrow-guide-title">
                        <i class="bi bi-info-circle-fill me-1"></i> Bạn muốn mượn tài liệu này?
                    </span>
                    <p class="utc-borrow-guide-desc">
                        Bạn đọc chỉ cần xuất trình Thẻ sinh viên hoặc Thẻ bạn đọc UTC tại <strong>Quầy thủ thư - Tầng 5 Nhà A8</strong>. Thời hạn mượn tiêu chuẩn là 14 ngày (có thể gia hạn trực tuyến qua tài khoản cá nhân).
                    </p>
                </div>
            </div>
        </div>

        <!-- Bảng danh sách các bản sách đang lưu hành -->
        <div class="utc-copies-section">
            <h3 class="utc-copies-title">Danh sách các bản sách cụ thể (Bản sao lưu hành)</h3>
            <table class="utc-copies-table">
                <thead>
                    <tr>
                        <th style="width: 18%;">Mã bản sách</th>
                        <th style="width: 25%;">Vị trí lưu kho</th>
                        <th style="width: 22%;">Tình trạng bản sách</th>
                        <th style="width: 20%;">Trạng thái mượn</th>
                        <th style="width: 15%;">Hạn trả dự kiến</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>BS001-01</strong></td>
                        <td>Kệ CNTT-02, Tầng 6</td>
                        <td>Tốt (Mới 95%)</td>
                        <td><span class="badge-available"><i class="bi bi-check-circle"></i> Sẵn sàng phục vụ</span></td>
                        <td>-</td>
                    </tr>
                    <tr>
                        <td><strong>BS001-02</strong></td>
                        <td>Kệ CNTT-02, Tầng 6</td>
                        <td>Tốt (Mới 90%)</td>
                        <td><span class="badge-available"><i class="bi bi-check-circle"></i> Sẵn sàng phục vụ</span></td>
                        <td>-</td>
                    </tr>
                    <tr>
                        <td><strong>BS001-03</strong></td>
                        <td>Kệ CNTT-02, Tầng 6</td>
                        <td>Bình thường</td>
                        <td><span class="badge-borrowed"><i class="bi bi-person-fill"></i> Đang cho mượn</span></td>
                        <td>28/11/2026</td>
                    </tr>
                    <tr>
                        <td><strong>BS001-04</strong></td>
                        <td>Kệ Lưu trữ, Tầng 7</td>
                        <td>Hỏng gáy bìa</td>
                        <td><span class="badge-overdue"><i class="bi bi-tools"></i> Đang bảo quản / tu sửa</span></td>
                        <td>-</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>
