@{
    var path = ViewContext.View?.Path ?? "";
    if (path.Contains("/Admin/") || path.Contains("\\Admin\\") || path.Contains("/Admin\\") || path.Contains("\\Admin/"))
    {
        Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    }
    else if (path.Contains("/Reader/") || path.Contains("\\Reader\\") || path.Contains("/Reader\\") || path.Contains("\\Reader/"))
    {
        Layout = "~/Views/Shared/Reader/_ReaderLayout.cshtml";
    }
    else
    {
        Layout = "_Layout";
    }
}
