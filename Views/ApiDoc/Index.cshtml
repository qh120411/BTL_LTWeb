@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>API Documentation & Tester - UTC Library</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --swagger-green: #49cc90;
            --swagger-blue: #4990e2;
            --swagger-orange: #fca130;
            --swagger-red: #f93e3e;
            --swagger-header-bg: #1b1b1b;
            --bg-page: #fafafa;
        }
        body {
            background-color: var(--bg-page);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #3b4151;
            padding-bottom: 80px;
        }
        .topbar {
            background-color: var(--swagger-header-bg);
            padding: 12px 24px;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .topbar-title {
            font-size: 18px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .topbar-badge {
            background: #49cc90;
            color: #fff;
            font-size: 11px;
            padding: 2px 8px;
            border-radius: 12px;
            font-weight: 600;
        }
        .info-container {
            padding: 30px 0 20px;
            border-bottom: 1px solid #e0e0e0;
            margin-bottom: 30px;
        }
        .api-tag-group {
            margin-bottom: 25px;
        }
        .api-tag-title {
            font-size: 20px;
            font-weight: 700;
            color: #3b4151;
            padding-bottom: 8px;
            border-bottom: 1px solid #d9d9d9;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .opblock {
            border-radius: 4px;
            margin-bottom: 10px;
            border: 1px solid #000;
            background: #fff;
            overflow: hidden;
            box-shadow: 0 1px 2px rgba(0,0,0,.05);
        }
        .opblock-get {
            border-color: #61affe;
            background: rgba(97, 175, 254, .1);
        }
        .opblock-get .opblock-summary {
            border-color: #61affe;
        }
        .opblock-post {
            border-color: #49cc90;
            background: rgba(73, 204, 144, .1);
        }
        .opblock-post .opblock-summary {
            border-color: #49cc90;
        }
        .opblock-summary {
            padding: 8px 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            user-select: none;
            gap: 12px;
        }
        .opblock-method {
            font-size: 13px;
            font-weight: 700;
            min-width: 70px;
            padding: 6px 12px;
            text-align: center;
            border-radius: 3px;
            color: #fff;
            text-shadow: 0 1px 0 rgba(0,0,0,.1);
        }
        .opblock-get .opblock-method { background: #61affe; }
        .opblock-post .opblock-method { background: #49cc90; }
        .opblock-path {
            font-family: monospace;
            font-size: 15px;
            font-weight: 600;
            color: #3b4151;
            word-break: break-all;
        }
        .opblock-desc {
            font-size: 13px;
            color: #606770;
            margin-left: auto;
        }
        .opblock-body {
            padding: 16px;
            background: #fff;
            border-top: 1px solid rgba(0,0,0,.1);
            display: none;
        }
        .param-table {
            width: 100%;
            font-size: 13px;
            margin-bottom: 15px;
        }
        .param-table th {
            padding: 6px;
            border-bottom: 1px solid #ccc;
            color: #666;
            font-weight: 600;
        }
        .param-table td {
            padding: 8px 6px;
            vertical-align: top;
            border-bottom: 1px solid #f0f0f0;
        }
        .code-preview {
            background: #2b2b2b;
            color: #f8f8f2;
            padding: 12px;
            border-radius: 4px;
            font-family: monospace;
            font-size: 13px;
            max-height: 280px;
            overflow: auto;
            white-space: pre-wrap;
            word-break: break-all;
        }
        .btn-try {
            font-size: 12px;
            font-weight: 600;
            padding: 5px 14px;
        }
    </style>
</head>
<body>

    <header class="topbar">
        <div class="topbar-title">
            <i class="bi bi-filetype-json text-warning"></i>
            <span>UTC Library API Documentation</span>
            <span class="topbar-badge">v1.0 (REST/MVC)</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">Trường Đại học Giao thông Vận tải (UTC)</span>
            <a href="/" class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-up-right me-1"></i>Về trang chủ</a>
        </div>
    </header>

    <div class="container py-4">
        <div class="info-container">
            <h2 class="fw-bold mb-1">Cổng tra cứu &amp; Kiểm thử API Hệ thống Thư viện UTC</h2>
            <p class="text-muted mb-3" style="font-size: 14px;">
                Trang tài liệu độc lập mô tả các Endpoint API (JSON &amp; Form Data) dùng cho tra cứu học liệu OPAC, quản lý cán bộ, phân quyền, mượn trả và hồ sơ bạn đọc. Bạn có thể bấm <strong>"Thử nghiệm (Try it out)"</strong> để gửi request trực tiếp và kiểm tra phản hồi.
            </p>
            <div class="d-flex gap-2 flex-wrap">
                <span class="badge bg-secondary">Base URL: <code>@Context.Request.Scheme://@Context.Request.Host</code></span>
                <span class="badge bg-primary">Content-Type: application/json / x-www-form-urlencoded</span>
                <span class="badge bg-success">Status: Online</span>
            </div>
        </div>

        <!-- 1. NHÓM XÁC THỰC & ĐĂNG NHẬP -->
        <div class="api-tag-group">
            <div class="api-tag-title">
                <i class="bi bi-shield-lock-fill text-primary"></i> 1. Authentication &amp; Account
            </div>

            <!-- POST /Account/Login -->
            <div class="opblock opblock-post">
                <div class="opblock-summary" onclick="toggleOpblock(this)">
                    <span class="opblock-method">POST</span>
                    <span class="opblock-path">/Account/Login</span>
                    <span class="opblock-desc">Đăng nhập hệ thống (Sinh viên hoặc Cán bộ)</span>
                </div>
                <div class="opblock-body">
                    <h6>Parameters (Form Data)</h6>
                    <table class="param-table">
                        <thead><tr><th>Tên tham số</th><th>Loại</th><th>Bắt buộc</th><th>Mô tả</th><th>Giá trị test</th></tr></thead>
                        <tbody>
                            <tr>
                                <td><code>username</code></td>
                                <td>string</td>
                                <td><span class="badge bg-danger">Có</span></td>
                                <td>Mã SV (VD: 242630923) hoặc Mã NV / admin</td>
                                <td><input type="text" class="form-control form-control-sm" id="login_username" value="admin" /></td>
                            </tr>
                            <tr>
                                <td><code>password</code></td>
                                <td>string</td>
                                <td><span class="badge bg-danger">Có</span></td>
                                <td>Mật khẩu tương ứng</td>
                                <td><input type="password" class="form-control form-control-sm" id="login_password" value="Admin@123" /></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="mb-3">
                        <button class="btn btn-sm btn-success btn-try" onclick="executePostForm('/Account/Login', { username: document.getElementById('login_username').value, password: document.getElementById('login_password').value }, 'res_login')">
                            <i class="bi bi-play-fill"></i> Execute (Try it out)
                        </button>
                    </div>
                    <h6>Server Response</h6>
                    <pre class="code-preview" id="res_login">Chưa gửi request</pre>
                </div>
            </div>

            <!-- POST /Account/Logout -->
            <div class="opblock opblock-post">
                <div class="opblock-summary" onclick="toggleOpblock(this)">
                    <span class="opblock-method">POST</span>
                    <span class="opblock-path">/Account/Logout</span>
                    <span class="opblock-desc">Đăng xuất và hủy phiên đăng nhập</span>
                </div>
                <div class="opblock-body">
                    <p class="text-muted small">Hủy bỏ Cookie phiên <code>UTC_Library_Auth_v3</code> và chuyển hướng về trang chủ.</p>
                    <button class="btn btn-sm btn-success btn-try" onclick="executePostForm('/Account/Logout', {}, 'res_logout')">
                        <i class="bi bi-play-fill"></i> Execute (Try it out)
                    </button>
                    <h6 class="mt-3">Server Response</h6>
                    <pre class="code-preview" id="res_logout">Chưa gửi request</pre>
                </div>
            </div>
        </div>

        <!-- 2. NHÓM QUẢN TRỊ HỌC LIỆU & BẢN SAO SÁCH (CATALOG) -->
        <div class="api-tag-group">
            <div class="api-tag-title">
                <i class="bi bi-book-half text-success"></i> 2. Book Catalog &amp; Copies (Học liệu &amp; Bản sao)
            </div>

            <!-- GET /Admin/Catalog/GetCopies -->
            <div class="opblock opblock-get">
                <div class="opblock-summary" onclick="toggleOpblock(this)">
                    <span class="opblock-method">GET</span>
                    <span class="opblock-path">/Admin/Catalog/GetCopies?id={id}</span>
                    <span class="opblock-desc">Lấy danh sách mã vạch &amp; tình trạng bản sao sách</span>
                </div>
                <div class="opblock-body">
                    <h6>Query Parameters</h6>
                    <table class="param-table">
                        <thead><tr><th>Tên tham số</th><th>Loại</th><th>Bắt buộc</th><th>Mô tả</th><th>Giá trị test</th></tr></thead>
                        <tbody>
                            <tr>
                                <td><code>id</code></td>
                                <td>int</td>
                                <td><span class="badge bg-danger">Có</span></td>
                                <td>Mã đầu sách tài liệu (ID)</td>
                                <td><input type="number" class="form-control form-control-sm" id="copies_id" value="1" /></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="mb-3">
                        <button class="btn btn-sm btn-primary btn-try" onclick="executeGet('/Admin/Catalog/GetCopies?id=' + document.getElementById('copies_id').value, 'res_copies')">
                            <i class="bi bi-play-fill"></i> Execute (Try it out)
                        </button>
                    </div>
                    <h6>Server Response (JSON)</h6>
                    <pre class="code-preview" id="res_copies">Chưa gửi request</pre>
                </div>
            </div>

            <!-- GET /Admin/Catalog/GetBook -->
            <div class="opblock opblock-get">
                <div class="opblock-summary" onclick="toggleOpblock(this)">
                    <span class="opblock-method">GET</span>
                    <span class="opblock-path">/Admin/Catalog/GetBook?id={id}</span>
                    <span class="opblock-desc">Lấy thông tin chi tiết một đầu sách để cập nhật</span>
                </div>
                <div class="opblock-body">
                    <h6>Query Parameters</h6>
                    <table class="param-table">
                        <thead><tr><th>Tên tham số</th><th>Loại</th><th>Bắt buộc</th><th>Mô tả</th><th>Giá trị test</th></tr></thead>
                        <tbody>
                            <tr>
                                <td><code>id</code></td>
                                <td>int</td>
                                <td><span class="badge bg-danger">Có</span></td>
                                <td>Mã đầu sách tài liệu</td>
                                <td><input type="number" class="form-control form-control-sm" id="book_id" value="1" /></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="mb-3">
                        <button class="btn btn-sm btn-primary btn-try" onclick="executeGet('/Admin/Catalog/GetBook?id=' + document.getElementById('book_id').value, 'res_book')">
                            <i class="bi bi-play-fill"></i> Execute (Try it out)
                        </button>
                    </div>
                    <h6>Server Response (JSON)</h6>
                    <pre class="code-preview" id="res_book">Chưa gửi request</pre>
                </div>
            </div>
        </div>

        <!-- 3. NHÓM QUẢN LÝ TÀI KHOẢN & PHÂN QUYỀN (USER MANAGEMENT) -->
        <div class="api-tag-group">
            <div class="api-tag-title">
                <i class="bi bi-people-fill text-info"></i> 3. User Management &amp; Permissions (Quản lý Cán bộ)
            </div>

            <!-- POST /Admin/User/UpdateRole -->
            <div class="opblock opblock-post">
                <div class="opblock-summary" onclick="toggleOpblock(this)">
                    <span class="opblock-method">POST</span>
                    <span class="opblock-path">/Admin/User/UpdateRole</span>
                    <span class="opblock-desc">Cập nhật vai trò phân quyền cán bộ (Chỉ Super Admin)</span>
                </div>
                <div class="opblock-body">
                    <h6>Parameters (Form Data)</h6>
                    <table class="param-table">
                        <thead><tr><th>Tên tham số</th><th>Loại</th><th>Bắt buộc</th><th>Mô tả</th><th>Giá trị test</th></tr></thead>
                        <tbody>
                            <tr>
                                <td><code>maTaiKhoan</code></td>
                                <td>int</td>
                                <td><span class="badge bg-danger">Có</span></td>
                                <td>Mã tài khoản cán bộ trong SQL Server</td>
                                <td><input type="number" class="form-control form-control-sm" id="role_id" value="2" /></td>
                            </tr>
                            <tr>
                                <td><code>vaiTro</code></td>
                                <td>string</td>
                                <td><span class="badge bg-danger">Có</span></td>
                                <td>Vai trò (QUANLY_BANDOC, QUANLY_TAILIEU)</td>
                                <td>
                                    <select class="form-select form-select-sm" id="role_code">
                                        <option value="QUANLY_BANDOC">QUANLY_BANDOC (Quản lý bạn đọc)</option>
                                        <option value="QUANLY_TAILIEU">QUANLY_TAILIEU (Thủ thư mượn trả)</option>
                                        <option value="ADMIN">ADMIN (Thử nghiệm chặn cấp quyền Admin)</option>
                                    </select>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="mb-3">
                        <button class="btn btn-sm btn-success btn-try" onclick="executePostForm('/Admin/User/UpdateRole', { maTaiKhoan: document.getElementById('role_id').value, vaiTro: document.getElementById('role_code').value }, 'res_role')">
                            <i class="bi bi-play-fill"></i> Execute (Try it out)
                        </button>
                    </div>
                    <h6>Server Response (JSON)</h6>
                    <pre class="code-preview" id="res_role">Chưa gửi request</pre>
                </div>
            </div>

            <!-- POST /Admin/User/AddStaff -->
            <div class="opblock opblock-post">
                <div class="opblock-summary" onclick="toggleOpblock(this)">
                    <span class="opblock-method">POST</span>
                    <span class="opblock-path">/Admin/User/AddStaff</span>
                    <span class="opblock-desc">Thêm mới tài khoản cán bộ thư viện</span>
                </div>
                <div class="opblock-body">
                    <h6>Parameters (Form Data)</h6>
                    <table class="param-table">
                        <thead><tr><th>Tên tham số</th><th>Loại</th><th>Bắt buộc</th><th>Mô tả</th><th>Giá trị test</th></tr></thead>
                        <tbody>
                            <tr>
                                <td><code>maNv</code></td>
                                <td>string</td>
                                <td><span class="badge bg-danger">Có</span></td>
                                <td>Mã cán bộ (VD: NV26-05)</td>
                                <td><input type="text" class="form-control form-control-sm" id="new_manv" value="NV26-05" /></td>
                            </tr>
                            <tr>
                                <td><code>hoTen</code></td>
                                <td>string</td>
                                <td><span class="badge bg-danger">Có</span></td>
                                <td>Họ tên cán bộ</td>
                                <td><input type="text" class="form-control form-control-sm" id="new_hoten" value="Vũ Quang Huy" /></td>
                            </tr>
                            <tr>
                                <td><code>email</code></td>
                                <td>string</td>
                                <td><span class="badge bg-danger">Có</span></td>
                                <td>Email đăng nhập</td>
                                <td><input type="email" class="form-control form-control-sm" id="new_email" value="huy.demo@utc.edu.vn" /></td>
                            </tr>
                            <tr>
                                <td><code>vaiTro</code></td>
                                <td>string</td>
                                <td><span class="badge bg-danger">Có</span></td>
                                <td>Vai trò cán bộ</td>
                                <td>
                                    <select class="form-select form-select-sm" id="new_vaitro">
                                        <option value="QUANLY_BANDOC">QUANLY_BANDOC (Quản lý bạn đọc)</option>
                                        <option value="QUANLY_TAILIEU">QUANLY_TAILIEU (Thủ thư mượn trả)</option>
                                    </select>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="mb-3">
                        <button class="btn btn-sm btn-success btn-try" onclick="executePostForm('/Admin/User/AddStaff', { maNv: document.getElementById('new_manv').value, hoTen: document.getElementById('new_hoten').value, email: document.getElementById('new_email').value, vaiTro: document.getElementById('new_vaitro').value }, 'res_addstaff')">
                            <i class="bi bi-play-fill"></i> Execute (Try it out)
                        </button>
                    </div>
                    <h6>Server Response (JSON)</h6>
                    <pre class="code-preview" id="res_addstaff">Chưa gửi request</pre>
                </div>
            </div>

            <!-- POST /Admin/User/DeleteStaff -->
            <div class="opblock opblock-post">
                <div class="opblock-summary" onclick="toggleOpblock(this)">
                    <span class="opblock-method">POST</span>
                    <span class="opblock-path">/Admin/User/DeleteStaff</span>
                    <span class="opblock-desc">Xóa tài khoản cán bộ (Chỉ Quản trị viên tối cao)</span>
                </div>
                <div class="opblock-body">
                    <h6>Parameters (Form Data)</h6>
                    <table class="param-table">
                        <thead><tr><th>Tên tham số</th><th>Loại</th><th>Bắt buộc</th><th>Mô tả</th><th>Giá trị test</th></tr></thead>
                        <tbody>
                            <tr>
                                <td><code>maTaiKhoan</code></td>
                                <td>int</td>
                                <td><span class="badge bg-danger">Có</span></td>
                                <td>Mã tài khoản cán bộ cần xóa</td>
                                <td><input type="number" class="form-control form-control-sm" id="del_account_id" value="5" /></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="mb-3">
                        <button class="btn btn-sm btn-danger btn-try" onclick="executePostForm('/Admin/User/DeleteStaff', { maTaiKhoan: document.getElementById('del_account_id').value }, 'res_delstaff')">
                            <i class="bi bi-play-fill"></i> Execute (Try it out)
                        </button>
                    </div>
                    <h6>Server Response (JSON)</h6>
                    <pre class="code-preview" id="res_delstaff">Chưa gửi request</pre>
                </div>
            </div>
        </div>

        <!-- 4. NHÓM BÁO CÁO THỐNG KÊ (REPORT) -->
        <div class="api-tag-group">
            <div class="api-tag-title">
                <i class="bi bi-bar-chart-fill text-warning"></i> 4. Reports &amp; Analytics (Báo cáo thống kê)
            </div>

            <!-- GET /Admin/Report/ExportExcel -->
            <div class="opblock opblock-get">
                <div class="opblock-summary" onclick="toggleOpblock(this)">
                    <span class="opblock-method">GET</span>
                    <span class="opblock-path">/Admin/Report/ExportExcel?fromDate={fromDate}&amp;toDate={toDate}</span>
                    <span class="opblock-desc">Xuất báo cáo lưu thông thư viện ra file Excel (.xls)</span>
                </div>
                <div class="opblock-body">
                    <h6>Query Parameters</h6>
                    <table class="param-table">
                        <thead><tr><th>Tên tham số</th><th>Loại</th><th>Bắt buộc</th><th>Mô tả</th><th>Giá trị test</th></tr></thead>
                        <tbody>
                            <tr>
                                <td><code>fromDate</code></td>
                                <td>date</td>
                                <td><span class="badge bg-secondary">Tùy chọn</span></td>
                                <td>Từ ngày (YYYY-MM-DD)</td>
                                <td><input type="date" class="form-control form-control-sm" id="rep_from" value="2026-10-01" /></td>
                            </tr>
                            <tr>
                                <td><code>toDate</code></td>
                                <td>date</td>
                                <td><span class="badge bg-secondary">Tùy chọn</span></td>
                                <td>Đến ngày (YYYY-MM-DD)</td>
                                <td><input type="date" class="form-control form-control-sm" id="rep_to" value="2026-10-31" /></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="mb-3">
                        <a id="btn_export_excel" href="#" target="_blank" class="btn btn-sm btn-primary btn-try" onclick="this.href='/Admin/Report/ExportExcel?fromDate=' + document.getElementById('rep_from').value + '&toDate=' + document.getElementById('rep_to').value">
                            <i class="bi bi-download me-1"></i> Tải file Excel
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <script>
        var requestVerificationToken = '@ViewBag.RequestToken';

        function toggleOpblock(el) {
            var body = el.nextElementSibling;
            if (body.style.display === "block") {
                body.style.display = "none";
            } else {
                body.style.display = "block";
            }
        }

        function executeGet(url, outputId) {
            var out = document.getElementById(outputId);
            out.textContent = "Đang gửi request GET: " + url + "...";

            fetch(url)
                .then(function(res) {
                    var status = "HTTP " + res.status + " " + res.statusText + "\n\n";
                    return res.text().then(function(text) {
                        try {
                            var json = JSON.parse(text);
                            out.textContent = status + JSON.stringify(json, null, 2);
                        } catch(e) {
                            out.textContent = status + text;
                        }
                    });
                })
                .catch(function(err) {
                    out.textContent = "Error: " + err;
                });
        }

        function executePostForm(url, data, outputId) {
            var out = document.getElementById(outputId);
            out.textContent = "Đang gửi request POST: " + url + "...";

            var formData = new URLSearchParams();
            // Gửi kèm AntiForgeryToken tự động để vượt qua ValidateAntiForgeryToken của ASP.NET Core
            if (requestVerificationToken) {
                formData.append('__RequestVerificationToken', requestVerificationToken);
            }
            for (var key in data) {
                formData.append(key, data[key]);
            }

            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': requestVerificationToken || ''
                },
                body: formData.toString()
            })
            .then(function(res) {
                var status = "HTTP " + res.status + " " + res.statusText + "\n\n";
                if (res.redirected) {
                    out.textContent = status + "Đã xử lý thành công và chuyển hướng (Redirected) tới: " + res.url;
                    return;
                }
                return res.text().then(function(text) {
                    try {
                        var json = JSON.parse(text);
                        out.textContent = status + JSON.stringify(json, null, 2);
                    } catch(e) {
                        out.textContent = status + text;
                    }
                });
            })
            .catch(function(err) {
                out.textContent = "Error: " + err;
            });
        }
    </script>
</body>
</html>
