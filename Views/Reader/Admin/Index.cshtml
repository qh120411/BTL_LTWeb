@model ReaderIndexViewModel
@{
    ViewData["Title"] = "Quản lý bạn đọc";
    ViewBag.ActiveMenu = "Reader";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="admin-page-title mb-1">Quản lý bạn đọc</h1>
    </div>

</div>



<!-- Bộ lọc tìm kiếm theo Tên hoặc Mã sinh viên / Mã giảng viên -->
<form method="get" asp-action="Index" class="mb-4" id="readerFilterForm">
    <div class="row g-3">
        <div class="col-md-7">
            <label class="form-label-utc">Tìm bạn đọc</label>
            <div class="input-group">

                <input type="text" name="search" class="form-control form-control-utc"
                       placeholder="Tên hoặc mã bạn đọc"
                       value="@Model.SearchKeyword" />
                @if (!string.IsNullOrWhiteSpace(Model.SearchKeyword))
                {
                    <a href="@Url.Action("Index", new { group = Model.SelectedGroup })" class="btn btn-outline-secondary" title="Xóa tìm kiếm">Xóa lọc</a>
                }
                <button class="btn btn-utc-primary px-3" type="submit">
                     Tra cứu
                </button>
            </div>
        </div>
        <div class="col-md-5">
            <label class="form-label-utc">Nhóm bạn đọc</label>
            <select name="group" class="form-select form-control-utc" onchange="this.form.submit()">
                @foreach (var g in Model.Groups)
                {
                    <option value="@g" selected="@(g == Model.SelectedGroup)">@g</option>
                }
            </select>
        </div>
    </div>
</form>

<!-- ======================================================= -->
<!-- BẢNG 1 (BẢNG TRÊN): DANH SÁCH BẠN ĐỌC ĐANG MƯỢN SÁCH -->
<!-- ======================================================= -->
<div class="mb-5 admin-reader-list" id="borrowingReaders">
    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
        <div class="d-flex align-items-center gap-2">

            <div>
                <h5 class="fw-bold text-navy mb-0" style="font-size: 16px;">
                    Đang mượn sách · @Model.BorrowingReaders.Count bạn đọc
                </h5>

            </div>
        </div>

    </div>

    <div class="admin-table-card admin-paged-list shadow-sm border" style="border-radius: 8px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table-utc mb-0">
                <thead>
                    <tr style="background-color: #f1f8fc;">
                        <th style="width: 14%;">Mã bạn đọc</th>
                        <th style="width: 22%;">Họ và tên</th>
                        <th style="width: 22%;">Lớp / Đơn vị</th>
                        <th style="width: 14%;">Quyền sử dụng</th>
                        <th style="width: 11%; text-align: center;">Đang mượn</th>
                        <th style="width: 10%; text-align: center;">Quá hạn</th>
                        <th style="width: 7%; text-align: right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.BorrowingReaders.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="py-4 text-center text-muted">

                                Không có bạn đọc phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in Model.BorrowingReadersOnPage)
                        {
                            <tr>
                                <td>
                                    <strong class="font-monospace text-primary">@r.MaBD</strong>
                                    @if (r.Nhom == "Giảng viên")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle ms-1" style="font-size: 14px;">GV</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@r.MaBD" class="fw-bold text-navy text-decoration-none">
                                        @r.HoTen
                                    </a>
                                </td>
                                <td><span class="text-muted small">@r.LopKhoa</span></td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 14px;">
                                         @r.QuyenSuDung
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    <span class="badge bg-primary text-white px-2 py-1" style="font-weight: 600;">
                                         @r.SoSachDangMuon cuốn
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    @if (r.SoSachQuaHan > 0)
                                    {
                                        <span class="badge bg-danger text-white px-2 py-1" style="font-weight: 600;">
                                             @r.SoSachQuaHan cuốn
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success" style="font-size: 14px;">Còn hạn</span>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <a asp-action="Details" asp-route-id="@r.MaBD" class="btn btn-outline-primary btn-sm px-2 py-1" style="font-size: 14px; white-space: nowrap;">
                                        Xem hồ sơ
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <partial name="~/Views/Shared/Admin/_AdminListPagination.cshtml" model="Model.BorrowingPagination" />
    </div>
</div>

<!-- ======================================================= -->
<!-- BẢNG 2 (BẢNG DƯỚI): DANH SÁCH BẠN ĐỌC KHÔNG MƯỢN SÁCH -->
<!-- ======================================================= -->
<div class="mb-4 admin-reader-list" id="nonBorrowingReaders">
    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
        <div class="d-flex align-items-center gap-2">

            <div>
                <h5 class="fw-bold text-navy mb-0" style="font-size: 16px;">
                    Chưa mượn sách · @Model.NonBorrowingReaders.Count bạn đọc
                </h5>

            </div>
        </div>

    </div>

    <div class="admin-table-card admin-paged-list shadow-sm border" style="border-radius: 8px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table-utc mb-0">
                <thead>
                    <tr style="background-color: #f8fafc;">
                        <th style="width: 14%;">Mã bạn đọc</th>
                        <th style="width: 22%;">Họ và tên</th>
                        <th style="width: 22%;">Lớp / Đơn vị</th>
                        <th style="width: 14%;">Quyền sử dụng</th>
                        <th style="width: 11%; text-align: center;">Tình trạng mượn</th>
                        <th style="width: 10%; text-align: center;">Hạn mức</th>
                        <th style="width: 7%; text-align: right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.NonBorrowingReaders.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="py-4 text-center text-muted">

                                Không có bạn đọc phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in Model.NonBorrowingReadersOnPage)
                        {
                            <tr>
                                <td>
                                    <strong class="font-monospace text-dark">@r.MaBD</strong>
                                    @if (r.Nhom == "Giảng viên")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle ms-1" style="font-size: 14px;">GV</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@r.MaBD" class="fw-bold text-navy text-decoration-none">
                                        @r.HoTen
                                    </a>
                                </td>
                                <td><span class="text-muted small">@r.LopKhoa</span></td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 14px;">
                                         @r.QuyenSuDung
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    <span class="badge bg-light text-muted border px-2 py-1" style="font-size: 14px;">
                                        Chưa mượn (0 cuốn)
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    <span class="text-muted small">Tối đa @(r.Nhom == "Giảng viên" ? 10 : 5) cuốn</span>
                                </td>
                                <td style="text-align: right;">
                                    <a asp-action="Details" asp-route-id="@r.MaBD" class="btn btn-outline-primary btn-sm px-2 py-1" style="font-size: 14px; white-space: nowrap;">
                                        Xem hồ sơ
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <partial name="~/Views/Shared/Admin/_AdminListPagination.cshtml" model="Model.NonBorrowingPagination" />
    </div>
</div>
