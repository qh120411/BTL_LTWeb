{
  "openapi": "3.0.3",
  "info": {
    "title": "UTC Library API",
    "version": "1.0",
    "description": "Tài liệu 11 endpoint JSON của Thư viện UTC. Danh mục công khai; dữ liệu bạn đọc, mượn trả và thống kê yêu cầu cookie cán bộ. POST mượn/trả yêu cầu anti-forgery token và dùng cùng nghiệp vụ SQL với Admin; không tạo giao dịch dự phòng trong JSON. Swagger UI tự gửi token từ trang /ApiDoc. Ví dụ là dữ liệu minh họa; POST thực sự ghi dữ liệu. Xem docs/API.md."
  },
  "servers": [
    {
      "url": "/",
      "description": "Cùng origin với ứng dụng đang chạy"
    }
  ],
  "tags": [
    {
      "name": "Hệ thống",
      "description": "Kết nối SQL và số liệu tổng quát."
    },
    {
      "name": "Phiên đăng nhập",
      "description": "Đọc phiên cookie hiện tại."
    },
    {
      "name": "Học liệu",
      "description": "Danh mục và bản sao từ catalog."
    },
    {
      "name": "Mượn trả",
      "description": "Giao dịch đang mượn và thao tác ghi dữ liệu."
    },
    {
      "name": "Bạn đọc",
      "description": "Danh sách, hồ sơ và dữ liệu mượn."
    },
    {
      "name": "Thống kê",
      "description": "Tổng hợp lưu thông và tài chính."
    }
  ],
  "security": [],
  "paths": {
    "/api/system/health": {
      "get": {
        "tags": [
          "Hệ thống"
        ],
        "operationId": "getSystemHealth",
        "summary": "Kiểm tra hệ thống và kết nối SQL",
        "description": "status luôn là Healthy khi action hoàn tất, kể cả khi databaseConnected=false. totalBooks lấy từ catalog; totalReaders và activeLoans từ ReaderService. Không có phản hồi 503 riêng khi SQL offline.",
        "responses": {
          "200": {
            "description": "Trạng thái và bộ đếm hiện tại.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "Healthy",
                  "time": "2026-11-10 10:00:00",
                  "databaseConnected": true,
                  "totalBooks": 30,
                  "totalReaders": 50,
                  "activeLoans": 18
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/profile": {
      "get": {
        "tags": [
          "Phiên đăng nhập"
        ],
        "operationId": "getCurrentUserProfile",
        "summary": "Xem phiên đăng nhập hiện tại",
        "description": "Không yêu cầu đăng nhập. Cookie UTC_Library_Auth_v3 được cấp qua biểu mẫu /Account/Login có anti-forgery token. Không có endpoint đăng nhập JSON/JWT. Khi chưa đăng nhập vẫn trả 200.",
        "responses": {
          "200": {
            "description": "Hai cấu trúc theo trạng thái đăng nhập.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AnonymousProfile"
                    },
                    {
                      "$ref": "#/components/schemas/AuthenticatedProfile"
                    }
                  ]
                },
                "examples": {
                  "anonymous": {
                    "value": {
                      "isAuthenticated": false,
                      "user": null
                    }
                  },
                  "authenticated": {
                    "value": {
                      "isAuthenticated": true,
                      "username": "tai-khoan-thu-nghiem",
                      "fullName": "Bạn đọc thử nghiệm",
                      "roles": [
                        "Reader"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/books": {
      "get": {
        "tags": [
          "Học liệu"
        ],
        "operationId": "getBooks",
        "summary": "Tìm kiếm và phân trang học liệu",
        "description": "Danh mục công khai; hỗ trợ keyword, page và pageSize. Server chuẩn hóa page >= 1, pageSize trong khoảng 1–100. Không có kết quả trả data=[].",
        "responses": {
          "200": {
            "description": "Danh sách học liệu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookList"
                },
                "example": {
                  "total": 1,
                  "page": 1,
                  "pageSize": 10,
                  "data": [
                    {
                      "id": 1,
                      "title": "Cấu trúc dữ liệu và giải thuật",
                      "author": "Bùi Việt Hà",
                      "major": "cntt",
                      "year": 2023,
                      "shelf": "Kệ IT-01",
                      "availableCopies": 3,
                      "totalCopies": 4,
                      "status": "Có sẵn"
                    }
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "Tìm trong tiêu đề, tác giả, NXB, ISBN, mô tả, tên chuyên ngành; không phân biệt hoa/thường.",
            "schema": {
              "type": "string",
              "example": "Python"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Trang, được chuẩn hóa tối thiểu 1.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Kích thước trang, được chuẩn hóa trong khoảng 1–100.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ]
      }
    },
    "/api/catalog/books/{id}": {
      "get": {
        "tags": [
          "Học liệu"
        ],
        "operationId": "getBookById",
        "summary": "Lấy chi tiết học liệu",
        "description": "Trả BookItem và danh sách bản sao từ catalog. Trường tác giả trong book là authors, khác author của danh sách.",
        "responses": {
          "200": {
            "description": "Chi tiết sách và bản sao.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookDetail"
                }
              }
            }
          },
          "404": {
            "description": "Không có sách trong catalog.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Không tìm thấy sách ID: 999999"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID học liệu trong catalog. Route yêu cầu số nguyên.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 1
            }
          }
        ]
      }
    },
    "/api/catalog/books/{id}/copies": {
      "get": {
        "tags": [
          "Học liệu"
        ],
        "operationId": "getBookCopies",
        "summary": "Lấy bản sao của học liệu",
        "description": "Đọc từ catalog, không truy vấn trực tiếp bảng BanSao. ID không tồn tại vẫn trả 200 với copies=[].",
        "responses": {
          "200": {
            "description": "Danh sách bản sao, có thể rỗng.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookCopies"
                },
                "examples": {
                  "withCopies": {
                    "value": {
                      "bookId": 1,
                      "copies": [
                        {
                          "id": 11,
                          "bookId": 1,
                          "barcode": "UTC-01-01",
                          "shelf": "Kệ IT-01",
                          "condition": "Tốt",
                          "status": "Có sẵn",
                          "importDate": "15/01/2024",
                          "isAvailable": true
                        }
                      ]
                    }
                  },
                  "unknownBook": {
                    "value": {
                      "bookId": 999999,
                      "copies": []
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID học liệu trong catalog. Route yêu cầu số nguyên.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 1
            }
          }
        ]
      }
    },
    "/api/circulation/transactions": {
      "get": {
        "tags": [
          "Mượn trả"
        ],
        "operationId": "getCirculationTransactions",
        "summary": "Xem các giao dịch đang mượn",
        "description": "Chỉ giao dịch chưa trả, loại Đã trả/Đã đền sách mới/Đã đền tiền; không phải lịch sử toàn bộ. Không phân trang. SQL lỗi trả danh sách rỗng; không hợp nhất mượn fallback từ hồ sơ JSON.",
        "responses": {
          "200": {
            "description": "Danh sách giao dịch đang mượn.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionList"
                },
                "example": {
                  "total": 1,
                  "data": [
                    {
                      "maGD": "GD261110-001",
                      "maBD": "242630923",
                      "hoTen": "Bạn đọc thử nghiệm",
                      "maBanSao": "UTC-01-01",
                      "tenSach": "Cấu trúc dữ liệu và giải thuật",
                      "tacGia": "Bùi Việt Hà",
                      "coverImage": "/images/covers/sach_01.jpg",
                      "ngayMuon": "10/11/2026",
                      "hanTra": "31/12/2026",
                      "trangThai": "Còn hạn",
                      "isQuaHan": false
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Cần đăng nhập tài khoản cán bộ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Không đủ quyền cán bộ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "maBD",
            "in": "query",
            "required": false,
            "description": "Mã sinh viên tùy chọn; trim, so khớp không phân biệt hoa/thường.",
            "schema": {
              "type": "string",
              "example": "242630923"
            }
          }
        ],
        "security": [
          {
            "staffCookie": []
          }
        ]
      }
    },
    "/api/circulation/borrow": {
      "post": {
        "tags": [
          "Mượn trả"
        ],
        "operationId": "borrowBook",
        "summary": "Mượn một đầu sách (ghi dữ liệu)",
        "description": "Cán bộ tạo phiếu qua SQL: tối đa 5 sách cho sinh viên, 10 cho GV/CB; chặn trùng đầu sách, hết bản, học liệu điện tử và bạn đọc không tồn tại. Kỳ 1 từ 11/08–31/12, hạn 31/12 cùng năm; kỳ 2 từ 02/01–31/05, hạn 31/05 cùng năm. Không ghi mượn dự phòng vào JSON.",
        "responses": {
          "200": {
            "description": "Mượn thành công; maGD fallback chỉ có trong message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                },
                "examples": {
                  "sql": {
                    "value": {
                      "success": true,
                      "mode": "SQL_Server",
                      "message": "Mượn thành công 'Cấu trúc dữ liệu và giải thuật' cho 242630923"
                    }
                  },
                  "fallback": {
                    "value": {
                      "success": true,
                      "mode": "Offline_Fallback",
                      "message": "Mượn thành công 'Cấu trúc dữ liệu và giải thuật' (Mã GD: GD261110-001)"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ, vi phạm nghiệp vụ hoặc thiếu/sai anti-forgery token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidBody": {
                    "value": {
                      "message": "Vui lòng nhập maBD và bookId."
                    }
                  },
                  "duplicate": {
                    "value": {
                      "success": false,
                      "message": "Bạn đọc đã mượn đầu sách này rồi!"
                    }
                  },
                  "outsideSemester": {
                    "value": {
                      "success": false,
                      "message": "Chỉ cho mượn trong học kỳ: 11/08–31/12 hoặc 02/01–31/05."
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Content-Type không được JSON input formatter hỗ trợ."
          },
          "401": {
            "description": "Cần đăng nhập tài khoản cán bộ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Không đủ quyền cán bộ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BorrowRequest"
              }
            }
          }
        },
        "security": [
          {
            "staffCookie": []
          }
        ],
        "parameters": [
          {
            "name": "RequestVerificationToken",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Anti-forgery token của cùng phiên cookie; Swagger UI tự thêm."
          }
        ]
      }
    },
    "/api/circulation/return": {
      "post": {
        "tags": [
          "Mượn trả"
        ],
        "operationId": "returnBook",
        "summary": "Trả sách (ghi dữ liệu)",
        "description": "Bắt buộc maBD và maGD. Chỉ trả giao dịch đang mượn thuộc bạn đọc này, không tự chọn sách khác. Trả lặp bị từ chối. Tiền phạt và trạng thái sách được lưu cùng transaction SQL.",
        "responses": {
          "200": {
            "description": "Đã xử lý trả sách theo nhánh SQL hoặc fallback.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                },
                "examples": {
                  "sql": {
                    "value": {
                      "success": true,
                      "mode": "SQL_Server",
                      "message": "Đã nhận trả thành công sách 'Cấu trúc dữ liệu và giải thuật'"
                    }
                  },
                  "fallback": {
                    "value": {
                      "success": true,
                      "mode": "Offline_Fallback",
                      "message": "Đã nhận trả thành công sách 'Cấu trúc dữ liệu và giải thuật' (Mã GD: GD261110-001)"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ, vi phạm nghiệp vụ hoặc thiếu/sai anti-forgery token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidBody": {
                    "value": {
                      "message": "Vui lòng nhập maBD."
                    }
                  },
                  "noActiveLoans": {
                    "value": {
                      "success": false,
                      "message": "Bạn đọc '242630923' hiện không có cuốn sách nào đang mượn để trả."
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Content-Type không được JSON input formatter hỗ trợ."
          },
          "401": {
            "description": "Cần đăng nhập tài khoản cán bộ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Không đủ quyền cán bộ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReturnRequest"
              }
            }
          }
        },
        "security": [
          {
            "staffCookie": []
          }
        ],
        "parameters": [
          {
            "name": "RequestVerificationToken",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Anti-forgery token của cùng phiên cookie; Swagger UI tự thêm."
          }
        ]
      }
    },
    "/api/readers": {
      "get": {
        "tags": [
          "Bạn đọc"
        ],
        "operationId": "getReaders",
        "summary": "Tìm danh sách bạn đọc",
        "description": "Không phân trang. SQL lỗi trả total=0, data=[]. Service hiện phân nhóm theo mã thành Sinh viên hoặc Giảng viên; Ngoài trường chỉ là lựa chọn trên model.",
        "responses": {
          "200": {
            "description": "Danh sách bạn đọc sau lọc.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderList"
                },
                "example": {
                  "total": 1,
                  "data": [
                    {
                      "maBD": "242630923",
                      "hoTen": "Bạn đọc thử nghiệm",
                      "nhom": "Sinh viên",
                      "lopKhoa": "K65.CLCCNTT1",
                      "quyenSuDung": "Hoạt động",
                      "soSachDangMuon": 1,
                      "soSachQuaHan": 0
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Cần đăng nhập tài khoản cán bộ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Không đủ quyền cán bộ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "Tìm mã, họ tên, lớp/khoa; hỗ trợ không dấu cho họ tên và lớp/khoa.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "description": "Sinh viên hoặc Giảng viên; bỏ trống/Tất cả nhóm để không lọc. So khớp không phân biệt hoa/thường.",
            "schema": {
              "type": "string",
              "example": "Sinh viên"
            }
          }
        ],
        "security": [
          {
            "staffCookie": []
          }
        ]
      }
    },
    "/api/readers/{id}": {
      "get": {
        "tags": [
          "Bạn đọc"
        ],
        "operationId": "getReaderDetail",
        "summary": "Lấy chi tiết bạn đọc",
        "description": "Tra cứu theo mã sinh viên hoặc khóa số MaBanDoc. Không tạo hồ sơ mẫu. Mã không tồn tại trả 404; mất kết nối SQL có thể trả 500.",
        "responses": {
          "200": {
            "description": "Chi tiết SQL hoặc hồ sơ fallback.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SqlReaderResponse"
                }
              }
            }
          },
          "400": {
            "description": "ID chỉ chứa khoảng trắng.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Vui lòng nhập ID bạn đọc."
                }
              }
            }
          },
          "404": {
            "description": "Không lấy được hồ sơ có họ tên.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Không tìm thấy bạn đọc 'unknown'"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi SQL chưa được xử lý trong nhánh tra cứu khóa số; nội dung tùy môi trường, không đảm bảo JSON."
          },
          "401": {
            "description": "Cần đăng nhập tài khoản cán bộ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Không đủ quyền cán bộ.",
            "content": {
              "application/json": {
                "schema": {
