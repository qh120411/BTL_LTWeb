{
  "openapi": "3.0.3",
  "info": {
    "title": "UTC Library API",
    "version": "1.0",
    "description": "Tài liệu 11 endpoint JSON hiện có của Thư viện UTC. Ví dụ là dữ liệu minh họa.\n\nAPI dùng camelCase, chưa có envelope lỗi chung. Các endpoint hiện chưa bắt buộc đăng nhập/vai trò; cookie UTC_Library_Auth_v3 chỉ nhận diện phiên cho /api/auth/profile. POST mượn/trả ghi dữ liệu thật.\n\nDữ liệu kết hợp SQL Server, catalog JSON và hồ sơ JSON; fallback không bảo đảm đồng bộ mọi nguồn. Controller chưa có [ApiController] và không kiểm tra ModelState, vì vậy không bảo đảm mọi JSON sai kiểu/cú pháp được chuẩn hóa thành lỗi validation. Lỗi chưa xử lý có thể trả 500 với nội dung tùy môi trường.\n\nHướng dẫn và ví dụ PowerShell: docs/API.md trong repository."
  },
  "servers": [
    {
      "url": "/",
      "description": "Cùng origin với ứng dụng đang chạy"
    }
  ],
  "tags": [
    {
      "name": "Hệ thống",
      "description": "Kết nối SQL và số liệu tổng quát."
    },
    {
      "name": "Phiên đăng nhập",
      "description": "Đọc phiên cookie hiện tại."
    },
    {
      "name": "Học liệu",
      "description": "Danh mục và bản sao từ catalog."
    },
    {
      "name": "Mượn trả",
      "description": "Giao dịch đang mượn và thao tác ghi dữ liệu."
    },
    {
      "name": "Bạn đọc",
      "description": "Danh sách, hồ sơ và dữ liệu mượn."
    },
    {
      "name": "Thống kê",
      "description": "Tổng hợp lưu thông và tài chính."
    }
  ],
  "security": [],
  "paths": {
    "/api/system/health": {
      "get": {
        "tags": [
          "Hệ thống"
        ],
        "operationId": "getSystemHealth",
        "summary": "Kiểm tra hệ thống và kết nối SQL",
        "description": "status luôn là Healthy khi action hoàn tất, kể cả khi databaseConnected=false. totalBooks lấy từ catalog; totalReaders và activeLoans từ ReaderService. Không có phản hồi 503 riêng khi SQL offline.",
        "responses": {
          "200": {
            "description": "Trạng thái và bộ đếm hiện tại.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "Healthy",
                  "time": "2026-11-10 10:00:00",
                  "databaseConnected": true,
                  "totalBooks": 30,
                  "totalReaders": 50,
                  "activeLoans": 18
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/profile": {
      "get": {
        "tags": [
          "Phiên đăng nhập"
        ],
        "operationId": "getCurrentUserProfile",
        "summary": "Xem phiên đăng nhập hiện tại",
        "description": "Không yêu cầu đăng nhập. Cookie UTC_Library_Auth_v3 được cấp qua biểu mẫu /Account/Login có anti-forgery token. Không có endpoint đăng nhập JSON/JWT. Khi chưa đăng nhập vẫn trả 200.",
        "responses": {
          "200": {
            "description": "Hai cấu trúc theo trạng thái đăng nhập.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AnonymousProfile"
                    },
                    {
                      "$ref": "#/components/schemas/AuthenticatedProfile"
                    }
                  ]
                },
                "examples": {
                  "anonymous": {
                    "value": {
                      "isAuthenticated": false,
                      "user": null
                    }
                  },
                  "authenticated": {
                    "value": {
                      "isAuthenticated": true,
                      "username": "tai-khoan-thu-nghiem",
                      "fullName": "Bạn đọc thử nghiệm",
                      "roles": [
                        "Reader"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/books": {
      "get": {
        "tags": [
          "Học liệu"
        ],
        "operationId": "getBooks",
        "summary": "Tìm kiếm và phân trang học liệu",
        "description": "Chỉ hỗ trợ keyword, page, pageSize. total là số kết quả trước phân trang. Không có kết quả trả data=[]. page<=0 tính offset như trang 1 nhưng phản hồi page gốc; pageSize<=0 cho danh sách rỗng. Chưa có giới hạn pageSize phía server. Dữ liệu từ catalog JSON/bộ nhớ.",
        "responses": {
          "200": {
            "description": "Danh sách học liệu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookList"
                },
                "example": {
                  "total": 1,
                  "page": 1,
                  "pageSize": 10,
                  "data": [
                    {
                      "id": 1,
                      "title": "Cấu trúc dữ liệu và giải thuật",
                      "author": "Bùi Việt Hà",
                      "major": "cntt",
                      "year": 2023,
                      "shelf": "Kệ IT-01",
                      "availableCopies": 3,
                      "totalCopies": 4,
                      "status": "Có sẵn"
                    }
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "Tìm trong tiêu đề, tác giả, NXB, ISBN, mô tả, tên chuyên ngành; không phân biệt hoa/thường.",
            "schema": {
              "type": "string",
              "example": "Python"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Nên gửi số >=1; server chưa validation giá trị này.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Nên gửi số >0; server chưa giới hạn kích thước trang.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ]
      }
    },
    "/api/catalog/books/{id}": {
      "get": {
        "tags": [
          "Học liệu"
        ],
        "operationId": "getBookById",
        "summary": "Lấy chi tiết học liệu",
        "description": "Trả BookItem và danh sách bản sao từ catalog. Trường tác giả trong book là authors, khác author của danh sách.",
        "responses": {
          "200": {
            "description": "Chi tiết sách và bản sao.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookDetail"
                }
              }
            }
          },
          "404": {
            "description": "Không có sách trong catalog.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Không tìm thấy sách ID: 999999"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID học liệu trong catalog. Route yêu cầu số nguyên.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 1
            }
          }
        ]
      }
    },
    "/api/catalog/books/{id}/copies": {
      "get": {
        "tags": [
          "Học liệu"
        ],
        "operationId": "getBookCopies",
        "summary": "Lấy bản sao của học liệu",
        "description": "Đọc từ catalog, không truy vấn trực tiếp bảng BanSao. ID không tồn tại vẫn trả 200 với copies=[].",
        "responses": {
          "200": {
            "description": "Danh sách bản sao, có thể rỗng.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookCopies"
                },
                "examples": {
                  "withCopies": {
                    "value": {
                      "bookId": 1,
                      "copies": [
                        {
                          "id": 11,
                          "bookId": 1,
                          "barcode": "UTC-01-01",
                          "shelf": "Kệ IT-01",
                          "condition": "Tốt",
                          "status": "Có sẵn",
                          "importDate": "15/01/2024",
                          "isAvailable": true
                        }
                      ]
                    }
                  },
                  "unknownBook": {
                    "value": {
                      "bookId": 999999,
                      "copies": []
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID học liệu trong catalog. Route yêu cầu số nguyên.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 1
            }
          }
        ]
      }
    },
    "/api/circulation/transactions": {
      "get": {
        "tags": [
          "Mượn trả"
        ],
        "operationId": "getCirculationTransactions",
        "summary": "Xem các giao dịch đang mượn",
        "description": "Chỉ giao dịch chưa trả, loại Đã trả/Đã đền sách mới/Đã đền tiền; không phải lịch sử toàn bộ. Không phân trang. SQL lỗi trả danh sách rỗng; không hợp nhất mượn fallback từ hồ sơ JSON.",
        "responses": {
          "200": {
            "description": "Danh sách giao dịch đang mượn.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionList"
                },
                "example": {
                  "total": 1,
                  "data": [
                    {
                      "maGD": "GD261110-001",
                      "maBD": "242630923",
                      "hoTen": "Bạn đọc thử nghiệm",
                      "maBanSao": "UTC-01-01",
                      "tenSach": "Cấu trúc dữ liệu và giải thuật",
                      "tacGia": "Bùi Việt Hà",
                      "coverImage": "/images/covers/sach_01.jpg",
                      "ngayMuon": "10/11/2026",
                      "hanTra": "10/11/2027",
                      "trangThai": "Còn hạn",
                      "isQuaHan": false
                    }
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "maBD",
            "in": "query",
            "required": false,
            "description": "Mã sinh viên tùy chọn; trim, so khớp không phân biệt hoa/thường.",
            "schema": {
              "type": "string",
              "example": "242630923"
            }
          }
        ]
      }
    },
    "/api/circulation/borrow": {
      "post": {
        "tags": [
          "Mượn trả"
        ],
        "operationId": "borrowBook",
        "summary": "Mượn một đầu sách (ghi dữ liệu)",
        "description": "Thao tác thực sự ghi SQL/JSON. Nhánh SQL: tối đa 5 cuốn cho sinh viên, 10 cho mã GV/CB, chặn trùng đầu sách, hạn trả một năm; tự tạo bản sao nếu hết bản sẵn có. Các lỗi khác ngoài vượt giới hạn/trùng đầu sách chuyển fallback hồ sơ JSON. Fallback chỉ kiểm tra trùng tiêu đề, chưa áp dụng quota SQL. Không có idempotency; không tự gửi lại sau timeout. API hiện chưa kiểm tra đăng nhập/vai trò hoặc anti-forgery token.",
        "responses": {
          "200": {
            "description": "Mượn thành công; maGD fallback chỉ có trong message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                },
                "examples": {
                  "sql": {
                    "value": {
                      "success": true,
                      "mode": "SQL_Server",
                      "message": "Mượn thành công 'Cấu trúc dữ liệu và giải thuật' cho 242630923"
                    }
                  },
                  "fallback": {
                    "value": {
                      "success": true,
                      "mode": "Offline_Fallback",
                      "message": "Mượn thành công 'Cấu trúc dữ liệu và giải thuật' (Mã GD: GD261110-001)"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Thiếu dữ liệu, vượt giới hạn hoặc trùng đầu sách.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidBody": {
                    "value": {
                      "message": "Vui lòng nhập maBD và bookId."
                    }
                  },
                  "duplicate": {
                    "value": {
                      "success": false,
                      "message": "Bạn đọc đã mượn đầu sách này rồi!"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "SQL không mượn được và sách không có trong catalog.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Không tìm thấy sách ID: 999999"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type không được JSON input formatter hỗ trợ."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BorrowRequest"
              }
            }
          }
        }
      }
    },
    "/api/circulation/return": {
      "post": {
        "tags": [
          "Mượn trả"
        ],
        "operationId": "returnBook",
        "summary": "Trả sách (ghi dữ liệu)",
        "description": "Bỏ trống maGD để chọn giao dịch đầu tiên từ SQL rồi hồ sơ. Nếu SQL trả thất bại, fallback tìm maGD trong hồ sơ; nếu không khớp vẫn trả cuốn đầu tiên. 200 không đảm bảo mã yêu cầu được xử lý đúng; đối chiếu message và dữ liệu sau thao tác. Không có 404 riêng cho giao dịch. API hiện chưa kiểm tra đăng nhập/vai trò hoặc anti-forgery token.",
        "responses": {
          "200": {
            "description": "Đã xử lý trả sách theo nhánh SQL hoặc fallback.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                },
                "examples": {
                  "sql": {
                    "value": {
                      "success": true,
                      "mode": "SQL_Server",
                      "message": "Đã nhận trả thành công sách 'Cấu trúc dữ liệu và giải thuật'"
                    }
                  },
                  "fallback": {
                    "value": {
                      "success": true,
                      "mode": "Offline_Fallback",
                      "message": "Đã nhận trả thành công sách 'Cấu trúc dữ liệu và giải thuật' (Mã GD: GD261110-001)"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Thiếu maBD hoặc không có sách để trả sau khi SQL thất bại.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidBody": {
                    "value": {
                      "message": "Vui lòng nhập maBD."
                    }
                  },
                  "noActiveLoans": {
                    "value": {
                      "success": false,
                      "message": "Bạn đọc '242630923' hiện không có cuốn sách nào đang mượn để trả."
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Content-Type không được JSON input formatter hỗ trợ."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReturnRequest"
              }
            }
          }
        }
      }
    },
    "/api/readers": {
      "get": {
        "tags": [
          "Bạn đọc"
        ],
        "operationId": "getReaders",
        "summary": "Tìm danh sách bạn đọc",
        "description": "Không phân trang. SQL lỗi trả total=0, data=[]. Service hiện phân nhóm theo mã thành Sinh viên hoặc Giảng viên; Ngoài trường chỉ là lựa chọn trên model.",
        "responses": {
          "200": {
            "description": "Danh sách bạn đọc sau lọc.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderList"
                },
                "example": {
                  "total": 1,
                  "data": [
                    {
                      "maBD": "242630923",
                      "hoTen": "Bạn đọc thử nghiệm",
                      "nhom": "Sinh viên",
                      "lopKhoa": "K65.CLCCNTT1",
                      "quyenSuDung": "Hoạt động",
                      "soSachDangMuon": 1,
                      "soSachQuaHan": 0
                    }
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "Tìm mã, họ tên, lớp/khoa; hỗ trợ không dấu cho họ tên và lớp/khoa.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "description": "Sinh viên hoặc Giảng viên; bỏ trống/Tất cả nhóm để không lọc. So khớp không phân biệt hoa/thường.",
            "schema": {
              "type": "string",
              "example": "Sinh viên"
            }
          }
        ]
      }
    },
    "/api/readers/{id}": {
      "get": {
        "tags": [
          "Bạn đọc"
        ],
        "operationId": "getReaderDetail",
        "summary": "Lấy chi tiết bạn đọc",
        "description": "Ưu tiên mã sinh viên; thử MaBanDoc nếu ID là số, không tìm trực tiếp SoThe. Nhánh tra cứu khóa số truy vấn SQL ngoài try/catch, có thể lỗi 500 khi SQL offline trước khi fallback. GetProfile có thể tạo hồ sơ mặc định cho mã chưa biết: 200 fallback không xác nhận có bạn đọc trong SQL. Schema data và borrowTransactions khác nhau theo mode.",
        "responses": {
          "200": {
            "description": "Chi tiết SQL hoặc hồ sơ fallback.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SqlReaderResponse"
                    },
                    {
                      "$ref": "#/components/schemas/OfflineReaderResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "ID chỉ chứa khoảng trắng.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Vui lòng nhập ID bạn đọc."
                }
              }
            }
          },
          "404": {
            "description": "Không lấy được hồ sơ có họ tên.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Không tìm thấy bạn đọc 'unknown'"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi SQL chưa được xử lý trong nhánh tra cứu khóa số; nội dung tùy môi trường, không đảm bảo JSON."
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Mã sinh viên (ưu tiên) hoặc khóa số MaBanDoc.",
            "schema": {
              "type": "string",
              "example": "242630923"
            }
          }
        ]
      }
    },
    "/api/dashboard/stats": {
      "get": {
        "tags": [
          "Thống kê"
        ],
        "operationId": "getDashboardStats",
        "summary": "Lấy thống kê tổng hợp",
        "description": "Trả trực tiếp DashboardViewModel. SQL đếm lỗi giữ mặc định 30 đầu sách, 120 bản sao, 49 bạn đọc; không phải số liệu thực được xác nhận. matChoBoiThuong hiện là 0. recentTransactions tối đa 8 giao dịch từ danh sách đang mượn. Tiền tính bằng VND.",
        "responses": {
          "200": {
            "description": "Thống kê học liệu, lưu thông và tài chính.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "success": {
            "type": "boolean",
            "description": "Chỉ xuất hiện ở một số lỗi nghiệp vụ.",
            "example": false
          }
        },
        "required": [
          "message"
        ]
      },
      "ActionResult": {
        "type": "object",
        "properties": {
