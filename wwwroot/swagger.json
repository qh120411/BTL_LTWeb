    "/api/dashboard/stats": {
      "get": {
        "tags": [
          "Thống kê"
        ],
        "operationId": "getDashboardStats",
        "summary": "Lấy thống kê tổng hợp",
        "description": "Trả trực tiếp DashboardViewModel. SQL đếm lỗi giữ mặc định 30 đầu sách, 120 bản sao, 49 bạn đọc; không phải số liệu thực được xác nhận. matChoBoiThuong hiện là 0. recentTransactions tối đa 8 giao dịch từ danh sách đang mượn. Tiền tính bằng VND.",
        "responses": {
          "200": {
            "description": "Thống kê học liệu, lưu thông và tài chính.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardViewModel"
                }
              }
            }
          },
          "401": {
            "description": "Cần đăng nhập tài khoản cán bộ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Không đủ quyền cán bộ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "staffCookie": []
          }
        ]
      }
    }
