@{
    ViewData["Title"] = "Dịch vụ bạn đọc";
}

@section Styles {
    <link rel="stylesheet" href="~/css/reader-services.css" asp-append-version="true" />
}

<div class="utc-services-page">
    <div class="utc-services-container utc-reader-container">
        <nav class="utc-services-breadcrumb" aria-label="Đường dẫn">
            <a href="/Reader/Home">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Dịch vụ</span>
        </nav>

        <header class="utc-services-header">
            <h1>Dịch vụ bạn đọc</h1>
            <p>Thông tin cần thiết cho mỗi lần đến thư viện.</p>
        </header>

        <nav class="utc-services-nav" aria-label="Các mục dịch vụ">
            <a href="#muon-tra">Mượn &amp; trả sách</a>
            <a href="#phong-doc">Đọc tại chỗ</a>
            <a href="#gio-phuc-vu">Giờ phục vụ</a>
            <a href="#lien-he">Liên hệ</a>
        </nav>

        <section class="utc-service-section" id="muon-tra" aria-labelledby="borrowingTitle">
            <div class="utc-service-section-heading">
                <h2 id="borrowingTitle">Mượn &amp; trả sách</h2>
                <a href="/Reader/Search" class="utc-service-text-link">Tra cứu học liệu</a>
            </div>
            <div class="utc-service-borrowing-grid">
                <ol class="utc-service-steps">
                    <li>
                        <h3>Tìm tài liệu</h3>
                        <p>Tra cứu tên sách, ghi lại mã sách và vị trí kệ.</p>
                    </li>
                    <li>
                        <h3>Làm thủ tục mượn</h3>
                        <p>Mang sách và thẻ sinh viên hoặc thẻ bạn đọc đến quầy tầng 5, Nhà A8.</p>
                    </li>
                    <li>
                        <h3>Theo dõi và trả sách</h3>
                        <p>Xem hạn trả trong <a href="/Reader/Profile">hồ sơ bạn đọc</a>. Hoàn trả sách tại quầy trước ngày đến hạn.</p>
                    </li>
                </ol>
                <aside class="utc-service-borrowing-note" aria-labelledby="borrowingRulesTitle">
                    <h3 id="borrowingRulesTitle">Điều cần nhớ</h3>
                    <dl class="utc-service-facts">
                        <div><dt>Kỳ 1</dt><dd>11/08–31/12</dd></div>
                        <div><dt>Kỳ 2</dt><dd>02/01–31/05</dd></div>
                        <div><dt>Hạn mức sinh viên</dt><dd>5 cuốn</dd></div>
                        <div><dt>Hạn mức giảng viên</dt><dd>10 cuốn</dd></div>
                    </dl>
                    <p>Mỗi bạn đọc mượn tối đa 1 bản cho mỗi đầu sách.</p>
                </aside>
            </div>
            <div class="utc-service-extra-rules">
                <details>
                    <summary>Trả sách quá hạn</summary>
                    <p>Mức phạt là <strong>100.000 đ/cuốn</strong>. Mang sách đến quầy tầng 5, Nhà A8 để hoàn trả và thanh toán.</p>
                </details>
                <details>
                    <summary>Sách bị mất hoặc hư hỏng</summary>
                    <p>Liên hệ thủ thư để thống nhất hình thức bồi thường: bổ sung sách mới đúng tên, phiên bản hoặc đền tiền theo biên bản. Nếu sách đã quá hạn, cần thanh toán thêm khoản phạt nộp muộn.</p>
                </details>
            </div>
        </section>

        <section class="utc-service-section" id="phong-doc" aria-labelledby="readingTitle">
            <div class="utc-service-section-heading">
                <h2 id="readingTitle">Đọc tại chỗ</h2>
                <span class="utc-service-location">Tầng 6 · Nhà A8</span>
            </div>
            <p>Không gian dành cho đọc sách, tự học và nghiên cứu. Bạn có thể tra cứu trước tài liệu hoặc nhờ thủ thư hỗ trợ tìm sách.</p>
            <a href="#gio-phuc-vu" class="utc-service-text-link">Xem giờ mở cửa phòng đọc</a>
        </section>

        <section class="utc-service-section" id="gio-phuc-vu" aria-labelledby="openingTitle">
            <div class="utc-service-section-heading">
                <h2 id="openingTitle">Giờ phục vụ</h2>
            </div>
            <dl class="utc-service-hours">
                <div>
                    <dt>Quầy mượn trả <span>Thứ Hai – Thứ Sáu</span></dt>
                    <dd>07:30 – 11:30<br />13:30 – 17:00</dd>
                </div>
                <div>
                    <dt>Quầy mượn trả <span>Thứ Bảy</span></dt>
                    <dd>07:30 – 11:30</dd>
                </div>
                <div>
                    <dt>Phòng đọc &amp; tự học <span>Thứ Hai – Chủ Nhật</span></dt>
                    <dd>07:30 – 21:00</dd>
                </div>
            </dl>
            <p class="utc-service-holiday-note">Ngày lễ, Tết áp dụng lịch nghỉ của nhà trường.</p>
        </section>

        <section class="utc-service-section" id="lien-he" aria-labelledby="contactTitle">
            <div class="utc-service-section-heading">
                <h2 id="contactTitle">Liên hệ &amp; hỗ trợ</h2>
            </div>
            <p>Để được hỗ trợ tra cứu, tài khoản hoặc mượn trả, liên hệ thủ thư tại quầy tầng 5, Nhà A8.</p>
            <div class="utc-service-contact-links">
                <a href="tel:02437669860">024 3766 9860</a>
                <a href="mailto:thuvien@utc.edu.vn">thuvien@utc.edu.vn</a>
            </div>
        </section>
    </div>
</div>
