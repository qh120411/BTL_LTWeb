@{
    ViewData["Title"] = "Tin tức & Hoạt động";
}

<section class="py-5" style="background-color: var(--utc-paper);">
    <div class="container">
        <div class="utc-breadcrumb">CỔNG BẠN ĐỌC / TIN TỨC &amp; HOẠT ĐỘNG</div>
        <h1 class="utc-page-title-main">Tin tức &amp; Hoạt động Thư viện UTC</h1>
        <p class="utc-page-subtitle-main">
            Cập nhật các sự kiện văn hóa đọc, thông báo lịch phục vụ, học liệu mới và các hoạt động học thuật tại UTC.
        </p>

        <div class="row g-4 mt-2">
            <!-- Tin 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-utc rounded-utc overflow-hidden shadow-sm">
                    <img src="~/images/featured-article.png" class="card-img-top" alt="Tin tức 1" style="height: 220px; object-fit: cover;" />
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge-borrowed mb-2" style="width: fit-content;">SỰ KIỆN NỔI BẬT</span>
                        <h4 class="card-title text-navy fw-bold fs-5 mb-2">Thư viện UTC: Không gian học tập, kết nối và khám phá tri thức</h4>
                        <p class="card-text text-muted small flex-grow-1">Khám phá nguồn học liệu và các dịch vụ hỗ trợ học tập, nghiên cứu dành cho sinh viên, giảng viên và bạn đọc toàn trường.</p>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top text-muted small mt-2">
                            <span><i class="bi bi-calendar3 me-1"></i> 24/10/2026</span>
                            <a href="#" class="text-brand fw-medium">Chi tiết &rarr;</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tin 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-utc rounded-utc overflow-hidden shadow-sm">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <span class="badge-available mb-2" style="width: fit-content;">HỌC LIỆU MỚI</span>
                            <h4 class="card-title text-navy fw-bold fs-5 mb-2">Bổ sung hơn 200 đầu sách giáo trình chuyên ngành Công nghệ thông tin &amp; AI</h4>
                            <p class="card-text text-muted small">Thư viện trường vừa tiếp nhận và đưa vào phục vụ hàng loạt đầu sách chuyên sâu về Khoa học dữ liệu, Lập trình Python, Mạng máy tính và Điện toán đám mây.</p>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top text-muted small mt-4">
                            <span><i class="bi bi-calendar3 me-1"></i> 20/10/2026</span>
                            <a href="#" class="text-brand fw-medium">Chi tiết &rarr;</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tin 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-utc rounded-utc overflow-hidden shadow-sm">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <span class="badge-overdue mb-2" style="width: fit-content;">THÔNG BÁO</span>
                            <h4 class="card-title text-navy fw-bold fs-5 mb-2">Thông báo lịch phục vụ phòng đọc và mượn sách dịp đầu năm học 2026</h4>
                            <p class="card-text text-muted small">Thông báo tới toàn thể bạn đọc về khung giờ mở cửa các phòng đọc tự học, quầy thủ thư và dịch vụ tra cứu trực tuyến.</p>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top text-muted small mt-4">
                            <span><i class="bi bi-calendar3 me-1"></i> 15/10/2026</span>
                            <a href="#" class="text-brand fw-medium">Chi tiết &rarr;</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
