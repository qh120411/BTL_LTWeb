@{
    ViewData["Title"] = "Tin tức & Hoạt động";
}

<section class="py-4 py-md-5" style="background-color: var(--utc-bg-page, #f4f8fc); min-height: calc(100vh - 200px);">
    <div class="container-xl px-3 px-md-4">
        <!-- Breadcrumb -->
        <nav class="utc-breadcrumb mb-2" aria-label="breadcrumb">
            <a href="/Reader/Home" class="text-decoration-none" style="color: var(--utc-primary);">Trang chủ</a>
            <span style="color: var(--utc-border);">&bull;</span>
            <span style="color: var(--utc-text-muted);">Cổng bạn đọc</span>
            <span style="color: var(--utc-border);">&bull;</span>
            <span style="color: var(--utc-text-primary); font-weight: 700;">Tin tức &amp; Hoạt động</span>
        </nav>

        <h1 class="utc-page-title-main">Tin tức &amp; Hoạt động Thư viện UTC</h1>
        <p class="utc-page-subtitle-main">
            Cập nhật các sự kiện văn hóa đọc, thông báo lịch phục vụ, học liệu mới và các hoạt động học thuật tại UTC.
        </p>

        <div class="row g-4 mt-1">
            <!-- Tin 1: Nổi bật -->
            <div class="col-md-6 col-lg-4">
                <div class="utc-card h-100 p-0 overflow-hidden d-flex flex-column">
                    <div style="height: 200px; width: 100%; overflow: hidden; background-color: var(--utc-primary-light);">
                        <img src="~/images/featured-article.png" alt="Không gian học tập" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" class="card-img-hover" />
                    </div>
                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <div class="mb-2">
                            <span class="utc-badge utc-badge-info">SỰ KIỆN NỔI BẬT</span>
                        </div>
                        <h4 class="utc-card-title mb-2" style="font-size: 16px; line-height: 1.4;">
                            Thư viện UTC: Không gian học tập, kết nối và khám phá tri thức
                        </h4>
                        <p class="text-secondary small flex-grow-1 mb-3">
                            Khám phá nguồn học liệu phong phú và các dịch vụ hỗ trợ học tập, nghiên cứu khoa học dành cho sinh viên, giảng viên và bạn đọc toàn trường.
                        </p>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top text-muted small" style="border-color: var(--utc-border) !important;">
                            <span><i class="bi bi-calendar3 me-1"></i> 24/10/2026</span>
                            <span class="fw-semibold" style="color: var(--utc-primary);">Xem chi tiết &rarr;</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tin 2: Học liệu mới -->
            <div class="col-md-6 col-lg-4">
                <div class="utc-card h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="mb-2">
                            <span class="utc-badge utc-badge-success">HỌC LIỆU MỚI</span>
                        </div>
                        <h4 class="utc-card-title mb-2" style="font-size: 16px; line-height: 1.4;">
                            Bổ sung hơn 200 đầu sách giáo trình chuyên ngành Công nghệ thông tin &amp; AI
                        </h4>
                        <p class="text-secondary small mb-3">
                            Thư viện trường vừa tiếp nhận và đưa vào phục vụ hàng loạt đầu sách chuyên sâu về Khoa học dữ liệu, Lập trình Python, Mạng máy tính và Điện toán đám mây.
                        </p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top text-muted small mt-3" style="border-color: var(--utc-border) !important;">
                        <span><i class="bi bi-calendar3 me-1"></i> 20/10/2026</span>
                        <a href="/Reader/Search?category=books&major=cntt" class="fw-semibold text-decoration-none" style="color: var(--utc-primary);">Tra cứu ngay &rarr;</a>
                    </div>
                </div>
            </div>

            <!-- Tin 3: Thông báo -->
            <div class="col-md-6 col-lg-4">
                <div class="utc-card h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="mb-2">
                            <span class="utc-badge utc-badge-warning">THÔNG BÁO QUAN TRỌNG</span>
                        </div>
                        <h4 class="utc-card-title mb-2" style="font-size: 16px; line-height: 1.4;">
                            Thông báo lịch phục vụ phòng đọc và mượn sách dịp đầu năm học 2026
                        </h4>
                        <p class="text-secondary small mb-3">
                            Thông báo tới toàn thể bạn đọc về khung giờ mở cửa các phòng đọc tự học tầng 6, quầy thủ thư tầng 5 Nhà A8 và các dịch vụ tra cứu trực tuyến.
                        </p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top text-muted small mt-3" style="border-color: var(--utc-border) !important;">
                        <span><i class="bi bi-calendar3 me-1"></i> 15/10/2026</span>
                        <a href="/Reader/Guide" class="fw-semibold text-decoration-none" style="color: var(--utc-primary);">Xem giờ phục vụ &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
