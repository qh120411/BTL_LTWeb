@model dynamic

@{
    string? rawCover = Model?.CoverImage != null ? (string)Model.CoverImage : (Model?.AnhBia != null ? (string)Model.AnhBia : null);
    string? coverImg = null;
    if (!string.IsNullOrWhiteSpace(rawCover))
    {
        var clean = rawCover.Trim().TrimStart('~');
        coverImg = clean.StartsWith("/") ? clean : "/" + clean;
    }
}

<a href="/Reader/Document/Details/@(Model?.Id ?? 1)" class="utc-catalog-book-card">
    @if (!string.IsNullOrEmpty(coverImg))
    {
        <div class="utc-book-cover-wrap">
            <img src="@coverImg" alt="@(Model?.Title ?? "Học liệu")" class="utc-book-cover-img" onerror="this.src='/images/covers/sach_01.jpg'" />
        </div>
    }
    else
    {
        <div class="utc-typographic-cover" style="background-color: @(Model?.CoverBg ?? "#e7f6ff");">
            <span class="utc-cover-tag">UTC / HỌC LIỆU</span>
            <div class="utc-cover-title">
                @(Model?.CoverTitle ?? "Học liệu\nUTC")
            </div>
            <span class="utc-cover-sub">Giáo trình đại học</span>
        </div>
    }
    <span class="utc-book-category">@(Model?.Category ?? "CÔNG NGHỆ THÔNG TIN")</span>
    <div class="utc-book-card-name">@(Model?.Title ?? "Tên học liệu")</div>
    <span class="utc-book-meta-badge">
        <i class="bi bi-check2-circle me-1"></i> @(Model?.StockText ?? "Có sẵn tại thư viện")
    </span>
</a>
