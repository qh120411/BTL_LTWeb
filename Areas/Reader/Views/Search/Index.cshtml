@model BTL_LTWEB.Areas.Reader.Models.BookSearchViewModel

@{
    ViewData["Title"] = "Tra cứu học liệu OPAC";
    var keyword = Model.Keyword ?? "";
    var category = Model.Category ?? "all";
    var major = Model.Major ?? "all";
    var language = Model.Language ?? "all";
    var availability = Model.Availability ?? "all";

    bool hasActiveFilter = !string.IsNullOrEmpty(keyword) 
                           || category != "all" 
                           || major != "all" 
                           || language != "all" 
                           || availability != "all";
}

@section Styles {
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
}

<section class="utc-search-page-section">
    <div class="container">
        <!-- Breadcrumb -->
        <div class="utc-breadcrumb">CỔNG BẠN ĐỌC / TRA CỨU OPAC</div>
        <h1 class="utc-page-title-main">
            @if (category == "thesis")
            {
                <span>Luận văn, Luận án &amp; Công trình nghiên cứu</span>
            }
            else if (category == "books")
            {
                <span>Sách &amp; Giáo trình Đại học UTC</span>
            }
            else
            {
                <span>Tra cứu học liệu trực tuyến (OPAC)</span>
            }
        </h1>
        <p class="utc-page-subtitle-main">
            Hệ thống tra cứu mục lục trực tuyến OPAC dành cho sinh viên, giảng viên trường Đại học GTVT.
        </p>

        <!-- Search Bar -->
        <form action="/Reader/Search" method="get" class="utc-search-box-large">
            <input type="hidden" name="category" value="@category" />
            <input type="hidden" name="major" value="@major" />
            <input type="hidden" name="language" value="@language" />
            <input type="hidden" name="availability" value="@availability" />

            <div class="utc-search-box-field">
                <label class="utc-field-label">Từ khóa tìm kiếm (nhan đề, tác giả, chuyên ngành, mã ISBN)</label>
                <input type="text" 
                       name="keyword" 
                       id="opacSearchInput"
                       class="utc-field-input" 
                       value="@keyword" 
                       placeholder="Nhập từ khóa tìm kiếm (Ví dụ: Python, Cấu trúc dữ liệu, Giải tích, Cầu đường, Triết học...)" />
            </div>
            <button type="submit" class="btn-utc-primary" style="padding: 13px 28px;">
                <i class="bi bi-search me-1"></i> Tra cứu OPAC
            </button>
            @if (!string.IsNullOrEmpty(keyword))
            {
                <a href="/Reader/Search?category=@category&major=@major&language=@language&availability=@availability" 
                   class="btn btn-outline-secondary" style="padding: 13px 20px; border-radius: var(--utc-radius-sm);">
                    <i class="bi bi-x-lg me-1"></i> Xóa từ khóa
                </a>
            }
        </form>

        <!-- 2-Column Catalog Layout -->
        <div class="utc-catalog-layout">
            <!-- Sidebar: Bộ lọc kết quả -->
            <aside class="utc-filter-sidebar">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="utc-filter-title mb-0">Lọc kết quả</h3>
                    @if (hasActiveFilter)
                    {
                        <a href="/Reader/Search" class="small text-danger text-decoration-none">
                            <i class="bi bi-arrow-counterclockwise"></i> Đặt lại
                        </a>
                    }
                </div>

                <form action="/Reader/Search" method="get" id="filterForm">
                    <input type="hidden" name="keyword" value="@keyword" />

                    <!-- Filter 1: Loại tài liệu -->
                    <div class="utc-filter-group mb-3">
                        <label class="utc-field-label">Loại tài liệu</label>
                        <select name="category" class="utc-filter-select" onchange="document.getElementById('filterForm').submit()">
                            <option value="all" selected="@(category == "all" ? "selected" : null)">Tất cả học liệu</option>
                            <option value="books" selected="@(category == "books" ? "selected" : null)">Sách &amp; giáo trình</option>
                            <option value="thesis" selected="@(category == "thesis" ? "selected" : null)">Luận văn, luận án</option>
                            <option value="journal" selected="@(category == "journal" ? "selected" : null)">Báo &amp; tạp chí</option>
                        </select>
                    </div>

                    <!-- Filter 2: Chuyên ngành đào tạo -->
                    <div class="utc-filter-group mb-3">
                        <label class="utc-field-label">Chuyên ngành đào tạo</label>
                        <select name="major" class="utc-filter-select" onchange="document.getElementById('filterForm').submit()">
                            <option value="all" selected="@(major == "all" ? "selected" : null)">Tất cả chuyên ngành</option>
                            <option value="cntt" selected="@(major == "cntt" ? "selected" : null)">Công nghệ thông tin</option>
                            <option value="toanly" selected="@(major == "toanly" ? "selected" : null)">Khoa học cơ bản &amp; Toán lý</option>
                            <option value="xaydung" selected="@(major == "xaydung" ? "selected" : null)">Kỹ thuật công trình &amp; Giao thông</option>
                            <option value="kinhte" selected="@(major == "kinhte" ? "selected" : null)">Kinh tế vận tải &amp; Logistics</option>
                            <option value="chinhtri" selected="@(major == "chinhtri" ? "selected" : null)">Lý luận chính trị &amp; Pháp luật</option>
                        </select>
                    </div>

                    <!-- Filter 3: Ngôn ngữ xuất bản -->
                    <div class="utc-filter-group mb-3">
                        <label class="utc-field-label">Ngôn ngữ xuất bản</label>
                        <select name="language" class="utc-filter-select" onchange="document.getElementById('filterForm').submit()">
                            <option value="all" selected="@(language == "all" ? "selected" : null)">Tất cả ngôn ngữ</option>
                            <option value="vie" selected="@(language == "vie" ? "selected" : null)">Tiếng Việt</option>
                            <option value="eng" selected="@(language == "eng" ? "selected" : null)">Tiếng Anh</option>
                        </select>
                    </div>

                    <!-- Filter 4: Tình trạng lưu thông -->
                    <div class="utc-filter-group mb-3">
                        <label class="utc-field-label">Tình trạng lưu thông</label>
                        <select name="availability" class="utc-filter-select" onchange="document.getElementById('filterForm').submit()">
                            <option value="all" selected="@(availability == "all" ? "selected" : null)">Tất cả tình trạng</option>
                            <option value="available" selected="@(availability == "available" ? "selected" : null)">Có bản sẵn tại thư viện</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-utc-primary w-100 mb-2">
                        <i class="bi bi-funnel me-1"></i> Áp dụng bộ lọc
                    </button>

                    @if (hasActiveFilter)
                    {
                        <a href="/Reader/Search" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-circle me-1"></i> Xóa tất cả bộ lọc
                        </a>
                    }
                </form>

                <p class="utc-filter-note mt-3">
                    <i class="bi bi-info-circle me-1"></i> Tra cứu mở công khai. Đăng nhập để sử dụng tính năng mượn về và gia hạn.
                </p>
            </aside>

            <!-- Results List -->
            <div class="utc-catalog-results">
                <div class="utc-catalog-results-header">
                    <div class="utc-results-count">
                        Tìm thấy <span class="text-primary fw-bold">@Model.TotalCount</span> học liệu phù hợp
                    </div>
                    <div class="text-muted small">
                        Dữ liệu kho thư viện UTC
                    </div>
                </div>

                @if (!Model.Items.Any())
                {
                    <div class="card p-5 text-center border-0 shadow-sm" style="background-color: var(--utc-paper); border-radius: var(--utc-radius-md);">
                        <div class="mb-3">
                            <i class="bi bi-search text-muted" style="font-size: 48px;"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">Không tìm thấy tài liệu phù hợp</h4>
                        <p class="text-muted mb-4">
                            Không có kết quả nào khớp với các tiêu chí tìm kiếm hoặc bộ lọc hiện tại của bạn.
                        </p>
                        <div>
                            <a href="/Reader/Search" class="btn btn-utc-primary">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại tất cả bộ lọc
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="utc-catalog-cards-grid">
                        @foreach (var book in Model.Items)
                        {
                            <a href="/Reader/Document/Details/@book.Id" class="utc-catalog-book-card">
                                @if (!string.IsNullOrEmpty(book.CoverImage))
                                {
                                    <div class="utc-book-cover-wrap">
                                        <img src="~/@book.CoverImage" alt="@book.Title" class="utc-book-cover-img" />
                                    </div>
                                }
                                else
                                {
                                    <div class="utc-typographic-cover" style="background-color: @(book.Category == "thesis" ? "#fef3c7" : "#e0f2fe");">
                                        <span class="utc-cover-tag" style="color: @(book.Category == "thesis" ? "#92400e" : "var(--utc-navy)");">
                                            UTC / @(book.Category == "thesis" ? "CÔNG TRÌNH NGHIÊN CỨU" : "HỌC LIỆU")
                                        </span>
                                        <div class="utc-cover-title" style="color: @(book.Category == "thesis" ? "#78350f" : "var(--utc-navy)"); font-size: 20px;">
                                            @book.Title
                                        </div>
                                        <span class="utc-cover-sub" style="color: @(book.Category == "thesis" ? "#92400e" : "var(--utc-muted)");">
                                            @book.Authors · @book.Year
                                        </span>
                                    </div>
                                }
                                <span class="utc-book-category">@book.MajorName.ToUpper()</span>
                                <div class="utc-book-card-name" title="@book.Title">@book.Title</div>
                                <div class="text-muted small text-truncate">
                                    <i class="bi bi-person me-1"></i>@book.Authors
                                </div>
                                <span class="utc-book-meta-badge" style="@(book.IsOnline ? "background-color: #fef3c7; color: #92400e;" : "")">
                                    <i class="bi @(book.IsOnline ? "bi-file-earmark-pdf-fill" : "bi-check2-circle") me-1"></i>
                                    @book.StockBadgeText
                                </span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>
