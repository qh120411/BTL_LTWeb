@model List<BTL_LTWEB.Areas.Reader.Models.BookItem>
@{ViewData["Title"]="Trang chủ";}
<section class="home-search" aria-label="Tra cứu học liệu">
<div class="search-wrap">
<form action="/Reader/Search" method="get">
<div class="search-tabs" role="tablist" aria-label="Loại tài liệu">
<button type="button" role="tab" aria-selected="true" data-category="all">Tất cả học liệu</button>
<button type="button" role="tab" aria-selected="false" data-category="books">Sách & giáo trình</button>
<button type="button" role="tab" aria-selected="false" data-category="thesis">Luận văn, luận án</button>
</div>
<input name="category" id="home-category" type="hidden" value="all">
<div class="search-form">
<label class="sr-only" for="home-query">Tên sách, tác giả hoặc chủ đề</label>
<input id="home-query" name="keyword" type="search" placeholder="Nhập tên sách, tác giả hoặc chủ đề…">
<button class="button primary">Tìm học liệu →</button>
</div>
</form>
<div class="search-meta">
<span>Tra cứu và xem thông tin học liệu không cần đăng nhập.</span>
<a href="/Reader/Search">Tìm kiếm nâng cao →</a>
</div>
</div>
</section>
<nav class="home-shortcuts" aria-label="Tiện ích bạn đọc">
<a href="/Reader/MyLibrary">
<span class="shortcut-icon">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
<circle cx="12" cy="7" r="3"/>
<path d="M6 21v-4a6 6 0 0 1 12 0v4"/>
</svg>
</span>
<span>
<strong>Thư viện của tôi</strong>
<small>Đăng nhập để theo dõi mượn trả</small>
</span>
</a>
<a href="/Reader/Guide#muon-tra">
<span class="shortcut-icon">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
<path d="M3 4h6l3 3 3-3h6v15h-6l-3 2-3-2H3V4zm9 3v14"/>
</svg>
</span>
<span>
<strong>Hướng dẫn mượn trả</strong>
<small>Điều kiện mượn và cách trả sách</small>
</span>
</a>
<a href="/Reader/Guide#gio-mo-cua">
<span class="shortcut-icon">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
<circle cx="12" cy="12" r="9"/>
<path d="M12 6v6l4 2"/>
</svg>
</span>
<span>
<strong>Giờ phục vụ</strong>
<small>Lịch mở cửa các phòng</small>
</span>
</a>
<a href="/Reader/Guide#lien-he">
<span class="shortcut-icon">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
<path d="M3 3h13v10H9l-4 4v-4H3V3zm13 5h5v13l-4-4h-5v-4"/>
</svg>
</span>
<span>
<strong>Hỗ trợ bạn đọc</strong>
<small>Liên hệ cán bộ thư viện</small>
</span>
</a>
</nav>
<section class="home-editorial">
<aside class="home-recommended">
<h2>Học liệu đáng chú ý</h2>
@foreach(var b in Model.Take(3)){<a class="recommended-item" href="/Reader/Document/Details/@b.Id">
<p class="eyebrow">@b.MajorName</p>
<h3>@b.Title</h3>
<p>@b.Authors</p>
</a>}</aside>
<article class="home-feature">
<p class="home-kicker">THƯ VIỆN & BẠN ĐỌC</p>
<img src="/utc/assets/images/reading-room.png" alt="Sinh viên học tập tại thư viện UTC" width="900" height="450">
<h1>Thư viện UTC: Không gian học tập, kết nối và khám phá tri thức</h1>
<p>Không gian học tập, học liệu và các dịch vụ hỗ trợ học tập, nghiên cứu dành cho sinh viên, giảng viên và bạn đọc.</p>
</article>
<aside class="home-announcements">
<h2>Thông báo</h2>
<a class="home-announcement" href="/Reader/Guide#gio-mo-cua">
<span class="eyebrow">GIỜ VÀ PHÒNG ĐỌC</span>
<h3>Giờ phục vụ phòng đọc tầng 6 →</h3>
</a>
<a class="home-announcement" href="/Reader/Search">
<span class="eyebrow">HỌC LIỆU MỚI</span>
<h3>Giới thiệu học liệu mới trong học kỳ →</h3>
</a>
<a class="home-announcement" href="/Reader/News">
<span class="eyebrow">KẾT NỐI THƯ VIỆN</span>
<h3>Lắng nghe ý kiến của bạn đọc →</h3>
</a>
<div class="home-quick">
<h2>Tra cứu nhanh</h2>
<a href="/Reader/Search">Danh mục tài liệu →</a>
<a href="/Reader/Guide#muon-tra">Hướng dẫn mượn trả →</a>
<a href="/Reader/Guide#noi-quy">Nội quy thư viện →</a>
<a href="/Reader/Guide#lien-he">Liên hệ thư viện →</a>
</div>
</aside>
</section>
<section class="home-resources home-band">
<h2>NGUỒN HỌC LIỆU</h2>
<div class="home-resource-grid">
<a href="/Reader/Search?category=books">
<h3>Sách & giáo trình</h3>
<p>Tra cứu sách theo tên, tác giả, chủ đề →</p>
</a>
<a href="/Reader/Search?category=thesis">
<h3>Luận văn, luận án</h3>
<p>Khám phá công trình học thuật tại UTC →</p>
</a>
<a href="/Reader/Search">
<h3>Đề tài nghiên cứu</h3>
<p>Tìm tài liệu theo lĩnh vực nghiên cứu →</p>
</a>
<a href="/Reader/Search?category=journal">
<h3>Báo & tạp chí</h3>
<p>Đọc và tìm hiểu thông tin chuyên ngành →</p>
</a>
</div>
</section>
<section class="home-books home-band">
<div class="home-section-heading">
<h2>SÁCH & GIÁO TRÌNH</h2>
<a class="button" href="/Reader/Search?category=books">Xem tất cả →</a>
</div>
<div class="home-book-grid">
@foreach(var b in Model){<a class="home-book" href="/Reader/Document/Details/@b.Id">
<p class="eyebrow">@b.MajorName</p>
<h3>@b.Title</h3>
<p>@b.Authors</p>
</a>}</div>
@if(Model.Count==0){<p>Thư viện chưa cập nhật danh mục học liệu.</p>}</section>
<section class="home-services home-band">
<h2>DỊCH VỤ BẠN ĐỌC</h2>
<div class="home-service-grid">
<a href="/Reader/Guide#gio-mo-cua">
<span class="eyebrow">TẠI THƯ VIỆN</span>
<h3>Đọc tại chỗ</h3>
<p>Tìm chỗ ngồi và giờ mở cửa →</p>
</a>
<a href="/Reader/Guide#muon-tra">
<span class="eyebrow">MƯỢN TÀI LIỆU</span>
<h3>Mượn về nhà</h3>
<p>Quy định và thủ tục mượn trả →</p>
</a>
<a href="/Reader/Guide#lien-he">
<span class="eyebrow">CẦN TRỢ GIÚP</span>
<h3>Hỗ trợ tra cứu</h3>
<p>Kết nối với cán bộ thư viện →</p>
</a>
</div>
</section>
