@model BTL_LTWEB.Areas.Reader.Models.BookItem

@{
    ViewData["Title"] = Model?.Title ?? "Chi tiết học liệu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/book-detail.css" asp-append-version="true" />
}

<section class="utc-detail-section">
    <div class="container">
        <!-- Breadcrumb & Tiêu đề -->
        <div class="utc-detail-header-row">
            <div class="utc-breadcrumb">
                <a href="/Reader/Search" class="text-muted text-decoration-none">CỔNG BẠN ĐỌC</a> / 
                <a href="/Reader/Search" class="text-muted text-decoration-none">TRA CỨU OPAC</a> / 
                <span>CHI TIẾT HỌC LIỆU</span>
            </div>
            <h1 class="utc-page-title-main">@(Model?.Title ?? "Chi tiết học liệu")</h1>
            <div class="text-muted fs-6">
                <i class="bi bi-person-fill me-1"></i> Tác giả: <strong>@(Model?.Authors ?? "Nhiều tác giả")</strong> &middot; 
                <i class="bi bi-building me-1 ms-2"></i> Nhà xuất bản: <strong>@(Model?.Publisher ?? "Đang cập nhật")</strong> &middot; 
                Năm xuất bản: <strong>@(Model?.Year ?? 2024)</strong>
            </div>
        </div>

        <!-- Layout 2 cột: Bìa sách + Thông tin chi tiết -->
        <div class="utc-detail-main-layout">
            <!-- Cột trái: Bìa sách thật hoặc Typographic -->
            @if (!string.IsNullOrEmpty(Model?.CoverImage))
            {
                <div class="utc-detail-cover-card-img-wrap">
                    <img src="~/@Model.CoverImage" alt="@Model.Title" class="utc-detail-cover-card-img" />
                </div>
            }
            else
            {
                <div class="utc-detail-cover-card" style="background-color: @(Model?.Category == "thesis" ? "#fef3c7" : "#e0f2fe");">
                    <span class="utc-detail-cover-tag" style="color: @(Model?.Category == "thesis" ? "#92400e" : "var(--utc-navy)");">
                        UTC / @(Model?.Category == "thesis" ? "CÔNG TRÌNH NGHIÊN CỨU" : "HỌC LIỆU")
                    </span>
                    <div class="utc-detail-cover-title" style="color: @(Model?.Category == "thesis" ? "#78350f" : "var(--utc-navy)"); font-size: 26px;">
                        @Model?.Title
                    </div>
                    <div class="utc-detail-cover-footer">
                        <span>@(Model?.CategoryName ?? "Giáo trình đại học chính quy")</span>
                    </div>
                </div>
            }

            <!-- Cột phải: Thông tin thư mục & Trạng thái lưu thông -->
            <div class="utc-detail-content">
                <div class="utc-detail-status-banner">
                    <i class="bi bi-check-circle-fill"></i> @(Model?.StockBadgeText ?? "Sẵn có tại thư viện")
                </div>

                <p class="utc-detail-desc">
                    @(Model?.Description ?? "Tài liệu học tập và nghiên cứu chính quy dành cho giảng viên và sinh viên trường Đại học Giao thông Vận tải.")
                </p>

                <!-- Lưới thông tin thư mục -->
                <div class="utc-metadata-grid">
                    <div class="utc-meta-item">
                        <span class="utc-meta-label">Mã đầu sách</span>
                        <div class="utc-meta-value">@(Model?.DocumentCode ?? "DS001")</div>
                    </div>
                    <div class="utc-meta-item">
                        <span class="utc-meta-label">Loại tài liệu</span>
                        <div class="utc-meta-value">@(Model?.CategoryName ?? "Sách / Giáo trình")</div>
                    </div>
                    <div class="utc-meta-item">
                        <span class="utc-meta-label">Ngôn ngữ</span>
                        <div class="utc-meta-value">@(Model?.LanguageName ?? "Tiếng Việt")</div>
                    </div>
                    <div class="utc-meta-item">
                        <span class="utc-meta-label">Chuyên ngành</span>
                        <div class="utc-meta-value">@(Model?.MajorName ?? "Công nghệ thông tin")</div>
                    </div>
                    <div class="utc-meta-item">
                        <span class="utc-meta-label">Mã chuẩn ISBN</span>
                        <div class="utc-meta-value">@(Model?.ISBN ?? "Đang cập nhật")</div>
                    </div>
                    <div class="utc-meta-item">
                        <span class="utc-meta-label">Số trang</span>
                        <div class="utc-meta-value">@(Model?.Pages ?? 300) trang</div>
                    </div>
                    <div class="utc-meta-item">
                        <span class="utc-meta-label">Vị trí lưu kho</span>
                        <div class="utc-meta-value text-primary fw-bold">@(Model?.Shelf ?? "Kệ IT-01")</div>
                    </div>
                    <div class="utc-meta-item">
                        <span class="utc-meta-label">Năm xuất bản</span>
                        <div class="utc-meta-value">@(Model?.Year ?? 2024)</div>
                    </div>
                </div>

                <!-- Tóm tắt số lượng kho -->
                <div class="utc-stock-summary">
                    <i class="bi bi-pie-chart-fill me-1 text-brand"></i> 
                    Tổng số: <strong>@(Model?.TotalCopies ?? 4) bản</strong> &middot; 
                    Sẵn có: <strong class="text-success">@(Model?.AvailableCopies ?? 4)</strong> &middot; 
                    Đang mượn: <strong class="text-primary">@((Model?.TotalCopies ?? 4) - (Model?.AvailableCopies ?? 4))</strong>
                </div>

                <!-- Các nút thao tác -->
                <div class="utc-detail-actions">
                    <a href="/Reader/Guide" class="btn-utc-primary">
                        <i class="bi bi-journal-arrow-down me-1"></i> Hướng dẫn mượn tại quầy
                    </a>
                    <a href="/Reader/MyLibrary" class="btn-utc-secondary">
                        <i class="bi bi-bookmark-plus me-1"></i> Lưu vào danh sách quan tâm
                    </a>
                    <a href="/Reader/Search" class="btn-utc-secondary">
                        &larr; Quay lại danh mục OPAC
                    </a>
                </div>

                <!-- Banner hướng dẫn bạn đọc -->
                <div class="utc-borrow-guide-box">
                    <span class="utc-borrow-guide-title">
                        <i class="bi bi-info-circle-fill me-1"></i> Bạn muốn mượn tài liệu này?
                    </span>
                    <p class="utc-borrow-guide-desc">
                        Bạn đọc chỉ cần mang Thẻ sinh viên hoặc Thẻ bạn đọc UTC đến <strong>Quầy thủ thư - Tầng 5 Nhà A8</strong>, cung cấp vị trí <strong>@(Model?.Shelf ?? "Kho sách")</strong> và mã vạch cuốn sách để làm thủ tục. Thời hạn mượn tiêu chuẩn là 14 ngày.
                    </p>
                </div>
            </div>
        </div>

        <!-- Bảng danh sách các bản sách đang lưu hành -->
        <div class="utc-copies-section">
            <h3 class="utc-copies-title">Danh sách các bản sách cụ thể (Bản sao lưu hành trong thư viện)</h3>
            <table class="utc-copies-table">
                <thead>
                    <tr>
                        <th style="width: 20%;">Mã vạch bản sách</th>
                        <th style="width: 25%;">Vị trí lưu kho</th>
                        <th style="width: 20%;">Tình trạng vật lý</th>
                        <th style="width: 20%;">Trạng thái lưu thông</th>
                        <th style="width: 15%;">Hạn trả dự kiến</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 1; i <= (Model?.TotalCopies ?? 4); i++)
                    {
                        var barcode = $"UTC-{(Model?.Id ?? 1):D2}-{i:D2}";
                        var isAvailable = i <= (Model?.AvailableCopies ?? 3);
                        <tr>
                            <td><strong>@barcode</strong></td>
                            <td>@(Model?.Shelf ?? "Kệ lưu trữ A1"), Thư viện A8</td>
                            <td>@(i == 1 ? "Mới 98%" : "Tốt (90%)")</td>
                            <td>
                                @if (isAvailable)
                                {
                                    <span class="badge-status badge-available"><i class="bi bi-check-circle-fill"></i> Có sẵn tại giá</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-borrowed"><i class="bi bi-clock-history"></i> Đang cho mượn</span>
                                }
                            </td>
                            <td>@(isAvailable ? "-" : "28/11/2026")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
