@model ReportViewModel
@{
    ViewData["Title"] = "Báo cáo thư viện";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-report.css" asp-append-version="true" />
}

<div class="report-page">
    <header class="report-header">
        <h1>Báo cáo thư viện</h1>
        <a asp-area="Admin" asp-controller="Report" asp-action="ExportExcel"
           asp-route-period="@Model.KyBaoCao" asp-route-scope="@Model.PhamVi"
           class="btn btn-utc-primary report-export">Xuất Excel</a>
    </header>

    <form method="get" asp-area="Admin" asp-controller="Report" asp-action="Index" class="report-filters">
        <div class="report-field">
            <label for="reportPeriod">Kỳ báo cáo</label>
            <select id="reportPeriod" name="period" class="form-select" onchange="this.form.requestSubmit()">
                @foreach (var period in Model.DanhSachKyBaoCao)
                {
                    <option value="@period" selected="@(period == Model.KyBaoCao)">@period</option>
                }
            </select>
        </div>
        <div class="report-field">
            <label for="reportScope">Phạm vi</label>
            <select id="reportScope" name="scope" class="form-select" onchange="this.form.requestSubmit()">
                @foreach (var scope in Model.DanhSachPhamVi)
                {
                    <option value="@scope" selected="@(scope == Model.PhamVi)">@scope</option>
                }
            </select>
        </div>
        <noscript><button type="submit" class="btn btn-utc-primary">Xem báo cáo</button></noscript>
    </form>

    <dl class="report-summary" aria-label="Số liệu tổng hợp">
        <div><dt>Lượt mượn</dt><dd>@Model.LuotMuonTrongThang.ToString("N0")</dd></div>
        <div><dt>Lượt trả</dt><dd>@Model.LuotTraTrongThang.ToString("N0")</dd></div>
        <div><dt>Đang quá hạn</dt><dd>@Model.QuaHanHienTai.ToString("N0")</dd></div>
        <div><dt>Tổng bản sách</dt><dd>@Model.TongBanSach.ToString("N0")</dd></div>
    </dl>

    <section class="report-books" aria-labelledby="reportBooksTitle">
        <h2 id="reportBooksTitle" class="visually-hidden">Số lượng sách</h2>
        <div class="report-table-wrap" role="region" aria-label="Số lượng sách theo đầu sách" tabindex="0">
            <table class="report-table">
                <colgroup>
                    <col class="report-title-column" />
                    <col span="4" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col">Tên sách</th>
                        <th scope="col">Tổng bản</th>
                        <th scope="col">Sẵn có</th>
                        <th scope="col">Đang mượn</th>
                        <th scope="col">Mất / hỏng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ChiTietDauSach.Count == 0)
                    {
                        <tr><td colspan="5" class="report-empty">Chưa có dữ liệu.</td></tr>
                    }
                    else
                    {
                        @foreach (var book in Model.ChiTietDauSach)
                        {
                            <tr>
                                <th scope="row">@book.DauSach</th>
                                <td>@book.TongBan.ToString("N0")</td>
                                <td>@book.SanCo.ToString("N0")</td>
                                <td>@book.DangMuon.ToString("N0")</td>
                                <td>@book.MatHong.ToString("N0")</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row">Tổng cộng</th>
                        <td>@Model.TongCongSoBan.ToString("N0")</td>
                        <td>@Model.TongCongSanCo.ToString("N0")</td>
                        <td>@Model.TongCongDangMuon.ToString("N0")</td>
                        <td>@Model.TongCongMatHong.ToString("N0")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <p class="report-note">Số liệu minh họa.</p>
    </section>
</div>
