@model ReaderDetailViewModel
@{
    ViewData["Title"] = "Hồ sơ bạn đọc - " + Model.HoTen;
    ViewBag.ActiveMenu = "Reader";
    bool canBorrow = BTL_LTWEB.Common.LoanTermPolicy.TryGetDueDate(DateOnly.FromDateTime(DateTime.Today), out var dueDate);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
    <div>
        <h1 class="admin-page-title mb-0">Hồ sơ bạn đọc</h1>
        <div class="text-muted small">Mã bạn đọc: <strong>@Model.MaBD</strong> &middot; @Model.HoTen</div>
    </div>
    <div class="d-flex gap-2">

        <a asp-action="Index" class="btn btn-outline-utc">
             Danh sách bạn đọc
        </a>
    </div>
</div>

<!-- 1. Form thông tin bạn đọc & thiết lập quyền mượn -->
<div class="admin-table-card p-4 mb-4">
    <h5 class="fw-bold text-navy mb-3">
         Thông tin bạn đọc
    </h5>
    <form asp-action="UpdateProfile" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaBD" />
        <input type="hidden" asp-for="HoTen" />
        <input type="hidden" asp-for="LopKhoa" />
        <input type="hidden" asp-for="TrangThaiHocTap" />

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label-utc">Mã bạn đọc</label>
                <input type="text" class="form-control form-control-utc bg-light fw-bold text-navy" value="@Model.MaBD" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label-utc">Họ tên</label>
                <input type="text" class="form-control form-control-utc bg-light fw-bold text-navy" value="@Model.HoTen" readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label-utc">Lớp / khóa</label>
                <input type="text" class="form-control form-control-utc bg-light" value="@Model.LopKhoa" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label-utc">Trạng thái học tập</label>
                <input type="text" class="form-control form-control-utc bg-light text-success fw-medium" value="@Model.TrangThaiHocTap" readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label-utc" asp-for="Nhom">Nhóm bạn đọc</label>
                <input type="text" class="form-control form-control-utc bg-light" value="@Model.Nhom" readonly />
                <small class="text-muted">Nhóm xác định theo mã bạn đọc.</small>
            </div>
            <div class="col-md-6">
                <label class="form-label-utc" asp-for="QuyenSuDung">Quyền sử dụng thư viện</label>
                <select class="form-select form-control-utc" asp-for="QuyenSuDung">
                    @if (!new[] { "Hoạt động", "Tạm khóa", "Đọc tại chỗ" }.Contains(Model.QuyenSuDung))
                    {
                        <option value="@Model.QuyenSuDung">@Model.QuyenSuDung</option>
                    }
                    <option value="Hoạt động">Hoạt động</option>
                    <option value="Tạm khóa">Tạm khóa</option>
                    <option value="Đọc tại chỗ">Đọc tại chỗ</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label-utc" asp-for="GioiHanSach">Giới hạn số sách</label>
                <input type="text" class="form-control form-control-utc" value="@Model.GioiHanSach" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label-utc" asp-for="HieuLucQuyen">Hiệu lực thẻ</label>
                <input type="date" class="form-control form-control-utc" asp-for="HieuLucQuyen" />
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <button type="submit" class="btn btn-utc-primary">
                 Lưu thay đổi
            </button>
        </div>
    </form>
</div>

<!-- 2. KHU VỰC SÁCH ĐANG MƯỢN (SỔ RA TRỰC TIẾP TRÊN TRANG KÈM NÚT TRẢ VÀ TẤT TOÁN PHẠT) -->
<div class="admin-table-card mb-4">
    <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">

            <span class="fw-bold text-navy fs-5">
                Sách đang mượn (@Model.SoSachDangMuon)
            </span>
            @if (Model.SoSachQuaHan > 0)
            {
                <span class="badge bg-danger text-white">Quá hạn: @Model.SoSachQuaHan cuốn</span>
            }
        </div>
        <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#opacBorrowModal">
             Cho mượn sách
        </button>
    </div>

    <div class="table-responsive">
        <table class="table-utc">
            <thead>
                <tr>
                    <th style="width: 5%; text-align: center;">STT</th>
                    <th style="width: 8%; text-align: center;">Bìa sách</th>
                    <th style="width: 32%;">Sách</th>
                    <th style="width: 12%;">Mã bản sao</th>
                    <th style="width: 11%;">Ngày mượn</th>
                    <th style="width: 11%;">Hạn trả</th>
                    <th style="width: 11%;">Trạng thái</th>
                    <th style="width: 10%; text-align: right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.BorrowTransactions == null || Model.BorrowTransactions.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="p-4 text-center text-muted">

                            Chưa có sách đang mượn.
                        </td>
                    </tr>
                }
                else
                {
                    int idx = 1;
                    foreach (var gd in Model.BorrowTransactions)
                    {
                        <tr>
                            <td style="text-align: center; font-weight: 600; color: #64748b;">
                                @idx
                            </td>
                            <td style="text-align: center;">
                                <img src="@gd.CoverImage" alt="@gd.TenSach"
                                     style="width: 38px; height: 52px; object-fit: cover; border-radius: 4px; border: 1px solid #e2e8f0;"
                                     onerror="this.onerror=null;this.src='/images/covers/cover-placeholder.svg'" />
                            </td>
                            <td>
                                <div class="fw-bold text-navy" style="font-size: 14.5px;">@gd.TenSach</div>
                                <div class="text-muted small">
                                     @gd.TacGia &middot; Mã GD: <strong>@gd.MaGD</strong>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@gd.MaSach</span>
                            </td>
                            <td>
                                <span class="fw-medium text-dark">@gd.NgayMuon</span>
                            </td>
                            <td>
                                <strong class="@(gd.IsQuaHan ? "text-danger" : "text-success")">@gd.NgayHenTra</strong>
                            </td>
                            <td>
                                @if (gd.IsQuaHan)
                                {
                                    <span class="badge bg-danger text-white px-2 py-1" style="font-size: 14px;">
                                         @gd.TrangThai
                                    </span>
                                    <div class="text-danger small mt-1 fw-bold">
                                        Phạt: @gd.TienPhat.ToString("N0") đ
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-success text-white px-2 py-1" style="font-size: 14px;">
                                         Còn hạn
                                    </span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <!-- NÚT TRẢ SÁCH (MỞ POPUP XÁC NHẬN TRẢ HOẶC BỒI THƯỜNG MẤT/HỎNG) -->
                                <button type="button" class="btn btn-outline-@(gd.IsQuaHan ? "danger" : "success") btn-sm btn-return-trigger px-2 py-1"
                                        data-magd="@gd.MaGD"
                                        data-mabd="@Model.MaBD"
                                        data-hoten="@Model.HoTen"
                                        data-tensach="@gd.TenSach"
                                        data-quahan="@(gd.IsQuaHan ? "true" : "false")"
                                        data-returnurl="/Admin/Reader/Details/@Model.MaBD"
                                        title="Tiếp nhận trả sách hoặc bồi thường mất/hỏng">
                                     Trả sách
                                </button>
                            </td>
                        </tr>
                        idx++;
                    }
                }
            </tbody>
            <!-- Dòng tổng cộng và tính tổng tiền phạt cần nộp -->
            <tfoot class="bg-light">
                <tr>
                    <td colspan="5" class="py-3 fw-bold">Tổng phí phạt</td>
                    <td colspan="3" class="text-end py-3">
                        <span class="text-muted fw-bold me-2">Phạt cần thu:</span>
                        @if (Model.TongTienPhat > 0)
                        {
                            <span class="badge bg-danger fs-6 px-3 py-2">
                                @Model.TongTienPhat.ToString("N0") VNĐ
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success fs-6 px-3 py-2">
                                0 VNĐ
                            </span>
                        }
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- 3. MODAL TRA CỨU HỌC LIỆU & CHO MƯỢN SÁCH PHONG CÁCH OPAC -->
<div class="modal fade" id="opacBorrowModal" tabindex="-1" aria-labelledby="opacBorrowModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-white text-dark py-3 px-4 border-bottom" style="background: #ffffff !important; border-bottom: 1px solid #e2eaf2 !important;">
                <div>
                    <h5 class="modal-title fw-bold text-navy mb-1" id="opacBorrowModalLabel">
                        Chọn sách cho mượn
                    </h5>
                    <div class="text-muted small">
                        @Model.HoTen &middot; @Model.MaBD
                    </div>
                </div>
                <button type="button" class="btn-close " data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Thanh tìm kiếm & lọc nhanh trong Modal -->
            <div class="modal-body p-4" style="background-color: #f8fafc;">
                <div class="card p-3 mb-4 shadow-sm border-0">
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label fw-bold text-navy small mb-1">Tìm sách</label>
                            <div class="input-group">

                                <input type="text" id="opacModalSearch" class="form-control"
                                       placeholder="Tìm theo tên sách, tác giả, nhà xuất bản..."
                                       oninput="filterOpacModalBooks()" />
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-bold text-navy small mb-1">Chuyên ngành</label>
                            <select id="opacModalCategory" class="form-select" onchange="filterOpacModalBooks()">
                                <option value="all">Tất cả chuyên ngành</option>
                                <option value="cntt">Công nghệ thông tin</option>
                                <option value="xaydung">Kỹ thuật xây dựng</option>
                                <option value="kinhte">Kinh tế &amp; Quản trị</option>
                                <option value="toanly">Khoa học cơ bản</option>
                                <option value="chinhtri">Lý luận chính trị &amp; Pháp luật</option>
                            </select>
                        </div>
                    </div>
                    <div class="mt-2 text-muted small">
                        Mỗi đầu sách mượn 1 bản.@if (canBorrow) { <span> Hạn trả: @dueDate.ToString("dd/MM/yyyy").</span> }
                    </div>
                </div>

                @if (!canBorrow)
                {
                    <p class="text-danger">@BTL_LTWEB.Common.LoanTermPolicy.BorrowingWindowMessage</p>
                }

                <!-- Lưới hiển thị các thẻ sách chuẩn OPAC (như ảnh người dùng cung cấp) -->
                <div class="row g-3" id="opacBooksContainer">
                    @foreach (var book in Model.AvailableBooks)
                    {
                        bool isAlreadyBorrowed = Model.BorrowTransactions?.Any(t => t.TenSach.Equals(book.Title, StringComparison.OrdinalIgnoreCase)) ?? false;
                        bool isAvailable = book.AvailableCopies > 0;

                        <div class="col-lg-3 col-md-4 col-sm-6 opac-book-card-item"
                             data-title="@book.Title.ToLower()"
                             data-author="@book.Authors.ToLower()"
                             data-major="@book.Major.ToLower()">
                            <div class="card h-100 shadow-sm border" style="border-radius: 8px; overflow: hidden; background: #fff;">
                                <!-- Bìa sách -->
                                <div style="height: 190px; background-color: #f1f5f9; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                    <img src="@book.CoverImage" alt="@book.Title"
                                         style="max-height: 100%; width: auto; object-fit: contain;"
                                         onerror="this.onerror=null;this.src='/images/covers/cover-placeholder.svg'" />
                                </div>

                                <div class="card-body p-3 d-flex flex-column justify-content-between">
                                    <div>
                                        <h6 class="fw-bold text-navy mb-1" style="font-size: 14px; line-height: 1.35; min-height: 38px;">
                                            @book.Title
                                        </h6>
                                        <div class="text-muted small mb-2 text-truncate" style="font-size: 14px;">
                                            @book.Authors
                                        </div>
                                        <div class="mb-3">
                                            @if (isAvailable)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 14px;">
                                                    @book.AvailableCopies bản sẵn có
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 14px;">
                                                    Hết bản sao
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Nút Cho mượn / Trạng thái -->
                                    <div>
                                        @if (isAlreadyBorrowed)
                                        {
                                            <button type="button" class="btn btn-secondary btn-sm w-100" disabled style="font-size: 14px;">
                                                Đã mượn
                                            </button>
                                        }
                                        else if (!isAvailable)
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm w-100" disabled style="font-size: 14px;">
                                                Tạm hết sách
                                            </button>
                                        }
                                        else
                                        {
                                            <form asp-action="BorrowBook" method="post" data-reader-name="@Model.HoTen" data-book-title="@book.Title">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="maBD" value="@Model.MaBD" />
                                                <input type="hidden" name="bookId" value="@book.Id" />
                                                <button type="submit" class="btn btn-utc-primary btn-sm w-100 fw-bold" style="font-size: 14px;" disabled="@(!canBorrow)"
                                                        onclick="return confirm('Cho ' + this.form.dataset.readerName + ' mượn sách ' + this.form.dataset.bookTitle + '?');">
                                                    Cho mượn
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-utc" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DÙNG CHUNG: XÁC NHẬN TRẢ SÁCH HOẶC BỒI THƯỜNG MẤT/HỎNG -->
<!-- Modal dùng chung đã được nhúng tại _AdminLayout -->

@section Scripts {
    <script>
        function filterOpacModalBooks() {
            var keyword = document.getElementById('opacModalSearch').value.toLowerCase().trim();
            var category = document.getElementById('opacModalCategory').value.toLowerCase();
            var items = document.querySelectorAll('.opac-book-card-item');

            items.forEach(function(card) {
                var title = card.getAttribute('data-title') || '';
                var author = card.getAttribute('data-author') || '';
                var major = card.getAttribute('data-major') || '';

                var matchKeyword = (keyword === '') || (title.includes(keyword) || author.includes(keyword));
                var matchCategory = (category === 'all') || (major === category);

                if (matchKeyword && matchCategory) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
}
