@{
    bool isAdmin = User.IsInRole("Admin") || User.IsInRole("ADMIN");
    string roleTitle = isAdmin ? "Quản trị viên" : User.IsInRole("QUANLY_BANDOC") ? "Quản lý bạn đọc" : "Quản lý học liệu";
}
<header class="admin-main-header">
    <div class="admin-topbar">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <span class="topbar-title">TRƯỜNG ĐẠI HỌC GIAO THÔNG VẬN TẢI</span>
        </div>
    </div>
    <div class="admin-navbar">
        <div class="container-fluid px-3 px-md-4 d-flex justify-content-between align-items-center">
            <div class="admin-brand-group d-flex align-items-center">
                <button type="button" class="btn btn-outline-primary me-3 admin-sidebar-toggler"
                        id="adminSidebarToggle" aria-controls="adminSidebar" aria-expanded="false" aria-label="Mở menu quản trị">
                    Menu
                </button>
                <a href="/Admin/Dashboard" class="admin-brand d-flex align-items-center text-decoration-none">
                    <img src="~/images/figma/brand/utc-logo.png" alt="UTC" class="admin-logo me-3" width="56" height="56" />
                    <div class="admin-brand-text">
                        <div class="brand-vi">THƯ VIỆN ĐẠI HỌC GIAO THÔNG VẬN TẢI</div>
                        <div class="brand-en d-none d-sm-block">UNIVERSITY OF TRANSPORT AND COMMUNICATIONS LIBRARY</div>
                    </div>
                </a>
            </div>
            <div class="admin-actions d-flex align-items-center">
                <a href="/Admin/Dashboard" class="btn btn-utc-primary admin-overview-link">Tổng quan</a>
                <div class="dropdown">
                    <button class="btn user-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="menu">
                        <span class="admin-account-name">@(User.Identity?.Name ?? "Cán bộ thư viện")</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-item-text admin-account-role">@roleTitle</span></li>
                        <li><hr class="dropdown-divider"></li>
                        @if (isAdmin)
                        {
                            <li><a class="dropdown-item" href="/Admin/User">Tài khoản &amp; phân quyền</a></li>
                        }
                        <li><a class="dropdown-item" href="/Reader/Home">Về website</a></li>
                        <li><a class="dropdown-item text-danger" href="/Account/Logout">Đăng xuất</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</header>
