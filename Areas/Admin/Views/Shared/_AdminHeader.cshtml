@{
    bool isAdmin = User.IsInRole("Admin") || User.IsInRole("ADMIN");
    string roleTitle = User.FindFirst("RoleTitle")?.Value ?? (isAdmin ? "Quản trị viên (QTV)" : (User.IsInRole("QUANLY_BANDOC") ? "Quản lý bạn đọc (QLB)" : "Quản lý tài liệu (QLTL)"));
}

<header class="admin-main-header">
    <!-- Top banner siêu nhỏ trên cùng -->
    <div class="admin-topbar">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <span class="topbar-title">TRƯỜNG ĐẠI HỌC GIAO THÔNG VẬN TẢI</span>
            <span class="topbar-links">Hỗ trợ cán bộ &middot; VI / EN</span>
        </div>
    </div>

    <!-- Header chính: Logo UTC + Tiêu đề + Nút Tổng quan & User -->
    <div class="admin-navbar">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <a href="/Admin/Dashboard" class="admin-brand d-flex align-items-center text-decoration-none">
                <img src="~/logo/utc.png" alt="UTC Logo" class="admin-logo me-3" onerror="this.src='/images/logo.png'" />
                <div class="admin-brand-text">
                    <div class="brand-vi">THƯ VIỆN ĐẠI HỌC GIAO THÔNG VẬN TẢI</div>
                    <div class="brand-en">UNIVERSITY OF TRANSPORT AND COMMUNICATIONS LIBRARY</div>
                </div>
            </a>

            <div class="admin-actions d-flex align-items-center gap-2">
                
                <div class="dropdown">
                    <button class="btn user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle me-1"></i> @(User.Identity?.Name ?? "Cán bộ Thư viện")
                        <span class="badge @(isAdmin ? "bg-danger" : "bg-primary") ms-1" style="font-size: 11px;">@roleTitle</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><span class="dropdown-item-text text-muted small">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "canbo@utc.edu.vn")</span></li>
                        <li><span class="dropdown-item-text fw-bold small text-dark">Vai trò: @roleTitle</span></li>
                        <li><hr class="dropdown-divider"></li>
                        @if (isAdmin)
                        {
                            <li><a class="dropdown-item" href="/Admin/User"><i class="bi bi-shield-lock me-2"></i>Tài khoản &amp; Phân quyền</a></li>
                        }
                        <li><a class="dropdown-item" href="/Reader/Home"><i class="bi bi-journal-text me-2"></i>Xem Cổng Bạn đọc</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</header>
