{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UTC: Debug web (localhost:5125)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "UTC: build",
      "program": "${workspaceFolder}/bin/Debug/net8.0/BTL_LTWEB.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5125"
      }
    },
    {
      "name": "UTC: Attach to running app",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
